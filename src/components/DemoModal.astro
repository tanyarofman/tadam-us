---
/**
 * Full game recording with sound and a "Create yours" CTA.
 * Opened by [data-open-demo] triggers and /#demo links.
 */
import { useCopy } from "../content/copy";
import { demoMedia } from "../config/site";
import { CREATE_URL } from "../config/pricing";
const { copy: COPY, locale } = useCopy(Astro.url);
const media = demoMedia(locale);
const c = COPY.modal;
---

<dialog class="demo-modal" id="demo-modal" aria-labelledby="demo-title">
  <div class="dm-panel">
    <h2 id="demo-title" class="display dm-title" tabindex="-1" autofocus>{c.title}</h2>
    <button type="button" class="dm-close" data-close aria-label={c.close}>
      <span aria-hidden="true">✕</span>
    </button>

    <div class="dm-tv">
      <video
        class="dm-video"
        data-demo-video
        poster={media.demoPoster}
        width="1280"
        height="720"
        preload="none"
        controls
        playsinline
        aria-label={c.videoLabel}
      >
        <source src={media.demo} type="video/mp4" />
      </video>
    </div>

    <a class="btn btn-buzzer dm-cta" href={CREATE_URL} data-track="cta_create_click" data-source="demo-modal">
      <span class="btn-dot" aria-hidden="true"></span>
      {c.cta}
    </a>
  </div>
</dialog>

<style>
  .demo-modal {
    width: min(1100px, calc(100vw - 32px));
    max-width: none;
    max-height: calc(100dvh - 32px);
    padding: 0;
    border: 0;
    border-radius: var(--radius-l);
    background: transparent;
    color: var(--text);
    overflow: visible;
  }
  .demo-modal::backdrop {
    background: radial-gradient(70% 70% at 50% 40%, rgba(0, 22, 112, 0.8), rgba(3, 14, 63, 0.94));
    backdrop-filter: blur(6px);
  }
  .demo-modal[open] {
    animation: dm-in 0.45s var(--ease-bounce);
  }
  @keyframes dm-in {
    from {
      opacity: 0;
      transform: scale(0.92) translateY(20px);
    }
  }
  .dm-panel {
    position: relative;
    max-height: calc(100dvh - 32px);
    overflow: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(12px, 2vh, 20px);
    padding: clamp(18px, 3vw, 32px);
    border-radius: var(--radius-l);
    background: var(--surface-solid);
    border: var(--stroke) solid var(--purple-ink);
    box-shadow:
      0 10px 0 var(--purple-ink),
      0 30px 80px rgba(0, 0, 0, 0.5);
    text-align: center;
  }
  .dm-close {
    position: absolute;
    top: 14px;
    inset-inline-end: 14px;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 3px solid var(--purple-ink);
    background: #fff;
    color: var(--purple-ink);
    font-size: 1.1rem;
    font-weight: 800;
    cursor: pointer;
    z-index: 2;
  }
  .dm-title {
    margin: 0;
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    padding-inline: 56px;
  }
  /* the TV: same frame as the hero */
  .dm-tv {
    width: 100%;
    /* keep the whole modal inside the screen: the video never gets taller than ~62% of it */
    max-width: calc((100dvh - 290px) * 16 / 9);
    border: 10px solid #0b0f24;
    border-radius: 16px;
    overflow: hidden;
    line-height: 0;
    background: #0b0f24;
    box-shadow: 0 0 60px 4px var(--screen-glow);
  }
  .dm-video {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    background: #0b0f24;
  }
  .dm-cta {
    min-width: min(320px, 100%);
  }
</style>
