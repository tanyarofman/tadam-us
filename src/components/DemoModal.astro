---
import { COPY } from "../content/copy.he";
const c = COPY.modal;
---

<dialog class="demo-modal" id="demo-modal" aria-labelledby="demo-title">
  <div class="dm-panel">
    <button type="button" class="dm-close" data-close aria-label={c.close}>
      <span aria-hidden="true">✕</span>
    </button>
    <h2 id="demo-title" class="display dm-title">{c.title}</h2>

    <!-- Desktop: QR (start/right) + big screen (left) -->
    <div class="dm-desktop">
      <div class="dm-qr-col">
        <div class="dm-qr" data-qr>
          <p class="dm-qr-pending">{c.qrPending}</p>
        </div>
        <p class="dm-qr-text display">{c.scan}</p>
      </div>
      <div class="dm-screen-col">
        <div class="dm-screen" data-screen>
          <div class="dm-fallback" data-fallback>
            <div class="dm-fallback-art" aria-hidden="true">
              <span class="dm-fallback-q"></span>
              <span class="dm-fallback-bars"><i></i><i></i><i></i><i></i></span>
            </div>
            <p>{c.bigScreenNote}</p>
            <a class="btn btn-buzzer" data-host-link target="_blank" rel="noopener">
              <span class="btn-dot" aria-hidden="true"></span>
              {c.openBigScreen}
            </a>
          </div>
        </div>
        <p class="dm-caption">{c.bigScreen}</p>
      </div>
    </div>

    <!-- Mobile: play on this phone + send link to desktop -->
    <div class="dm-mobile">
      <p class="lead">{c.mobileIntro}</p>
      <a class="btn btn-buzzer dm-play" data-play-link target="_blank" rel="noopener">
        <span class="btn-dot" aria-hidden="true"></span>
        {c.playHere}
      </a>
      <a class="btn btn-ghost" data-share-link target="_blank" rel="noopener">{c.sendToDesktop}</a>
    </div>
  </div>
</dialog>

<style>
  .demo-modal {
    width: min(1100px, calc(100vw - 32px));
    max-width: none;
    max-height: calc(100dvh - 32px);
    padding: 0;
    border: 0;
    border-radius: var(--radius-l);
    background: transparent;
    color: var(--text);
    overflow: visible;
  }
  .demo-modal::backdrop {
    background: radial-gradient(70% 70% at 50% 40%, rgba(51, 7, 104, 0.75), rgba(7, 1, 15, 0.92));
    backdrop-filter: blur(6px);
  }
  .demo-modal[open] {
    animation: dm-in 0.45s var(--ease-bounce);
  }
  @keyframes dm-in {
    from {
      opacity: 0;
      transform: scale(0.92) translateY(20px);
    }
  }
  .dm-panel {
    position: relative;
    max-height: calc(100dvh - 32px);
    overflow: auto;
    padding: clamp(22px, 3vw, 36px);
    border-radius: var(--radius-l);
    background: var(--surface-solid);
    border: var(--stroke) solid var(--purple-ink);
    box-shadow:
      0 10px 0 var(--purple-ink),
      0 30px 80px rgba(0, 0, 0, 0.5);
  }
  .dm-close {
    position: absolute;
    top: 14px;
    inset-inline-end: 14px;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 3px solid var(--purple-ink);
    background: #fff;
    color: var(--purple-ink);
    font-size: 1.1rem;
    font-weight: 800;
    cursor: pointer;
    z-index: 2;
  }
  .dm-title {
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    margin-bottom: 20px;
    padding-inline-end: 56px;
  }
  .dm-desktop {
    display: grid;
    grid-template-columns: minmax(240px, 0.8fr) minmax(0, 1.6fr);
    gap: 28px;
    align-items: start;
  }
  .dm-qr-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-align: center;
  }
  .dm-qr {
    width: 100%;
    max-width: 300px;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    padding: 16px;
    border-radius: var(--radius-m);
    background: #fff;
    border: var(--stroke) solid var(--purple-ink);
    box-shadow: 0 6px 0 var(--purple-ink);
    color: var(--purple-ink);
  }
  .dm-qr :global(svg) {
    width: 100%;
    height: 100%;
  }
  .dm-qr-pending {
    font-size: var(--fs-small);
    padding: 16px;
    border: 2px dashed currentColor;
    border-radius: 12px;
  }
  .dm-qr-text {
    font-size: 1.3rem;
  }
  .dm-screen {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: 14px;
    border: 6px solid var(--purple-ink);
    background: var(--screen-bg);
    box-shadow: 0 0 40px var(--screen-glow);
    overflow: hidden;
  }
  .dm-screen :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .dm-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 20px;
    text-align: center;
    color: var(--text-muted);
  }
  .dm-fallback[hidden] {
    display: none;
  }
  .dm-fallback-art {
    width: 60%;
    display: grid;
    gap: 10px;
    opacity: 0.6;
  }
  .dm-fallback-q {
    height: 14px;
    width: 70%;
    margin-inline: auto;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.4);
  }
  .dm-fallback-bars {
    display: grid;
    gap: 6px;
  }
  .dm-fallback-bars i {
    height: 10px;
    border-radius: 6px;
    background: var(--answer-1);
    width: 40%;
  }
  .dm-fallback-bars i:nth-child(2) {
    background: var(--answer-2);
    width: 80%;
  }
  .dm-fallback-bars i:nth-child(3) {
    background: var(--answer-3);
    width: 25%;
  }
  .dm-fallback-bars i:nth-child(4) {
    background: var(--answer-4);
    width: 55%;
  }
  .dm-caption {
    margin-top: 10px;
    text-align: center;
    color: var(--text-muted);
    font-size: var(--fs-small);
  }
  .dm-mobile {
    display: none;
    flex-direction: column;
    align-items: stretch;
    gap: 14px;
    text-align: center;
  }
  .demo-modal.is-mobile .dm-desktop {
    display: none;
  }
  .demo-modal.is-mobile .dm-mobile {
    display: flex;
  }
  @media (max-width: 860px) {
    .dm-desktop {
      grid-template-columns: 1fr;
    }
  }
</style>
