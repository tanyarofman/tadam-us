---
import { useCopy } from "../content/copy";
const { copy: COPY, dir } = useCopy(Astro.url);
const c = COPY.eventsStrip;
// Two identical groups side by side; the track slides by exactly one group, so the loop is seamless.
// Each group holds the list twice so it is wider than any screen.
const group = [...c.items, ...c.items];
---

<section class="events-strip" aria-label={c.label}>
  <div class="events-strip__track">
    {
      [0, 1].map((g) => (
        <ul class="events-strip__group" aria-hidden={g === 1 ? "true" : undefined}>
          {group.map((item) => (
            <li class="events-strip__item" dir={dir}>
              <span class="events-strip__dot" aria-hidden="true" />
              {item}
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</section>

<script>
  // Hold the loop at its first item until the strip scrolls into view, so every visitor
  // sees the list from the start. Without JS the strip just runs as before.
  const strip = document.querySelector<HTMLElement>(".events-strip");
  if (strip && "IntersectionObserver" in window) {
    strip.classList.add("is-waiting");
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        strip.classList.remove("is-waiting");
        io.disconnect();
      }
    }, { threshold: 0.6 });
    io.observe(strip);
  }
</script>

<style>
  .events-strip {
    position: relative;
    z-index: 2;
    overflow: hidden;
    direction: ltr; /* the track math is simpler in LTR; items carry the page direction */
    background: var(--stage-navy);
    border-block: 1px solid var(--surface-border);
    box-shadow: 0 -12px 32px rgba(0, 22, 112, 0.5);
    padding-block: clamp(14px, 2.4vw, 22px);
    /* soft fade at both edges */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .events-strip__track {
    display: flex;
    width: max-content;
    animation: events-marquee 64s linear infinite;
  }
  .events-strip.is-waiting .events-strip__track {
    animation-play-state: paused;
  }
  .events-strip__group {
    display: flex;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .events-strip__item {
    display: inline-flex;
    align-items: center;
    /* Spacing in em so it scales with the text. Space between items (1.6em) is about
       four times the dot-to-text gap (0.4em), so each dot clearly belongs to its own word. */
    gap: 0.4em;
    padding-inline: 0.8em;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.5rem, 3.4vw, 2.1rem);
    line-height: 1.2;
    color: var(--white);
    white-space: nowrap;
  }
  .events-strip__dot {
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    background: var(--game-yellow);
    box-shadow: 0 0 12px rgba(255, 230, 0, 0.6);
    flex-shrink: 0;
  }
  @keyframes events-marquee {
    to {
      transform: translateX(-50%);
    }
  }

  /* Reduced motion: no movement, one centered wrapping row, no duplicate. */
  @media (prefers-reduced-motion: reduce) {
    .events-strip {
      -webkit-mask-image: none;
      mask-image: none;
    }
    .events-strip__track {
      animation: none;
      width: auto;
      justify-content: center;
    }
    .events-strip__group {
      flex-wrap: wrap;
      justify-content: center;
    }
    .events-strip__group[aria-hidden="true"] {
      display: none;
    }
    .events-strip__group:first-child .events-strip__item:nth-child(n + 6) {
      display: none;
    }
  }
</style>
