---
import { COPY } from "../content/copy.he";
import { PRICING, fillPrices } from "../config/pricing";
import { SITE } from "../config/site";
const c = COPY.faq;
// Order: the price question (only while PRICING.showPrices), the general questions, then the add-ons
// (price and add-on questions live in the `pricing` copy block).
const isPrice = (it: object) => "pricesOnly" in it && it.pricesOnly === true;
const priceQs = PRICING.showPrices ? COPY.pricing.faq.filter(isPrice) : [];
const addonQs = COPY.pricing.faq.filter((it) => !isPrice(it));
const items = [...priceQs, ...c.items, ...addonQs].map((it) => ({
  q: it.q,
  a: fillPrices(it.a),
  demoLinkText: "demoLinkText" in it ? it.demoLinkText : null,
}));
---

<section class="faq" id="faq" aria-labelledby="faq-title">
  <div class="faq-pin" data-scroll-pause="start">
  <div class="container faq-inner">
    <h2 id="faq-title" class="display h-scene faq-title reveal">{c.title}</h2>
    <div class="faq-list">
      {
        items.map((it) => (
          <details class="faq-item reveal">
            <summary>
              <span>{it.q}</span>
              <span class="faq-icon" aria-hidden="true" />
            </summary>
            <div class="faq-a">
              <p>{it.demoLinkText ? (
                <>{it.a.split(it.demoLinkText)[0]}<a href={`${SITE.eyalDemoUrl}?autostart=1`} target="_blank" rel="noopener" data-track="demo_open_big_screen" data-source="faq">{it.demoLinkText}</a>{it.a.split(it.demoLinkText)[1]}</>
              ) : it.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
  </div>
</section>

<script>
  import { track } from "../lib/analytics";
  document.querySelectorAll<HTMLDetailsElement>(".faq-item").forEach((d) =>
    d.addEventListener("toggle", () => {
      if (d.open) track("faq_open", { q: d.querySelector("summary span")?.textContent });
    }),
  );
</script>

<style>
  .faq-pin {
    min-height: 100svh;
    display: grid;
    align-items: start;
    padding-block: clamp(64px, 10vh, 104px);
    padding-block-end: clamp(40px, 6vh, 64px);
  }
  .faq-inner {
    max-width: 820px;
  }
  .faq-title {
    text-align: center;
    margin-bottom: clamp(24px, 4vh, 40px);
    font-size: clamp(1.8rem, 5vw, 3rem);
  }
  .faq-list {
    display: grid;
    gap: 12px;
  }
  .faq-item {
    border-radius: var(--radius-m);
    background: var(--surface);
    border: 2px solid var(--surface-border);
    overflow: hidden;
  }
  .faq-item[open] {
    border-color: var(--magenta);
  }
  summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 56px;
    padding: 12px 22px;
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.02rem, 2vw, 1.2rem);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .faq-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    color: var(--game-yellow);
    background: rgba(255, 255, 255, 0.08);
  }
  .faq-icon::before {
    content: "";
    width: 9px;
    height: 9px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
    transition: transform 0.2s var(--ease-out);
  }
  .faq-item[open] .faq-icon::before {
    transform: translateY(2px) rotate(225deg);
  }
  .faq-a {
    padding: 0 22px 20px;
    color: #f5f7ff;
    font-size: clamp(1.2rem, 2vw, 1.35rem);
    font-weight: 500;
    line-height: 1.55;
  }
  .faq-a a {
    color: var(--game-yellow);
    font-weight: 700;
    text-underline-offset: 4px;
  }
  @media (max-width: 767px) {
    .faq-pin { padding-block-start: clamp(72px, 12svh, 104px); }
  }
</style>
