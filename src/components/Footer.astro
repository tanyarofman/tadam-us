---
import { useCopy, localPath, otherLanguagePath } from "../content/copy";
import { SITE, contactLink } from "../config/site";
interface Props {
  /** False on a page that has no twin in the other language (an article not translated yet): hides the language link. */
  bilingual?: boolean;
}
const { bilingual: bilingualPage = true } = Astro.props;
const { copy: COPY, locale, home } = useCopy(Astro.url);
const c = COPY.footer;
---

<footer class="site-footer">
  <div class="container footer-inner">
    <ul class="footer-social" role="list">
      <li>
        <a class="social-icon" href={SITE.facebookUrl} target="_blank" rel="noopener" aria-label={c.facebook} data-track="social_click" data-source="facebook">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H7.8v3h2.6V21z"></path></svg>
        </a>
      </li>
    </ul>
    <nav class="footer-links" aria-label={c.linksLabel}>
      <a href={contactLink("footer")} target="_blank" rel="noopener" data-track="cta_contact_click" data-source="footer"><span class="footer-desktop">{c.contact}</span><span class="footer-mobile">{c.contactMobile}</span></a>
      <a href={localPath(locale, "/blog/")}>{c.blog}</a>
      <a href={localPath(locale, "/privacy")}><span class="footer-desktop">{c.privacy}</span><span class="footer-mobile">{c.privacyMobile}</span></a>
      {bilingualPage && locale === "he" && <a href={otherLanguagePath(Astro.url)} lang={locale === "he" ? "en" : "he"} aria-label={COPY.nav.langSwitchLabel} data-track="language_switch" data-source="footer">{COPY.nav.langSwitch}</a>}
    </nav>
    <a class="footer-copy" href={home}><span class="footer-desktop">{c.copyright} {new Date().getFullYear()}</span><span class="footer-mobile">{c.copyright}</span></a>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 48px calc(48px + env(safe-area-inset-bottom));
    border-top: 2px solid var(--surface-border);
    background: rgba(0, 0, 0, 0.2);
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 32px;
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }
  .footer-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 0;
    color: var(--text-muted);
    text-underline-offset: 5px;
  }
  .footer-links a:hover {
    color: var(--text);
  }
  .footer-social {
    display: flex;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .social-icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: var(--text-muted);
    transition: color 0.2s, transform 0.2s;
  }
  .social-icon:hover {
    color: var(--game-yellow);
    transform: translateY(-2px);
  }
  .social-icon svg {
    width: 20px;
    height: 20px;
  }
  .footer-copy {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--text-muted);
    font-size: var(--fs-small);
    text-decoration: none;
  }
  .footer-copy:hover {
    color: var(--white);
    text-decoration: underline;
  }
  .footer-mobile { display: none; }
  @media (max-width: 767px) {
    .footer-desktop { display: none; }
    .footer-mobile { display: inline; }
  }
</style>
