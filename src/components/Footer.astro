---
/**
 * Site footer: brand + contact, the site links, the legal links, and the legal line Paddle asks for
 * ("© <year> <legal name>, <country>. Payments processed by Paddle.com.").
 */
import { useCopy } from "../content/copy";
import { SITE } from "../config/site";
const { copy: COPY, home } = useCopy(Astro.url);
const c = COPY.footer;
const legal = COPY.legalPage;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href={home} class="footer-logo"><img src="/brand/tadam-logo-en.webp" alt={COPY.brand} width="1000" height="394" loading="lazy" /></a>
      <p class="footer-tagline">{c.tagline}</p>
    </div>

    <nav class="footer-col" aria-labelledby="footer-game">
      <h2 id="footer-game" class="footer-heading">{c.gameLabel}</h2>
      <ul role="list">
        {c.gameLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <nav class="footer-col" aria-labelledby="footer-legal">
      <h2 id="footer-legal" class="footer-heading">{c.legalLabel}</h2>
      <ul role="list">
        {c.legalLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <div class="footer-col">
      <h2 class="footer-heading">{c.contactLabel}</h2>
      <ul role="list">
        <li><a href={`mailto:${SITE.email}`} data-track="cta_contact_click" data-source="footer">{SITE.email}</a></li>
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© {year} {legal.legalName}, {legal.country}. {c.paddle}</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 56px calc(32px + env(safe-area-inset-bottom));
    border-top: 2px solid var(--surface-border);
    background: rgba(0, 0, 0, 0.2);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(0, 1fr));
    gap: 32px 40px;
  }
  .footer-logo img {
    width: 130px;
    height: auto;
  }
  .footer-tagline {
    margin: 12px 0 0;
    max-width: 28ch;
    color: var(--text-muted);
    line-height: 1.5;
  }
  .footer-heading {
    margin: 0 0 8px;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--game-yellow);
  }
  .footer-col ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer-col a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    color: var(--text-muted);
    text-underline-offset: 5px;
    overflow-wrap: anywhere;
  }
  .footer-col a:hover {
    color: var(--text);
  }
  .footer-bottom {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--surface-border);
  }
  .footer-bottom p {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--fs-small);
  }
  @media (max-width: 860px) {
    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 340px) {
    .footer-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
