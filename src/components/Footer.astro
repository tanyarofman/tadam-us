---
import { COPY } from "../content/copy.he";
import { whatsappLink } from "../config/site";
const c = COPY.footer;
---

<footer class="site-footer">
  <div class="container footer-inner">
    <a href="/" class="footer-logo" aria-label="טדאם! דף הבית">
      <img src="/brand/tadam-logo-v3.webp" alt="טדאם!" width="736" height="332" loading="lazy" decoding="async" />
    </a>
    <nav class="footer-links" aria-label="קישורים">
      <a href={whatsappLink()} target="_blank" rel="noopener" data-track="cta_whatsapp_click" data-source="footer">{c.contact}</a>
      <a href="/blog/">{c.blog}</a>
      <a href="/privacy">{c.privacy}</a>
    </nav>
    <p class="footer-copy">{c.copyright} {new Date().getFullYear()}</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 48px calc(48px + env(safe-area-inset-bottom));
    border-top: 2px solid var(--surface-border);
    background: rgba(0, 0, 0, 0.2);
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 32px;
  }
  .footer-logo img {
    width: 130px;
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }
  .footer-links a {
    padding: 8px 0;
    color: var(--text-muted);
    text-underline-offset: 5px;
  }
  .footer-links a:hover {
    color: var(--text);
  }
  .footer-copy {
    color: var(--text-muted);
    font-size: var(--fs-small);
  }
</style>
