---
import { useCopy } from "../content/copy";
import Person from "./art/Person.astro";
const { copy: COPY } = useCopy(Astro.url);
const h = COPY.hosts;
const hostPhotos = ["host-classic-waist", "host-friendly-waist", "host-animated-waist"];
---

<section class="hosts" id="hosts" aria-labelledby="hosts-title">
  <div class="hosts-pin" data-scroll-pause>
  <div class="container hosts-inner">
    <div class="hosts-top">
      <div class="hosts-head reveal">
        <h2 id="hosts-title" class="display hosts-title">
          <span>{h.titleLine1}</span>{" "}
          <span class="hl swoosh">{h.titleLine2}</span>
        </h2>
        <p class="hosts-sub">{h.sub}</p>
      </div>
      <div class="hosts-photos reveal" role="group" aria-label={h.photosLabel}>
        {hostPhotos.map((name, i) => (
          <Person name={name} alt={h.alts[i]} width={411} height={736} class={`host-photo host-photo--${i + 1}`} />
        ))}
      </div>
    </div>
  </div>
  </div>
</section>

<style>
  .hosts { position: relative; }
  .hosts-pin { min-height: 100svh; display: grid; align-items: center; padding-block: clamp(32px, 5vh, 56px); }
  .hosts-inner { --gutter: clamp(28px, 8vw, 112px); max-width: 1440px; display: grid; gap: clamp(32px, 5vh, 52px); }
  .hosts-top {
    display: grid;
    grid-template-columns: minmax(240px, .7fr) minmax(0, 1.6fr);
    gap: clamp(48px, 7vw, 112px);
    align-items: center;
  }
  .hosts-head { display: grid; gap: 22px; text-align: start; }
  .hosts-title { display: grid; margin: 0; font-size: var(--fs-story-title); line-height: 1.08; }
  .hl { position: relative; width: fit-content; padding-bottom: 12px; color: var(--sun-yellow); }
  .hl::after { content: ""; position: absolute; inset-inline: 0; bottom: 0; height: 18px; }
  .hosts-sub { margin: 0; color: #fff; font-size: clamp(1.4rem, 2.35vw, 1.85rem); line-height: 1.4; max-width: 19ch; }
  .hosts-photos {
    display: grid;
    width: min(100%, 630px);
    justify-self: end;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(10px, 1.5vw, 20px);
    direction: ltr;
    padding-top: 16px;
  }
  .hosts-photos :global(.host-photo) {
    aspect-ratio: 3 / 4.2 !important;
    border-radius: 6px 32px 6px 28px;
    transform: skewX(-4deg);
    box-shadow: 0 16px 32px #0004;
  }
  .hosts-photos :global(.person-img) { object-position: center top; transform: translateY(4%) skewX(4deg) scale(1.14); transform-origin: center; }
  .hosts-custom-title { margin: clamp(28px, 5vh, 56px) 0 0; text-align: center; color: var(--sun-yellow); font-size: clamp(2rem, 4.4vw, 3.6rem); line-height: 1.2; text-wrap: balance; }
  .hosts-photos :global(.host-photo--2) { transform: skewX(-4deg) translateY(-8px); }
  .hosts-photos :global(.host-photo--3) { transform: skewX(-4deg) translateY(-16px); }
  @media (max-width: 760px) {
    .hosts-top { grid-template-columns: minmax(0, 1fr); gap: 36px; }
    .hosts-head { text-align: center; justify-items: center; gap: 14px; }
    .hosts-title { justify-items: center; }
    .hosts-sub { max-width: 28ch; }
    .hosts-photos { width: min(100%, 580px); justify-self: center; }
  }
  @media (max-width: 767px) {
    .hosts-inner { --gutter: 24px; }
    .hosts-title { display: flex; gap: .18em; font-size: clamp(2rem, 9.4vw, 3rem); white-space: nowrap; }
    .hosts-title .hl { display: inline-block; }
    /* The English title is longer: on narrow phones it may wrap onto a second line. */
    :global([dir="ltr"]) .hosts-title { flex-wrap: wrap; justify-content: center; }
    .hosts-sub { max-width: none; white-space: nowrap; font-size: clamp(1.15rem, 5.6vw, 1.6rem); }
  }
</style>
