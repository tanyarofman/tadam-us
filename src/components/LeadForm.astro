---
/**
 * "Leave details": a short lead form, handled by Netlify Forms (detected at deploy from the static HTML:
 * data-netlify + the hidden form-name field). Submissions show up in the Netlify dashboard under Forms → "lead",
 * and Netlify can email each one (Forms → Form notifications).
 * With JS the form posts in the background and shows a thank-you in place; without JS it posts normally.
 */
import { useCopy } from "../content/copy";
import { contactLink } from "../config/site";
const { copy: COPY, locale } = useCopy(Astro.url);
const c = COPY.lead;
---

<section class="lead-sec" id="lead" aria-labelledby="lead-title">
  <div class="lead-pin" data-scroll-pause="start">
  <div class="container lead-inner">
    <h2 id="lead-title" class="display h-scene lead-title reveal">{c.title}</h2>
    <p class="lead lead-sub reveal">{c.sub}</p>

    <form class="lead-form reveal" name="lead" method="POST" data-netlify="true" netlify-honeypot="bot-field" data-lead-form>
      <input type="hidden" name="form-name" value="lead" />
      {/* Which language version the lead came from, so the reply can be in the same language. */}
      <input type="hidden" name="language" value={locale} />
      <p class="lead-hp" aria-hidden="true">
        <label>{c.honeypot} <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
      </p>

      <div class="lead-grid">
        <label class="field">
          <span class="field-label">{c.name} <span aria-hidden="true">*</span></span>
          <input name="name" type="text" required autocomplete="name" placeholder={c.namePlaceholder} />
        </label>
        <label class="field">
          <span class="field-label">{c.email} <span aria-hidden="true">*</span></span>
          <input name="email" type="email" required autocomplete="email" dir="ltr" placeholder={c.emailPlaceholder} />
        </label>
        <label class="field">
          <span class="field-label">{c.phone}</span>
          <input name="phone" type="tel" autocomplete="tel" inputmode="tel" dir="ltr" placeholder={c.phonePlaceholder} />
        </label>
        <label class="field">
          <span class="field-label">{c.eventType}</span>
          <input name="event-type" type="text" placeholder={c.eventTypePlaceholder} />
        </label>
      </div>

      <button type="submit" class="btn btn-buzzer lead-submit" data-label={c.submit} data-sending={c.sending}>
        <span class="lead-submit-text">{c.submit}</span>
      </button>

      <p class="lead-status" role="status" aria-live="polite" data-status hidden></p>
      <p class="lead-error" role="alert" data-error hidden>
        {c.error} <a href={contactLink("lead-error")} target="_blank" rel="noopener">{c.errorMessenger}</a>
      </p>
    </form>

    <div class="lead-done" data-done hidden tabindex="-1">
      <span class="lead-done-icon" aria-hidden="true">✓</span>
      <p class="display">{c.success}</p>
    </div>
  </div>
  </div>
</section>

<script>
  import { track } from "../lib/analytics";
  const form = document.querySelector<HTMLFormElement>("[data-lead-form]");
  const done = document.querySelector<HTMLElement>("[data-done]");
  if (form && done) {
    const btn = form.querySelector<HTMLButtonElement>(".lead-submit")!;
    const btnText = btn.querySelector<HTMLElement>(".lead-submit-text")!;
    const err = form.querySelector<HTMLElement>("[data-error]")!;
    const required = Array.from(form.querySelectorAll<HTMLInputElement>("input[required]"));
    let sending = false;
    const requiredValid = () => required.every((input) => input.value.trim().length > 0 && input.validity.valid);
    const updateSubmit = () => { btn.disabled = sending || !requiredValid(); };
    form.addEventListener("input", updateSubmit);
    form.addEventListener("change", updateSubmit);
    window.addEventListener("pageshow", updateSubmit);
    updateSubmit();
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (sending || !requiredValid() || !form.reportValidity()) return;
      sending = true;
      form.setAttribute("aria-busy", "true");
      updateSubmit();
      btnText.textContent = btn.dataset.sending!;
      err.hidden = true;
      try {
        const body = new URLSearchParams(new FormData(form) as unknown as Record<string, string>).toString();
        const res = await fetch("/", {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body,
        });
        if (!res.ok) throw new Error(String(res.status));
        track("lead_submit", { eventType: new FormData(form).get("event-type") });
        form.hidden = true;
        done.hidden = false;
        done.focus();
      } catch (x) {
        track("lead_error", { error: String(x) });
        err.hidden = false;
        btnText.textContent = btn.dataset.label!;
      } finally {
        sending = false;
        form.removeAttribute("aria-busy");
        updateSubmit();
      }
    });
  }
</script>

<style>
  /* the display rules below must not beat the hidden attribute */
  [hidden] {
    display: none !important;
  }
  .lead-sec {
    position: relative;
  }
  .lead-pin {
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding-block: clamp(32px, 6vh, 72px);
  }
  .lead-inner {
    max-width: 820px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(10px, 2vh, 18px);
  }
  .lead-title {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.4rem);
    text-shadow: 0 4px 0 var(--purple-ink);
  }
  .lead-sub {
    margin: 0 0 clamp(6px, 1.5vh, 14px);
  }
  .lead-form {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding: clamp(18px, 3vw, 30px);
    border-radius: var(--radius-l);
    background: var(--surface-solid);
    border: 2px solid var(--surface-border);
    box-shadow: 0 0 60px 4px var(--screen-glow);
  }
  /* honeypot for bots: invisible and out of the layout (no off-screen offset: in RTL that widens the page) */
  .lead-hp {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .lead-grid {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px 16px;
    text-align: start;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .field-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
  }
  .field input {
    width: 100%;
    min-height: 52px;
    padding: 10px 18px;
    border-radius: 999px;
    border: 3px solid transparent;
    background: var(--white);
    color: var(--purple-ink);
    font: inherit;
    font-size: 1.05rem;
    text-align: start;
  }
  .field input[dir="ltr"] {
    text-align: left; /* numbers read left to right */
  }
  .field input[type="tel"],
  .field input[type="tel"]::placeholder {
    text-align: right;
  }
  :global([dir="ltr"]) .field input[type="tel"],
  :global([dir="ltr"]) .field input[type="tel"]::placeholder {
    text-align: left;
  }
  .field input::placeholder {
    color: color-mix(in srgb, var(--purple-ink) 45%, white);
  }
  .field input:focus-visible {
    outline: none;
    border-color: var(--game-yellow);
    box-shadow: 0 0 0 4px rgba(255, 230, 0, 0.35);
  }
  .lead-submit {
    min-width: min(320px, 100%);
    margin-top: clamp(24px, 4vh, 36px);
  }
  .lead-submit:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .lead-submit:disabled:hover,
  .lead-submit:disabled:active {
    transform: none;
    background: var(--btn-bg);
  }
  .lead-form[aria-busy="true"] .lead-submit {
    cursor: progress;
  }
  .lead-error a {
    color: var(--game-yellow);
  }
  .lead-error {
    margin: 0;
    color: #ffd3d3;
  }
  .lead-done {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: clamp(24px, 4vw, 40px);
    border-radius: var(--radius-l);
    background: var(--surface-solid);
    border: 2px solid var(--game-yellow);
    outline: none;
  }
  .lead-done p {
    margin: 0;
    font-size: clamp(1.4rem, 3vw, 2rem);
    color: var(--game-yellow);
  }
  .lead-done-icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #4cc09d;
    border: 3px solid var(--purple-ink);
    color: var(--purple-ink);
    font-size: 1.6rem;
    font-weight: 800;
  }
  @media (max-width: 767px) {
    .lead-pin {
      align-items: start;
      padding-block-start: clamp(72px, 12svh, 104px);
    }
  }
  @media (max-width: 600px) {
    .lead-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .lead-submit {
      width: 100%;
    }
  }
</style>
