---
/**
 * The logo, sliced into pieces with clip-path so it can "assemble" in the preloader:
 * the top band, 5 letter columns (ט ד א ם !), and the swoosh band.
 * All pieces are the same cached PNG, so once assembled it is pixel-identical to the logo.
 */

const SRC = "/brand/tadam-logo-v3.webp";
// Bands (percent of image height)
const TOP = 29;
const BOTTOM = 75;
// Letter columns from the right (RTL order: ט, ד, א, ם, !), as [left%, right%]
const cols: [number, number][] = [
  [77, 100],
  [60, 77],
  [41, 60],
  [22, 41],
  [0, 22],
];
interface Props {
  class?: string;
}
const { class: cls = "" } = Astro.props;
---

<div class:list={["logo-assemble", cls]} role="img" aria-label="טדאם!" data-logo>
  <img class="logo-full" src={SRC} alt="" width="736" height="332" decoding="async" />
  <img
    class="logo-piece piece-top"
    src={SRC}
    alt=""
    width="736"
    height="332"
    fetchpriority="high"
    decoding="async"
    style={`clip-path: inset(0% 0% ${100 - TOP}% 0%)`}
  />
  {
    cols.map(([l, r], i) => (
      <img
        class="logo-piece piece-letter"
        data-i={i}
        src={SRC}
        alt=""
        width="736"
        height="332"
        decoding="async"
        style={`clip-path: inset(${TOP}% ${100 - r}% ${100 - BOTTOM}% ${l}%)`}
      />
    ))
  }
  <img
    class="logo-piece piece-swoosh"
    src={SRC}
    alt=""
    width="736"
    height="332"
    decoding="async"
    style={`clip-path: inset(${BOTTOM}% 0% 0% 0%)`}
  />
</div>

<style>
  .logo-assemble {
    position: relative;
    width: 100%;
    aspect-ratio: 736 / 332;
  }
  .logo-full {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* pieces only exist for the intro; the full image shows the rest of the time */
  .logo-piece {
    visibility: hidden;
  }
  :global(html.js .intro-pending) .logo-full,
  :global(html.js .intro-playing) .logo-full {
    visibility: hidden;
  }
  :global(html.js .intro-pending) .logo-piece,
  :global(html.js .intro-playing) .logo-piece {
    visibility: visible;
  }
  .logo-piece {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    user-select: none;
    -webkit-user-drag: none;
  }
  /* Before JS runs the assembled logo is shown; JS hides pieces and plays the intro. */
  :global(html.js .intro-pending) .logo-piece {
    opacity: 0;
  }
</style>
