---
/**
 * Loading screen: the buzzer alone, centered, blinking while the site loads.
 * Then it gets pressed, the stage opens, and it flies into its place on the logo (see scripts/hero.ts).
 * Hidden without JS. Decorative only; it never blocks keyboard or screen-reader users for long.
 */
import Buzzer from "./Buzzer.astro";
---

<div class="preloader" data-preloader aria-hidden="true">
  <div class="pre-bg"></div>
  <div class="pre-buzzer" data-pre-buzzer>
    <Buzzer id="pre-buzzer" rays />
  </div>
</div>

<style>
  .preloader {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    pointer-events: auto;
  }
  :global(html.no-js) .preloader {
    display: none;
  }
  .pre-bg {
    position: absolute;
    inset: 0;
    background: var(--stage-bg);
  }
  .pre-buzzer {
    position: relative;
    width: min(240px, 50vw);
    cursor: pointer;
    will-change: transform;
  }
</style>
