---
/**
 * Loading screen: the logo alone, centered, pulsing while the site loads.
 * Then it flies up into its place in the hero (see scripts/hero.ts).
 * Hidden without JS. Decorative only; it never blocks keyboard or screen-reader users for long.
 */
import { localeOf } from "../content/copy";
const english = localeOf(Astro.url) === "en";
---

<div class="preloader" data-preloader aria-hidden="true">
  <div class="pre-bg"></div>
  <img class="pre-logo" data-pre-logo src={english ? "/brand/tadam-logo-en.webp" : "/brand/tadam-logo-v4.webp"} alt="" width="736" height="332" decoding="async" />
</div>

<style>
  .preloader {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    pointer-events: auto;
  }
  :global(html.no-js) .preloader {
    display: none;
  }
  .pre-bg {
    position: absolute;
    inset: 0;
    background: var(--page-gradient);
  }
  .pre-logo {
    position: relative;
    width: min(420px, 72vw);
    height: auto;
    cursor: pointer;
    will-change: transform, opacity;
  }
</style>
