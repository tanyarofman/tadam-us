---
/**
 * Loading screen: the name "טדאם" alone, centered, pulsing while the site loads.
 * Then it fades out and the logo assembles in the hero (see scripts/hero.ts).
 * Hidden without JS. Decorative only; it never blocks keyboard or screen-reader users for long.
 */
---

<div class="preloader" data-preloader aria-hidden="true">
  <div class="pre-bg"></div>
  <div class="pre-name" data-pre-name>טדאם</div>
</div>

<style>
  .preloader {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    pointer-events: auto;
  }
  :global(html.no-js) .preloader {
    display: none;
  }
  .pre-bg {
    position: absolute;
    inset: 0;
    background: var(--stage-bg);
  }
  .pre-name {
    position: relative;
    font-family: var(--font-display, inherit);
    font-weight: 900;
    font-size: clamp(56px, 16vw, 120px);
    line-height: 1;
    color: #fff;
    cursor: pointer;
    will-change: transform, opacity;
  }
</style>
