---
/**
 * Loading screen: the buzzer alone, centered, blinking while the site loads.
 * Then it gets pressed, the stage opens, and it flies into its place on the logo (see scripts/hero.ts).
 * Hidden without JS. Decorative only; it never blocks keyboard or screen-reader users for long.
 */
import Buzzer from "./Buzzer.astro";
---

<div class="preloader" data-preloader aria-hidden="true">
  <div class="pre-bg"></div>
  <div class="pre-ring"></div>
  <div class="pre-buzzer" data-pre-buzzer>
    <Buzzer id="pre-buzzer" rays />
  </div>
</div>

<style>
  .preloader {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    pointer-events: auto;
  }
  :global(html.no-js) .preloader {
    display: none;
  }
  .pre-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(40% 35% at 50% 50%, rgba(231, 65, 56, 0.18), transparent 70%),
      radial-gradient(120% 80% at 50% 0%, var(--bg-1) 0%, var(--bg-0) 60%);
    background-color: var(--bg-0);
  }
  .pre-ring {
    position: absolute;
    width: min(420px, 80vw);
    aspect-ratio: 1;
    border-radius: 50%;
    border: 4px solid var(--sun-yellow);
    opacity: 0;
  }
  .pre-buzzer {
    position: relative;
    width: min(240px, 50vw);
    cursor: pointer;
    will-change: transform;
  }
</style>
