---
/**
 * Pricing: the $99 price, the six "what's included" tiles (on phones they show two at a time, src/scripts/included.ts),
 * and the "Create yours" button. Numbers come from src/config/pricing.ts.
 */
import { useCopy } from "../content/copy";
import { CREATE_URL, PRICING, fillPrices } from "../config/pricing";
const { copy: COPY } = useCopy(Astro.url);
const c = COPY.pricing;
const incColors = ["var(--game-yellow)", "var(--sky-cyan)", "var(--magenta)", "var(--buzzer-red)"];
const [noteBefore, noteAfter] = c.note.split("{refundPolicy}");
// simple line icons (24x24, stroke = currentColor)
const icons: Record<string, string> = {
  story: '<path d="M4 5h11a3 3 0 0 1 3 3v11H7a3 3 0 0 1-3-3z"/><path d="M8 9h6M8 13h4"/><path d="M18 8h2v11"/>',
  host: '<circle cx="12" cy="7" r="3.2"/><path d="M5.5 20c.6-4 3.2-6 6.5-6s5.9 2 6.5 6"/><path d="m10.5 14 1.5 3 1.5-3"/>',
  phone: '<rect x="7" y="2.5" width="10" height="19" rx="2.5"/><path d="M11 18.5h2"/><path d="M9.5 7.5h5M9.5 11h5"/>',
  trophy: '<path d="M8 4h8v5a4 4 0 0 1-8 0z"/><path d="M8 6H5a3 3 0 0 0 3 4M16 6h3a3 3 0 0 1-3 4"/><path d="M12 13v4M8.5 20.5h7M10 17h4"/>',
  build: '<path d="m4 20 10-10"/><path d="m14 4 1 2.5L17.5 7.5 15 8.5 14 11l-1-2.5L10.5 7.5 13 6.5z"/><path d="M19 13v3M17.5 14.5h3"/>',
  gift: '<rect x="4" y="9" width="16" height="11" rx="1.5"/><path d="M3 9h18M12 9v11"/><path d="M12 9C10 5 6.5 5.5 7.5 8c.4 1 2.5 1 4.5 1zM12 9c2-4 5.5-3.5 4.5-1-.4 1-2.5 1-4.5 1z"/>',
};
---

<section class="scene pricing" id="pricing" data-scene="pricing" aria-labelledby="pricing-title">
  <div class="pricing-pin" data-scroll-pause>
  <div class="container pricing-inner">
    <h2 id="pricing-title" class="display h-scene pricing-title reveal">{c.title}</h2>
    <p class="price reveal">
      <span class="price-num"><span class="cur" aria-label={c.currencyLabel}>{PRICING.currency}</span>{PRICING.base}</span>
      <span class="price-per">{c.perGame}<small>{c.oneTime}</small></span>
    </p>
    <p class="lead pricing-sub reveal">{c.sub}</p>

    <ul class="included" role="list">
      {c.included.map((it, i) => (
        <li class="inc reveal" style={`--c:${incColors[i % incColors.length]}`}>
          <span class="inc-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" set:html={icons[it.icon]} />
          </span>
          <h3 class="inc-title display">{fillPrices(it.title)}</h3>
          <p class="inc-text">{fillPrices(it.text)}</p>
        </li>
      ))}
    </ul>

    <a class="btn btn-buzzer pricing-cta" href={CREATE_URL} data-track="cta_create_click" data-source="pricing">
      <span class="btn-dot" aria-hidden="true"></span>
      {c.cta}
    </a>
    <p class="pricing-note">{noteBefore}<a href="/refunds">{c.refundPolicy}</a>{noteAfter}</p>
  </div>
  </div>
</section>

<script>
  import { track } from "../lib/analytics";
  const el = document.getElementById("pricing");
  if (el && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          track("pricing_view");
          io.disconnect();
        }
      },
      { threshold: 0.4 },
    );
    io.observe(el);
  }
</script>

<style>
  /* A readable, standalone feature section with a short native scroll hold. */
  .pricing-pin {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: flex-start;
    padding-block: clamp(80px, 12vh, 120px) clamp(40px, 7vh, 72px);
    overflow: hidden;
  }
  .pricing-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(8px, 1.6vh, 16px);
  }
  .pricing-title {
    margin: 0;
    font-size: var(--fs-story-title);
    text-shadow: 0 4px 0 var(--purple-ink);
  }
  .pricing-sub {
    max-width: 46ch;
    margin: 0 0 clamp(20px, 3vh, 32px);
    color: #f5f7ff;
    font-size: clamp(1.3rem, 2.3vw, 1.65rem);
    font-weight: 400;
  }

  /* ---- the price: yellow numbers like the game ---- */
  .price {
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    color: var(--sun-yellow);
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1;
    text-shadow: 0 4px 0 var(--purple-ink);
  }
  .price-num {
    font-size: clamp(4rem, 11vw, 6rem);
  }
  .price-num .cur {
    font-size: 0.55em;
    vertical-align: 0.6em;
    margin-inline-end: 2px;
  }
  .price-per {
    display: grid;
    gap: 6px;
    text-align: start;
    color: var(--white);
    font-size: clamp(1.4rem, 2.6vw, 1.8rem);
    text-shadow: none;
  }
  .price-per small {
    font-family: var(--font-body, inherit);
    font-weight: 400;
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .pricing-cta {
    margin-top: clamp(20px, 3vh, 32px);
  }

  /* ---- what's included (prices hidden) ---- */
  .included {
    list-style: none;
    margin: clamp(16px, 2.5vh, 24px) 0 0;
    padding: 0;
    width: 100%;
    max-width: 1200px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(12px, 1.8vw, 20px);
    text-align: start;
  }
  .inc {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas: "icon title" "text text";
    column-gap: 28px;
    row-gap: 18px;
    align-items: center;
    padding: clamp(30px, 3.2vw, 38px) 22px 26px;
    min-height: 190px;
    border-radius: 8px 30px 8px 30px; /* the slanted-card look of the host photos */
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.04));
    border: 2px solid var(--surface-border);
    backdrop-filter: blur(6px);
    overflow: hidden;
  }
  .inc-icon {
    grid-area: icon;
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border-radius: 14px;
    background: var(--c);
    color: var(--purple-ink);
    border: 3px solid var(--purple-ink);
    box-shadow: 0 4px 0 var(--purple-ink);
    transform: rotate(-4deg);
  }
  .inc-icon svg {
    width: 60%;
    height: 60%;
  }
  .inc-title {
    grid-area: title;
    margin: 0;
    font-size: clamp(1.45rem, 2vw, 1.8rem);
    line-height: 1.15;
    color: var(--white);
  }
  .inc-text {
    grid-area: text;
    margin: 0;
    font-size: clamp(1.25rem, 1.9vw, 1.45rem);
    font-weight: 400;
    line-height: 1.45;
    color: #f5f7ff;
    white-space: pre-line;
  }
  @media (max-width: 960px) {
    .included {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .included {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  :global(.pricing.mobile-sticky-scene) .pricing-pin {
    min-height: 100lvh;
    padding-block: clamp(72px, 12svh, 104px) 24px;
  }
  :global(.pricing.mobile-sticky-scene) .pricing-sub { margin-bottom: 8px; }
  :global(.pricing.mobile-sticky-scene) .included {
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 16px;
  }
  :global(.pricing.mobile-sticky-scene) .inc {
    min-height: 164px;
    padding: 22px 20px;
    row-gap: 12px;
    column-gap: 22px;
  }
  :global(.pricing.mobile-sticky-scene) .inc:nth-child(odd) { grid-area: 1 / 1; }
  :global(.pricing.mobile-sticky-scene) .inc:nth-child(even) { grid-area: 2 / 1; }
  :global(.pricing.mobile-sticky-scene) .inc-icon { width: 44px; height: 44px; }
  :global(.pricing.mobile-sticky-scene) .inc-text { white-space: normal; text-wrap: balance; }
  @media (orientation: landscape) and (max-height: 500px) {
    :global(.pricing.mobile-sticky-scene) .pricing-pin { padding-block: 20px; }
    :global(.pricing.mobile-sticky-scene) .included { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: 1fr; }
    :global(.pricing.mobile-sticky-scene) .inc:nth-child(even) { grid-area: 1 / 2; }
  }

  .pricing-note {
    margin: 6px 0 0;
    max-width: 62ch;
    color: var(--text-muted);
    font-size: var(--fs-small);
    line-height: 1.5;
  }
  .pricing-note a {
    color: var(--text);
    text-underline-offset: 4px;
  }

</style>
