---
import { useCopy } from "../content/copy";
import { CREATE_URL, PACKAGES, PRICING } from "../config/pricing";
const { copy: COPY } = useCopy(Astro.url);
const c = COPY.pricing;
---

<section class="scene pricing" id="pricing" data-scene="pricing" aria-labelledby="pricing-title">
  <div class="pricing-pin" data-scroll-pause="start">
    <div class="container pricing-inner">
      <h2 id="pricing-title" class="display h-scene pricing-title reveal">{c.title}</h2>
      <p class="lead pricing-sub reveal">{c.sub}</p>
      <div class="packages">
        {PACKAGES.map((tier) => (
          <article class:list={["package reveal", { "package-vip": tier.id === "vip" }]} aria-labelledby={`package-${tier.id}`}>
            <div class="package-heading">
              <h3 id={`package-${tier.id}`} class="display">{tier.name}</h3>
              <span class="package-mark" aria-hidden="true">{tier.id === "vip" ? "✦" : "✧"}</span>
            </div>
            <p class="package-tagline">{c.packages[tier.id].tagline}</p>
            <p class="price"><span class="price-num"><span class="cur">{PRICING.currency}</span>{tier.price}</span><span class="price-per">{c.perGame}</span></p>
            <p class="one-time">{c.oneTime}</p>
            <ul class="package-features" role="list">
              <li>{c.packages[tier.id].host}</li>
              <li><strong>{tier.questions} questions</strong> + real-time leaderboard</li>
              <li>Up to <strong>{tier.participants} concurrent participants</strong></li>
              <li><strong>{tier.edits} question edits</strong></li>
              <li>Game link works for <strong>{tier.linkDays} days</strong></li>
            </ul>
            <a class:list={["btn pricing-cta", { "btn-white": tier.id === "basic" }]} href={CREATE_URL} data-track="cta_create_click" data-source={`pricing-${tier.id}`} aria-label={`${c.cta} with ${tier.name}`}>
              {c.cta}<span aria-hidden="true">↗</span>
            </a>
          </article>
        ))}
      </div>
      <a class="pricing-refunds" href="/refunds">{c.refundPolicy}</a>
    </div>
  </div>
</section>

<script>
  import { track } from "../lib/analytics";
  const el = document.getElementById("pricing");
  if (el && "IntersectionObserver" in window) {
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { track("pricing_view"); io.disconnect(); }
    }, { threshold: 0.2 });
    io.observe(el);
  }
</script>

<style>
  .pricing-pin { min-height: 100svh; padding-block: clamp(72px, 10vh, 110px) clamp(48px, 7vh, 80px); }
  .pricing-inner { max-width: 1120px; text-align: center; }
  .pricing-title { font-size: var(--fs-story-title); text-shadow: 0 4px 0 var(--purple-ink); }
  .pricing-sub { margin: 18px auto 40px; max-width: 48ch; color: var(--text-muted); }
  .packages { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 26px; text-align: left; }
  .package { --accent: var(--sky-cyan); display: flex; flex-direction: column; padding: clamp(26px, 3.4vw, 44px); border: 2px solid rgba(255,255,255,.28); border-radius: 12px 36px 12px 36px; background: linear-gradient(145deg, #153b99, #0b205f); box-shadow: 0 16px 48px #020c5026; }
  .package-vip { --accent: var(--game-yellow); border-color: var(--game-yellow); background: radial-gradient(ellipse at top right, #75611338, transparent 65%), linear-gradient(145deg, #173b92, #0b205f); }
  .package-heading { display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  .package-heading h3 { font-size: 2.8rem; color: var(--accent); }
  .package-mark { font-size: 2.5rem; line-height: 1; color: var(--accent); }
  .package-tagline { margin-top: 12px; color: var(--text-muted); font-size: 1.35rem; }
  .price { display: flex; align-items: baseline; gap: 14px; margin-top: 26px; font-family: var(--font-display); }
  .price-num { font-size: clamp(4.4rem, 8vw, 6rem); line-height: 1; font-weight: 700; color: var(--white); }
  .cur { font-size: .55em; vertical-align: .38em; margin-right: 3px; }
  .price-per { font-size: 1.45rem; color: var(--text-muted); }
  .one-time { margin-top: 12px; font-size: 1.25rem; color: var(--text-muted); }
  .package-features { padding: 26px 0; margin: 26px 0 0; border-top: 1px solid var(--surface-border); list-style: none; display: grid; gap: 16px; font-size: 1.4rem; line-height: 1.3; }
  .package-features li { position: relative; padding-left: 30px; }
  .package-features li::before { content: "✓"; position: absolute; left: 0; top: 0; color: var(--accent); font-weight: 700; }
  .package-features strong { font-weight: 700; }
  .pricing-cta { width: 100%; margin-top: auto; justify-content: space-between; font-size: 1.65rem; }
  .pricing-refunds { display: inline-block; margin-top: 28px; color: var(--text-muted); text-underline-offset: 5px; }
  .pricing-refunds:hover { color: var(--white); }
  @media (max-width: 650px) {
    .packages { grid-template-columns: 1fr; gap: 24px; max-width: 480px; margin-inline: auto; }
    .pricing-sub { margin-bottom: 30px; }
    .package { padding: 28px; }
    .package-features { font-size: 1.35rem; }
  }
</style>
