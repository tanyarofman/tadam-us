---
import { useCopy } from "../content/copy";
import { CREATE_URL, PACKAGES, PRICING } from "../config/pricing";
const { copy: COPY } = useCopy(Astro.url);
const c = COPY.pricing;
const [titleBefore, titleAfter] = c.title.split(c.highlight);
---

<section class="scene pricing" id="pricing" data-scene="pricing" aria-labelledby="pricing-title">
  <div class="pricing-pin" data-scroll-pause="start">
    <div class="container pricing-inner">
      <h2 id="pricing-title" class="display h-scene pricing-title reveal">{titleBefore}<span class="phrase-highlight swoosh">{c.highlight}</span>{titleAfter}</h2>
      <p class="lead pricing-sub reveal">{c.sub}</p>
      <div class="packages">
        {PACKAGES.map((tier) => (
          <article data-sequence-card aria-labelledby={`package-${tier.id}`}>
            <a class:list={["package reveal", { "package-vip": tier.id === "vip" }]} href={CREATE_URL} data-track="cta_create_click" data-source={`pricing-${tier.id}`} aria-label={`${c.cta} with ${tier.name}`}>
              <div class="package-heading">
                <p class="price"><span class="price-num">{PRICING.currency}{tier.price}</span><span class="price-per">{c.perGame}</span></p>
                <h3 id={`package-${tier.id}`} class="display">{tier.name}</h3>
              </div>
              <p class="one-time">{c.oneTime}</p>
              <ul class="package-features" role="list">
                <li>{c.packages[tier.id].host}</li>
                <li>{tier.questions} questions + real-time leaderboard</li>
                <li>Up to {tier.participants} concurrent participants</li>
                <li>{tier.edits} question edits</li>
                <li>Game link works for {tier.linkDays} days</li>
              </ul>
              <span class="btn pricing-cta">{c.cta}</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { track } from "../lib/analytics";
  const el = document.getElementById("pricing");
  if (el && "IntersectionObserver" in window) {
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { track("pricing_view"); io.disconnect(); }
    }, { threshold: 0.2 });
    io.observe(el);
  }
</script>

<style>
  .pricing-pin { min-height: 100svh; padding-block: clamp(72px, 10vh, 110px) clamp(80px, 12vh, 128px); }
  .pricing-inner { max-width: 1120px; text-align: center; }
  .pricing-title { font-size: var(--fs-story-title); text-shadow: 0 4px 0 var(--purple-ink); }
  .pricing-sub { margin: 22px auto 44px; max-width: 48ch; color: var(--text-muted); }
  .packages { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; text-align: left; }
  .package { --accent: #00cdea; --price-color: #05DBFB; height: 100%; text-decoration: none; display: flex; flex-direction: column; padding: clamp(24px, 2.6vw, 32px) clamp(24px, 2.6vw, 28px) 34px; border: 2px solid #ffffff50; border-radius: 12px 36px 12px 36px; background: linear-gradient(145deg, #073d95, #082563); box-shadow: 0 16px 48px #020c5026; color: #C7D5EF; }
  .package:focus-visible { outline: 3px solid var(--accent); outline-offset: 5px; }
  .package-vip { --accent: var(--game-yellow); --price-color: #FBCE02; border-color: var(--game-yellow); background: linear-gradient(145deg, #1b4385, #0a245d); color: #FFF9C5; }
  .package-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }
  .package-heading h3 { display: grid; place-items: center; flex-shrink: 0; min-width: 112px; min-height: 44px; padding: 6px 22px; border-radius: 99px; background: var(--accent); color: var(--pill-ink); font-size: 1.6rem; line-height: 1; text-transform: uppercase; }
  .price { display: flex; align-items: baseline; gap: 10px; margin: 8px 0 0; font-family: var(--font-display); white-space: nowrap; }
  .price-num { font-size: clamp(4.1rem, 6.1vw, 4.8rem); line-height: 1; font-weight: 700; color: var(--price-color); }
  .price-per { font-size: 1.3rem; }
  .one-time { margin-top: 8px; font-size: 1.5rem; line-height: 1.2; }
  .package-features { padding: 28px 0 32px; margin: 28px 0 0; border-top: 2px solid #ffffff2b; list-style: none; display: grid; gap: 8px; font-size: 1.4rem; line-height: 1.25; }
  .package-features li { position: relative; padding-left: 36px; }
  .package-features li::before { content: "✓"; position: absolute; left: 0; top: -.12em; font-size: 1.2em; font-weight: 700; }
  .pricing-cta { --btn-bg: var(--accent); min-width: 176px; min-height: 46px; align-self: flex-start; margin-top: auto; padding: 8px 26px 10px; font-size: 1.5rem; text-transform: uppercase; box-shadow: none; }
  @media (max-width: 900px) and (min-width: 651px) {
    .packages { gap: 22px; }
    .package { padding-inline: 24px; }
    .package-heading { gap: 8px; }
    .package-heading h3 { min-width: 90px; padding-inline: 16px; font-size: 1.5rem; }
    .price { gap: 6px; }
    .price-num { font-size: 3.7rem; }
    .price-per { font-size: 1.2rem; }
    .one-time { font-size: 1.35rem; }
    .package-features { font-size: 1.3rem; }
  }
  @media (max-width: 650px) {
    .packages { grid-template-columns: 1fr; gap: 24px; max-width: 448px; margin-inline: auto; }
    .pricing-sub { margin-bottom: 30px; }
    .package { padding: 24px 22px 28px; }
    .package-heading h3 { min-width: 94px; min-height: 44px; padding-inline: 18px; font-size: 1.5rem; }
    .price-num { font-size: 4.1rem; }
    .price-per { font-size: 1.2rem; }
    .one-time { font-size: 1.4rem; }
    .package-features { margin-top: 24px; padding-block: 24px 28px; font-size: 1.35rem; }
  }
  @media (max-width: 360px) {
    .package { padding-inline: 20px; }
    .package-heading { gap: 8px; }
    .package-heading h3 { min-width: 84px; padding-inline: 12px; }
    .price { gap: 6px; }
    .price-num { font-size: 3.7rem; }
  }
  @media (max-width: 767px), (orientation: landscape) and (max-height: 500px) {
    :global(.pricing.is-replacing) .pricing-pin { display: grid; align-items: center; padding-block: 24px; }
    :global(.pricing.is-replacing) .pricing-sub { margin: 16px auto 24px; }
    :global(.pricing.is-replacing) .packages { grid-template-columns: minmax(0, 1fr); max-width: 448px; margin-inline: auto; perspective: 1400px; }
    :global(.pricing.is-replacing) .packages > article { grid-area: 1 / 1; transform-origin: 0% 50%; }
    :global(.pricing.is-replacing) .package { opacity: 1; transform: none; transition: none; }
  }
  @media (max-width: 767px) and (max-height: 700px) {
    :global(.pricing.is-replacing) .pricing-pin { padding-block: 16px; }
    :global(.pricing.is-replacing) .pricing-sub { margin: 12px auto 20px; font-size: 1.2rem; }
    :global(.pricing.is-replacing) .package { padding: 18px; }
    :global(.pricing.is-replacing) .package-heading { gap: 8px; }
    :global(.pricing.is-replacing) .package-heading h3 { min-width: 84px; min-height: 40px; padding-inline: 12px; }
    :global(.pricing.is-replacing) .price { margin-top: 0; }
    :global(.pricing.is-replacing) .price-num { font-size: 3.4rem; }
    :global(.pricing.is-replacing) .one-time { font-size: 1.25rem; }
    :global(.pricing.is-replacing) .package-features { margin-top: 16px; padding-block: 18px; gap: 6px; font-size: 1.2rem; }
    :global(.pricing.is-replacing) .pricing-cta { min-height: 44px; font-size: 1.3rem; }
  }
  @media (orientation: landscape) and (max-height: 500px) {
    :global(.pricing.is-replacing) .pricing-pin { padding-block: 16px; }
    :global(.pricing.is-replacing) .pricing-title { font-size: clamp(1.6rem, 4vw, 2.2rem); }
    :global(.pricing.is-replacing) .pricing-sub { margin: 8px auto 16px; font-size: 1.2rem; }
    :global(.pricing.is-replacing) .packages { max-width: 760px; }
    :global(.pricing.is-replacing) .package { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 8px 24px; padding: 16px 20px; }
    :global(.pricing.is-replacing) .package-heading { grid-column: 1; gap: 8px; }
    :global(.pricing.is-replacing) .package-heading h3 { min-width: 74px; min-height: 36px; padding-inline: 12px; font-size: 1.3rem; }
    :global(.pricing.is-replacing) .price { margin: 0; gap: 6px; }
    :global(.pricing.is-replacing) .price-num { font-size: 3rem; }
    :global(.pricing.is-replacing) .price-per { font-size: 1.05rem; }
    :global(.pricing.is-replacing) .one-time { grid-column: 1; grid-row: 2; margin: 0; font-size: 1.25rem; }
    :global(.pricing.is-replacing) .package-features { grid-column: 2; grid-row: 1 / 4; align-self: center; margin: 0; padding: 0 0 0 20px; border-top: 0; border-left: 2px solid #ffffff2b; gap: 6px; font-size: 1.2rem; }
    :global(.pricing.is-replacing) .pricing-cta { grid-column: 1; grid-row: 3; justify-self: start; min-width: 140px; min-height: 44px; margin: 0; font-size: 1.3rem; }
  }
</style>
