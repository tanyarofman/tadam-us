---
import { COPY } from "../content/copy.he";
import { CREATE_URL, PRICING, fillPrices } from "../config/pricing";
import StageBackdrop from "./StageBackdrop.astro";
import Person from "./art/Person.astro";
const c = COPY.pricing;
const h = c.addons.personalHost.showcase;
const hostPhotos = ["host-classic", "host-friendly", "host-animated"];
const cur = PRICING.currency;
// Prices hidden: the section becomes "what's included" (no numbers, no edit card, add-ons get a badge).
const show = PRICING.showPrices;
const incColors = ["var(--game-yellow)", "var(--sky-cyan)", "var(--magenta)", "var(--buzzer-red)"];
// simple line icons (24x24, stroke = currentColor)
const icons: Record<string, string> = {
  story: '<path d="M4 5h11a3 3 0 0 1 3 3v11H7a3 3 0 0 1-3-3z"/><path d="M8 9h6M8 13h4"/><path d="M18 8h2v11"/>',
  host: '<circle cx="12" cy="7" r="3.2"/><path d="M5.5 20c.6-4 3.2-6 6.5-6s5.9 2 6.5 6"/><path d="m10.5 14 1.5 3 1.5-3"/>',
  phone: '<rect x="7" y="2.5" width="10" height="19" rx="2.5"/><path d="M11 18.5h2"/><path d="M9.5 7.5h5M9.5 11h5"/>',
  trophy: '<path d="M8 4h8v5a4 4 0 0 1-8 0z"/><path d="M8 6H5a3 3 0 0 0 3 4M16 6h3a3 3 0 0 1-3 4"/><path d="M12 13v4M8.5 20.5h7M10 17h4"/>',
  build: '<path d="m4 20 10-10"/><path d="m14 4 1 2.5L17.5 7.5 15 8.5 14 11l-1-2.5L10.5 7.5 13 6.5z"/><path d="M19 13v3M17.5 14.5h3"/>',
  gift: '<rect x="4" y="9" width="16" height="11" rx="1.5"/><path d="M3 9h18M12 9v11"/><path d="M12 9C10 5 6.5 5.5 7.5 8c.4 1 2.5 1 4.5 1zM12 9c2-4 5.5-3.5 4.5-1-.4 1-2.5 1-4.5 1z"/>',
};
---

<section class="scene pricing" id="pricing" data-scene="pricing" aria-labelledby="pricing-title">
  <StageBackdrop floorOnly />
  <div class="container pricing-inner">
    <h2 id="pricing-title" class="display h-scene pricing-title reveal">{show ? c.title : c.includedTitle}</h2>
    <p class="lead pricing-sub reveal">{show ? c.sub : c.includedSub}</p>

    {!show && (
      <>
        <ul class="included" role="list">
          {c.included.map((it, i) => (
            <li class="inc reveal" style={`--c:${incColors[i % incColors.length]}`}>
              <span class="inc-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" set:html={icons[it.icon]} />
              </span>
              <h3 class="inc-title display">{it.title}</h3>
              <p class="inc-text">{fillPrices(it.text)}</p>
            </li>
          ))}
        </ul>
      </>
    )}

    {show && (
    <ul class="cards" role="list" aria-label={c.cardsLabel}>
      <li class="card card--main reveal">
        <h3 class="card-name">{c.cards.base.name}</h3>
        {<p class="price"><span class="num">{PRICING.base}</span><span class="cur" aria-label="שקלים">{cur}</span></p>}
        <ul class="perks" role="list">
          {c.cards.base.perks.map((p) => <li class="pill">{fillPrices(p)}</li>)}
        </ul>
        <a class="btn btn-buzzer card-cta" href={CREATE_URL} data-track="cta_create_click" data-source="pricing">
          <span class="btn-dot" aria-hidden="true"></span>
          {c.cards.base.cta}
        </a>
      </li>

      <li class="card reveal">
        <h3 class="card-name">{c.cards.edit.name}</h3>
        <p class="price"><span class="num">{PRICING.edit}</span><span class="cur" aria-label="שקלים">{cur}</span></p>
        <p class="card-text">{c.cards.edit.text}</p>
        <p class="card-note">{c.cards.edit.note}</p>
      </li>

    </ul>
    )}

    <div class="hosts reveal" id="hosts" aria-labelledby="hosts-title">
      <div class="hosts-top">
        <div class="hosts-photos" role="list" aria-label={h.photosLabel}>
          {hostPhotos.map((name, i) => (
            <Person name={name} alt={h.readyAlts[i]} width={480} height={640} class={`host-photo host-photo--${i + 1}`} />
          ))}
        </div>
        <div class="hosts-head">
          <span class="spark" aria-hidden="true"><i></i><i></i><i></i></span>
          <h4 id="hosts-title" class="display hosts-title">
            <span>{h.titleLine1}</span>
            <span class="hl swoosh">{h.titleLine2}</span>
          </h4>
          <p class="hosts-sub">{h.sub}</p>
        </div>
      </div>

    </div>

    {show && <p class="pricing-note">{c.note}</p>}
  </div>
</section>

<script>
  import { track } from "../lib/analytics";
  const el = document.getElementById("pricing");
  if (el && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          track("pricing_view");
          io.disconnect();
        }
      },
      { threshold: 0.4 },
    );
    io.observe(el);
  }
</script>

<style>
  /* desktop: the whole section (what's included + hosts) fits in one screen, sizes follow the screen height */
  .pricing {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: clamp(24px, 4vh, 48px) clamp(96px, 14vh, 140px);
    overflow: hidden;
  }
  .pricing-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(8px, 1.6vh, 16px);
  }
  .pricing-title {
    margin: 0;
    font-size: clamp(2.2rem, 7vh, 4rem);
    text-shadow: 0 4px 0 var(--purple-ink);
  }
  .pricing-sub {
    max-width: 46ch;
    margin: 0 0 clamp(4px, 1.2vh, 14px);
  }

  /* ---- 3 cards (mobile first: stacked) ---- */
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    display: grid;
    gap: 16px;
    grid-template-columns: minmax(0, 1fr);
  }
  .card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 28px 22px 26px;
    border-radius: var(--radius-l);
    background: var(--surface);
    border: 2px solid var(--surface-border);
    backdrop-filter: blur(6px);
  }
  .card--main {
    border-color: var(--sun-yellow);
    box-shadow: 0 0 0 4px rgba(247, 217, 74, 0.18), 0 18px 50px rgba(0, 0, 20, 0.35);
    background: var(--surface-solid);
  }
  .card-name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-h3);
    line-height: 1.15;
  }

  /* yellow numbers like the game */
  .price {
    margin: 0;
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 6px;
    color: var(--sun-yellow);
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1;
  }
  .price .num {
    font-size: clamp(4rem, 14vw, 5.5rem);
  }
  .price .cur {
    font-size: clamp(1.6rem, 5vw, 2.2rem);
  }
  .price--text {
    font-size: clamp(1.6rem, 4.6vw, 2.1rem);
    line-height: 1.2;
    min-height: 2.4em;
    display: grid;
    place-items: center;
  }
  .card-text {
    margin: 0;
    color: var(--text-muted);
    font-size: 1.1rem;
    line-height: 1.5;
    max-width: 24ch;
    text-wrap: balance;
  }
  .card-note {
    margin: auto 0 0;
    color: var(--text-muted);
    font-size: var(--fs-small);
    opacity: 0.85;
  }

  /* white answer pills */
  .perks {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    display: grid;
    gap: 10px;
  }
  .pill {
    padding: 11px 18px;
    border-radius: 999px;
    background: var(--white);
    color: var(--bg-0);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    line-height: 1.25;
    text-align: right;
    text-wrap: balance;
  }
  .card-cta {
    margin-top: 8px;
    width: 100%;
  }
  .card-link {
    margin-top: auto;
  }

  /* ---- what's included (prices hidden) ---- */
  .included {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    max-width: 1080px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(12px, 1.8vw, 20px);
    text-align: right;
  }
  .inc {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas: "icon title" "icon text";
    column-gap: 14px;
    row-gap: 2px;
    align-items: center;
    padding: clamp(12px, 1.8vh, 20px) 20px;
    border-radius: 8px 30px 8px 30px; /* the slanted-card look of the host photos */
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.04));
    border: 2px solid var(--surface-border);
    backdrop-filter: blur(6px);
    overflow: hidden;
  }
  /* a strip of the tile's color along the start edge */
  .inc::before {
    content: "";
    position: absolute;
    inset-block: 18px;
    inset-inline-start: 0;
    width: 5px;
    border-radius: 0 5px 5px 0;
    background: var(--c);
  }
  .inc-icon {
    grid-area: icon;
    display: grid;
    place-items: center;
    width: clamp(42px, 5.6vh, 52px);
    height: clamp(42px, 5.6vh, 52px);
    border-radius: 14px;
    background: var(--c);
    color: var(--purple-ink);
    border: 3px solid var(--purple-ink);
    box-shadow: 0 4px 0 var(--purple-ink);
    transform: rotate(-4deg);
  }
  .inc-icon svg {
    width: 60%;
    height: 60%;
  }
  .inc-title {
    grid-area: title;
    margin: 0;
    font-size: clamp(1.2rem, 1.7vw, 1.45rem);
    line-height: 1.15;
    color: var(--white);
  }
  .inc-text {
    grid-area: text;
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.45;
    color: var(--text-muted);
  }
  @media (max-width: 960px) {
    .included {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .included {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ---- hosts showcase ---- */
  .hosts {
    width: 100%;
    max-width: 1080px;
    margin-top: clamp(6px, 1.5vh, 16px);
    display: grid;
    gap: 22px;
    text-align: right;
  }
  .hosts-top {
    display: grid;
    gap: 22px;
    align-items: center;
  }
  .hosts-photos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(8px, 2vw, 18px);
    direction: ltr; /* order as in the design: classic, friendly, animated */
  }
  /* Ilan's host cards: slanted sides, one big rounded corner, stepping up from left to right */
  /* photo height follows the screen height so the section fits in one screen */
  .hosts-photos {
    align-items: end;
    padding-top: 28px;
  }
  .hosts-photos :global(.host-photo) {
    aspect-ratio: 3 / 4.6 !important;
    border-radius: 6px 34px 6px 28px;
    transform: skewX(-4deg);
    box-shadow: 0 18px 36px rgba(0, 0, 20, 0.45);
  }
  .hosts-photos :global(.host-photo .person-img) {
    transform: skewX(4deg) scale(1.1); /* keep the faces straight inside the slanted card */
  }
  .hosts-photos :global(.host-photo--2) {
    transform: skewX(-4deg) translateY(-14px);
  }
  .hosts-photos :global(.host-photo--3) {
    transform: skewX(-4deg) translateY(-28px);
  }
  .hosts-head {
    position: relative;
    display: grid;
    gap: 10px;
  }
  .spark {
    position: absolute;
    inset-block-start: -6px;
    inset-inline-end: 4px;
    width: 46px;
    height: 24px;
  }
  .spark i {
    position: absolute;
    width: 5px;
    height: 16px;
    border-radius: 3px;
    background: var(--sun-yellow);
    inset-block-start: 4px;
  }
  .spark i:nth-child(1) { inset-inline-end: 0; transform: rotate(35deg); }
  .spark i:nth-child(2) { inset-inline-end: 20px; inset-block-start: 0; }
  .spark i:nth-child(3) { inset-inline-end: 40px; transform: rotate(-35deg); }
  .hosts-title {
    margin: 0;
    display: grid;
    font-size: clamp(2.2rem, 6.4vh, 3.6rem);
    line-height: 1.02;
  }
  .hl {
    color: var(--sun-yellow);
  }
  .hosts-title .hl {
    position: relative;
    width: fit-content;
    padding-bottom: 12px;
  }
  .hosts-title .hl::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 18px;
  }
  .hosts-sub {
    margin: 0;
    font-size: var(--fs-lead);
    line-height: 1.35;
    color: var(--white);
  }
  @media (min-width: 760px) {
    .hosts-top {
      grid-template-columns: 1.25fr 1fr;
    }
    .hosts-photos {
      --ph: clamp(150px, 27vh, 280px);
      grid-template-columns: repeat(3, calc(var(--ph) * 0.652));
      justify-content: start;
    }
  }
  .pricing-note {
    margin: 6px 0 0;
    color: var(--text-muted);
    font-size: var(--fs-small);
  }

  .cards--single {
    max-width: 520px;
  }
  @media (min-width: 960px) {
    .cards--single {
      grid-template-columns: minmax(0, 1fr);
      max-width: 520px;
    }
    .cards:not(.cards--single) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: 820px;
      align-items: stretch;
      gap: 20px;
    }
  }
</style>
