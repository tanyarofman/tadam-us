---
/**
 * The site header for pages other than the home page (the home page has its own, inside the hero:
 * src/components/scenes/Scene0Hero.astro). Same look: logo, the nav (links back to the home page sections)
 * and the "Create yours" button. Keep the two in sync.
 */
import { useCopy } from "../content/copy";
import { CREATE_URL } from "../config/pricing";
const { copy: COPY, home } = useCopy(Astro.url);
const c = COPY.hero;
const base = home.endsWith("/") ? home : `${home}/`;
---

<header class="site-header">
  <div class="site-bar container hero-wide">
    <a href={home} class="site-home" aria-label={COPY.brand}><img src="/brand/tadam-logo-navigation.webp" alt="" width="894" height="394" /></a>
    <nav class="site-nav" aria-label={c.navLabel}>
      <ul role="list">{c.nav.map((l) => <li><a href={`${base}${l.href}`}>{l.label}</a></li>)}</ul>
    </nav>
    <a class="btn site-cta" href={CREATE_URL} data-track="cta_create_click" data-source="site-header">{c.navCta}</a>
  </div>
</header>

<style>
  .hero-wide { --max-w: 1360px; --gutter: clamp(24px, 7vw, 96px); }
  .site-header { position: relative; z-index: 3; background: #071548; }
  .site-bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: clamp(14px, 2.4vh, 24px); }
  .site-home { display: block; line-height: 0; }
  .site-home img { width: clamp(118px, 12vw, 172px); height: auto; }
  .site-nav ul { display: flex; gap: clamp(18px, 3vw, 44px); margin: 0; padding: 0; list-style: none; }
  .site-nav a { font-family: var(--font-display); font-weight: 700; font-size: 1.75rem; color: var(--white); text-decoration: none; }
  .site-nav a:hover { color: var(--game-yellow); }
  .site-cta { min-height: 52px; padding: 10px 28px 12px; font-size: 1.625rem; white-space: nowrap; }
  @media (max-width: 900px) {
    .site-nav { display: none; }
  }
  @media (max-width: 767px) {
    .site-bar { padding-block: 14px; }
    .site-cta { min-height: 46px; padding: 8px 20px 10px; font-size: 1.375rem; }
  }
  @media (max-width: 380px) {
    .site-bar { gap: 10px; }
    .site-cta { padding-inline: 14px; font-size: 1.15rem; }
    .site-home img { width: 96px; }
  }
</style>
