---
/**
 * Heading split into words at build time (no layout shift).
 * Words animate in with a bounce via GSAP (see scripts/motion.ts -> animateWords).
 * `highlight` = a word (or part of the text) to underline with the magenta swoosh.
 */
interface Props {
  text: string;
  as?: "h1" | "h2" | "h3" | "p";
  class?: string;
  highlight?: string;
  id?: string;
  /** force a line break after this many words (wide screens only, see .split-br) */
  breakAfter?: number;
}
const { text, as: Tag = "h2", class: cls = "", highlight, id, breakAfter } = Astro.props;
const words = text.split(/\s+/).filter(Boolean);
const hlWords = highlight ? highlight.split(/\s+/) : [];
---

<Tag class:list={["display", "split", cls]} id={id} data-split>
  {
    words.map((w, i) => (
      <>
        <span class:list={["word", { "word-hl": hlWords.includes(w.replace(/[.,?!]/g, "")) }]}>
          <span class:list={["word-in", { swoosh: hlWords.includes(w.replace(/[.,?!]/g, "")) }]}>{w}</span>
        </span>
        {i < words.length - 1 ? " " : ""}
        {breakAfter === i + 1 && <br class="split-br" />}
      </>
    ))
  }
</Tag>

<style>
  .split .word {
    position: relative;
  }
  .split .word-in {
    display: inline-block;
    will-change: transform;
  }
  .word-hl .word-in {
    position: relative;
  }
  /* shape and color: .swoosh in global.css */
  .word-hl .word-in::after {
    inset-inline: -0.08em;
    bottom: -0.14em;
    height: 0.24em;
    z-index: -1;
  }
</style>
