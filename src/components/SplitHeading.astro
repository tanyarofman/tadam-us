---
/**
 * Heading split into words at build time (no layout shift).
 * Words animate in with a bounce via GSAP (see scripts/motion.ts -> animateWords).
 * `highlight` = a word (or part of the text) to underline with the magenta swoosh.
 */
interface Props {
  text: string;
  as?: "h1" | "h2" | "h3" | "p";
  class?: string;
  highlight?: string;
  id?: string;
}
const { text, as: Tag = "h2", class: cls = "", highlight, id } = Astro.props;
const words = text.split(/\s+/).filter(Boolean);
const hlWords = highlight ? highlight.split(/\s+/) : [];
---

<Tag class:list={["display", "split", cls]} id={id} data-split>
  {
    words.map((w, i) => (
      <>
        <span class:list={["word", { "word-hl": hlWords.includes(w.replace(/[.,?!]/g, "")) }]}>
          <span class="word-in">{w}</span>
        </span>
        {i < words.length - 1 ? " " : ""}
      </>
    ))
  }
</Tag>

<style>
  .split .word {
    position: relative;
  }
  .split .word-in {
    display: inline-block;
    will-change: transform;
  }
  .word-hl .word-in {
    position: relative;
  }
  .word-hl .word-in::after {
    content: "";
    position: absolute;
    inset-inline: -0.06em;
    bottom: -0.04em;
    height: 0.14em;
    border-radius: 999px;
    background: var(--magenta);
    z-index: -1;
    transform: rotate(-1.5deg);
  }
</style>
