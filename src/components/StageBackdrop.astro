---
interface Props {
  class?: string;
}
const { class: cls = "" } = Astro.props;
---

<div class:list={["stage-backdrop", cls]} aria-hidden="true">
  <div class="dots"></div>
  <div class="spot spot-a"></div>
  <div class="spot spot-c"></div>
  <div class="spot spot-b"></div>
  <div class="floor"></div>
  <div class="floor-strip"></div>
</div>
