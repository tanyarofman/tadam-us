---
/**
 * The game stage rebuilt in CSS (see .stage-backdrop in global.css):
 * vertical light beams, dark navy edges, a back-wall shadow, a floor with beam
 * reflections and the glowing white strip. Used behind the hero and the closing CTA.
 */
interface Props {
  class?: string;
}
const { class: cls = "" } = Astro.props;
---

<div class:list={["stage-backdrop", cls]} aria-hidden="true">
  <div class="beams"></div>
  <div class="edges"></div>
  <div class="wall-base"></div>
  <div class="floor"></div>
  <div class="reflections"></div>
  <div class="floor-strip"></div>
</div>
