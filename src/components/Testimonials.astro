---
import { useCopy } from "../content/copy";
import { REVIEW_SCALE, summarizeReviews } from "../lib/reviews";
const { copy: COPY } = useCopy(Astro.url);
const c = COPY.testimonials;
const ratingSummary = summarizeReviews(c.items);
const accents = ["var(--sky-cyan)", "var(--game-yellow)", "#ff90cf"];
---

<section class="scene testimonials" id="testimonials" aria-labelledby="testimonials-title">
  <div class="testimonials-pin" data-scroll-pause="start">
    <div class="container">
      <h2 id="testimonials-title" class="display h-scene testimonials-title reveal">{c.title}</h2>
      <div class="testimonials-grid">
        {c.items.map((person, i) => (
          <figure id={`testimonial-${person.id}`} class="testimonial reveal" style={`--accent:${accents[i]}`}>
            <div class="testimonial-heading">
              <span class="quote-mark" aria-hidden="true">“</span>
              <span class="review-rating" role="img" aria-label={`${person.rating} out of ${REVIEW_SCALE.bestRating} stars`}>
                <span aria-hidden="true">{"★".repeat(person.rating)}{"☆".repeat(REVIEW_SCALE.bestRating - person.rating)}</span>
              </span>
            </div>
            <blockquote><p>{person.quote}</p></blockquote>
            <figcaption>
              <img class="avatar" src={person.image} alt="" width="300" height="300" loading="lazy" decoding="async" />
              <span><strong>{person.name}</strong><span class="event">{person.event}</span></span>
            </figcaption>
          </figure>
        ))}
      </div>
      <p class="rating-summary reveal">{ratingSummary.ratingValue}/{ratingSummary.bestRating} from these {ratingSummary.reviewCount} customer reviews</p>
    </div>
  </div>
</section>

<style>
  .testimonials-pin { min-height: 100svh; display: grid; align-items: center; padding-block: clamp(72px, 10vh, 110px); }
  .testimonials-title { max-width: 24ch; margin-inline: auto; font-size: var(--fs-story-title); text-align: center; }
  .rating-summary { margin: 24px 0 0; color: var(--text-muted); font-size: 1.3rem; text-align: center; }
  .testimonials-grid { margin-top: 28px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .testimonial { display: flex; flex-direction: column; margin: 0; padding: 22px 30px 30px; background: linear-gradient(150deg, #163883, #0a1d54); border: 2px solid var(--surface-border); border-top: 3px solid var(--accent); border-radius: 12px 32px 12px 32px; }
  .testimonial-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .review-rating { color: var(--game-yellow); font-family: Arial, sans-serif; font-size: 1.25rem; letter-spacing: 0.12em; white-space: nowrap; }
  .quote-mark { height: 62px; color: var(--accent); font-size: 6rem; line-height: 1; font-family: Georgia, serif; }
  blockquote { margin: 0 0 30px; font-size: 1.5rem; line-height: 1.45; }
  figcaption { display: flex; align-items: center; gap: 14px; margin-top: auto; padding-top: 24px; border-top: 1px solid var(--surface-border); }
  .avatar { flex-shrink: 0; width: 72px; height: 72px; border-radius: 50%; object-fit: cover; border: 2px solid var(--accent); }
  figcaption strong { display: block; font-size: 1.3rem; }
  .event { display: block; color: var(--text-muted); font-size: 1.15rem; }
  @media (max-width: 767px), (orientation: landscape) and (max-height: 500px) {
    .testimonials-grid { grid-template-columns: 1fr; max-width: 480px; margin-inline: auto; }
    :global(.testimonials.is-replacing) .testimonials-pin { align-items: start; padding-block: clamp(64px, 10svh, 100px) 24px; }
    :global(.testimonials.is-replacing) .testimonials-grid { perspective: 1400px; }
    :global(.testimonials.is-replacing) .testimonial { grid-area: 1 / 1; padding: 18px 24px 24px; transform-origin: 0% 50%; transition: none; }
    :global(.testimonials.is-replacing) .quote-mark { height: 52px; font-size: 5rem; }
    :global(.testimonials.is-replacing) blockquote { margin-bottom: 24px; font-size: 1.4rem; line-height: 1.35; }
    :global(.testimonials.is-replacing) figcaption { padding-top: 18px; }
    :global(.testimonials.is-replacing) .avatar { width: 60px; height: 60px; }
    :global(.testimonials.is-replacing) .rating-summary { margin-top: 20px; opacity: 1; transform: none; }
  }
  @media (max-width: 767px) and (max-height: 700px) {
    :global(.testimonials.is-replacing) .testimonials-pin { padding-block: 36px 20px; }
    :global(.testimonials.is-replacing) .testimonials-grid { margin-top: 20px; }
    :global(.testimonials.is-replacing) blockquote { font-size: 1.3rem; line-height: 1.3; margin-bottom: 18px; }
    :global(.testimonials.is-replacing) .quote-mark { height: 44px; font-size: 4.5rem; }
  }
  @media (orientation: landscape) and (max-height: 500px) {
    :global(.testimonials.is-replacing) .testimonials-pin { padding-block: 16px; }
    :global(.testimonials.is-replacing) .testimonials-title { max-width: none; font-size: 2.2rem; }
    :global(.testimonials.is-replacing) .testimonials-grid { max-width: 760px; margin-top: 12px; }
    :global(.testimonials.is-replacing) .testimonial { display: grid; grid-template-columns: 1fr 190px; column-gap: 24px; padding: 12px 20px 20px; }
    :global(.testimonials.is-replacing) .quote-mark { height: 40px; font-size: 4rem; }
    :global(.testimonials.is-replacing) blockquote { margin-bottom: 0; }
    :global(.testimonials.is-replacing) figcaption { grid-column: 2; grid-row: 1 / 3; align-self: center; margin-top: 0; padding-top: 0; border-top: 0; }
    :global(.testimonials.is-replacing) .rating-summary { margin-top: 12px; }
  }
</style>
