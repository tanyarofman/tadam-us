---
/** A guest portrait (3:4). Photo: public/people/<name>.webp. Fictional, generated people only. */
import Person from "./Person.astro";
interface Props {
  name: "guest-grandma" | "guest-aunt" | "guest-bestfriend" | "guest-cousin" | "guest-dad" | "guest-teacher";
  alt: string;
  class?: string;
}
const { name, alt, class: cls = "" } = Astro.props;
---

<Person class={`guest ${cls}`} name={name} alt={alt} width={600} height={800} />
