---
/**
 * A generic, rounded, flat guest figure (SVG <g>). Feet at (x, y).
 * Not based on any real person or known character.
 */
interface Props {
  x?: number;
  y?: number;
  s?: number;
  shirt?: string;
  skin?: string;
  hair?: string;
  hairStyle?: "short" | "long" | "bun" | "bald" | "curly";
  pose?: "stand" | "phone" | "cheer" | "talk";
  glasses?: boolean;
  class?: string;
  flip?: boolean;
}
const {
  x = 0,
  y = 0,
  s = 1,
  shirt = "#614098",
  skin = "#f2c6a0",
  hair = "#3b2318",
  hairStyle = "short",
  pose = "stand",
  glasses = false,
  class: cls = "",
  flip = false,
} = Astro.props;
const INK = "#330768";
const sx = flip ? -s : s;
const eyesY = pose === "phone" ? -85 : -89;
---

<g class:list={["guest", `pose-${pose}`, cls]} transform={`translate(${x} ${y}) scale(${sx} ${s})`}>
  {hairStyle === "long" && <path d="M-24 -92 Q-28 -40 -18 -46 L18 -46 Q28 -40 24 -92 Z" fill={hair} stroke={INK} stroke-width="4" stroke-linejoin="round" />}
  {/* body */}
  <path d="M-27 0 Q-31 -48 -19 -60 Q0 -70 19 -60 Q31 -48 27 0 Z" fill={shirt} stroke={INK} stroke-width="4" stroke-linejoin="round"></path>
  {
    pose === "cheer" && (
      <g stroke={INK} stroke-width="4" stroke-linecap="round" fill={skin}>
        <path d="M-20 -54 L-36 -96" fill="none" stroke={INK} stroke-width="11" />
        <path d="M-20 -54 L-36 -96" fill="none" stroke={shirt} stroke-width="5" />
        <path d="M20 -54 L36 -96" fill="none" stroke={INK} stroke-width="11" />
        <path d="M20 -54 L36 -96" fill="none" stroke={shirt} stroke-width="5" />
        <circle cx="-37" cy="-99" r="6" />
        <circle cx="37" cy="-99" r="6" />
      </g>
    )
  }
  {
    pose === "talk" && (
      <g stroke-linecap="round">
        <path d="M18 -52 L34 -70" fill="none" stroke={INK} stroke-width="11" />
        <path d="M18 -52 L34 -70" fill="none" stroke={shirt} stroke-width="5" />
        <circle cx="36" cy="-73" r="6" fill={skin} stroke={INK} stroke-width="4" />
      </g>
    )
  }
  {/* neck + head */}
  <circle cx="0" cy="-88" r="20" fill={skin} stroke={INK} stroke-width="4"></circle>
  {hairStyle === "short" && <path d="M-21 -90 Q-23 -112 0 -112 Q23 -112 21 -90 Q13 -101 0 -99 Q-13 -101 -21 -90 Z" fill={hair} stroke={INK} stroke-width="4" stroke-linejoin="round" />}
  {hairStyle === "long" && <path d="M-22 -86 Q-25 -113 0 -113 Q25 -113 22 -86 Q18 -100 0 -101 Q-16 -100 -22 -86 Z" fill={hair} stroke={INK} stroke-width="4" stroke-linejoin="round" />}
  {
    hairStyle === "bun" && (
      <g fill={hair} stroke={INK} stroke-width="4" stroke-linejoin="round">
        <circle cx="0" cy="-114" r="10" />
        <path d="M-21 -90 Q-23 -110 0 -110 Q23 -110 21 -90 Q12 -102 0 -100 Q-12 -102 -21 -90 Z" />
      </g>
    )
  }
  {
    hairStyle === "curly" && (
      <g fill={hair} stroke={INK} stroke-width="4">
        <circle cx="-14" cy="-104" r="9" />
        <circle cx="0" cy="-110" r="10" />
        <circle cx="14" cy="-104" r="9" />
        <circle cx="-20" cy="-92" r="7" />
        <circle cx="20" cy="-92" r="7" />
      </g>
    )
  }
  {hairStyle === "bald" && <path d="M-14 -104 Q0 -110 14 -104" fill="none" stroke={INK} stroke-width="3" opacity="0.4" />}
  {/* face */}
  <g fill={INK}>
    <circle cx="-7" cy={eyesY} r="2.6"></circle>
    <circle cx="7" cy={eyesY} r="2.6"></circle>
  </g>
  {
    glasses && (
      <g fill="none" stroke={INK} stroke-width="2.5">
        <circle cx="-7" cy={eyesY} r="6" />
        <circle cx="7" cy={eyesY} r="6" />
        <path d={`M-1 ${eyesY} H1`} />
      </g>
    )
  }
  {
    pose === "phone" ? (
      <path d="M-5 -76 H5" stroke={INK} stroke-width="3" stroke-linecap="round" />
    ) : pose === "cheer" || pose === "talk" ? (
      <path d="M-8 -80 Q0 -70 8 -80 Z" fill={INK} stroke={INK} stroke-width="2" stroke-linejoin="round" />
    ) : (
      <path d="M-6 -79 Q0 -74 6 -79" fill="none" stroke={INK} stroke-width="3" stroke-linecap="round" />
    )
  }
  {
    pose === "phone" && (
      <g class="guest-phone">
        <circle class="phone-glow" cx="0" cy="-70" r="26" fill="#64D8F7" opacity="0.25" />
        <path d="M-18 -46 Q-8 -50 -4 -58" fill="none" stroke={INK} stroke-width="11" stroke-linecap="round" />
        <path d="M18 -46 Q8 -50 4 -58" fill="none" stroke={INK} stroke-width="11" stroke-linecap="round" />
        <rect x="-9" y="-70" width="18" height="26" rx="4" fill={INK} />
        <rect x="-6" y="-67" width="12" height="18" rx="2" fill="#64D8F7" />
      </g>
    )
  }
</g>
