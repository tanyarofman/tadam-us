---
/**
 * Scene 1 imagery, all photos in public/people/:
 *  - hall-crowd.webp   (16:9, full-bleed background, faces not identifiable)
 *  - bored-kids.webp   (3:2, corner; wrapper keeps the `.kids` hook scene1.ts fades in)
 * Until the files exist: stage-blue gradient with a placeholder crowd silhouette.
 */
import Person from "./Person.astro";
---

<div class="hall-art">
  <Person
    class="hall-photo"
    kind="crowd"
    name="hall-crowd"
    width={1280}
    height={720}
    eager
    alt="אולם אירועים מוצף באור כחול, אורחים מכל הגילאים עם טלפונים מוארים ומסך גדול בקצה האולם"
  />
</div>
<div class="kids-corner">
  <div class="kids">
    <Person
      class="kids-photo"
      name="bored-kids"
      width={900}
      height={600}
      alt="שלושה ילדים יושבים על כיסאות בפינת האולם ומשועממים, כל אחד מביט בטלפון שלו"
    />
  </div>
</div>

<style>
  .hall-art {
    position: absolute;
    inset: 0;
  }
  .hall-art :global(.hall-photo) {
    height: 100%;
    aspect-ratio: auto !important;
    border-radius: 0;
  }
  .hall-art :global(.person-img) {
    object-position: 50% 60%;
  }
  .kids-corner {
    position: absolute;
    inset-inline-start: clamp(8px, 2vw, 28px);
    bottom: clamp(8px, 3vh, 28px);
    width: clamp(150px, 24vw, 320px);
  }
  .kids-corner :global(.kids-photo) {
    border-radius: var(--radius-m);
    box-shadow: 0 0 30px 2px var(--screen-glow), 0 0 0 3px var(--stage-navy);
  }
</style>
