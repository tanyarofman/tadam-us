---
/** The opening photograph shares the exact frame used by the logo reveal and video. */
import Person from "./Person.astro";
import { useCopy } from "../../content/copy";
const { copy } = useCopy(Astro.url);
---

<div class="hall-art">
  <Person
    class="hall-photo"
    kind="crowd"
    name="event-dinner-phones"
    width={1600}
    height={900}
    eager
    alt={copy.scene1.photoAlt}
  />
</div>

<style>
  .hall-art {
    width: 100%;
    height: 100%;
    border-radius: inherit;
  }
  .hall-art :global(.hall-photo) {
    height: 100%;
    aspect-ratio: auto !important;
    border-radius: inherit;
  }
  .hall-art :global(.person-img) {
    object-position: 50% 60%;
  }
</style>
