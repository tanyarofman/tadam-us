---
/**
 * Scene 6 winner (matches "סבתא רחל" on the leaderboard). Photo: public/people/grandma-winning.webp.
 * variant "celebrant" uses public/people/celebrant-stage.webp (laughing celebrant with mic and tiara).
 * Scene 6 toggles `.is-laughing` on the parent `.kid-wrap`; the photo gets a small bounce from that.
 */
import Person from "./Person.astro";
interface Props {
  variant?: "grandma" | "celebrant";
}
const { variant = "grandma" } = Astro.props;
const v =
  variant === "celebrant"
    ? { name: "celebrant-stage", w: 600, h: 800, alt: "נערה צוחקת על במה עם מיקרופון ועטרה קטנה, קונפטי באוויר" }
    : { name: "grandma-winning", w: 640, h: 640, alt: "סבתא צוחקת על במה עם מיקרופון, כתר זהב קטן ואגרוף מורם בניצחון, קונפטי סביבה" };
---

<div class="kid">
  <Person class="kid-photo" name={v.name} alt={v.alt} width={v.w} height={v.h} />
</div>

<style>
  .kid {
    width: 100%;
    border-radius: var(--radius-l);
    box-shadow: 0 0 50px 4px var(--screen-glow), 0 0 0 4px var(--stage-navy);
    overflow: hidden;
  }
  :global(.is-laughing) .kid {
    animation: bounce 0.45s ease-in-out infinite alternate;
  }
  @keyframes bounce {
    from {
      transform: rotate(-1.2deg);
    }
    to {
      transform: rotate(1.2deg) translateY(-3px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.is-laughing) .kid {
      animation: none;
    }
  }
</style>
