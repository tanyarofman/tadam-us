---
/**
 * Scene 6 winner (matches "סבתא רחל" on the leaderboard). Photo: public/people/grandma-winning.webp.
 * variant "celebrant" uses public/people/celebrant-stage.webp (laughing celebrant with mic and tiara).
 * Scene 6 toggles `.is-laughing` on the parent `.kid-wrap` at the reveal. That turns the still into a
 * "living photo" in pure CSS: she hops and the photo pulses on a beat, stage lights sweep, a shine passes,
 * confetti falls in front of her and sparkles twinkle. No video, a few KB, compositor-only transforms.
 */
import Person from "./Person.astro";
interface Props {
  variant?: "grandma" | "celebrant";
}
const { variant = "grandma" } = Astro.props;
// confetti pieces falling in front of the photo: [left %, delay s, duration s, color, size px, drift px]
const BITS: [number, number, number, string, number, number][] = [
  [6, 0, 2.6, "#ffe600", 9, 14], [18, 1.1, 3.1, "#ffffff", 7, -10], [29, 0.4, 2.4, "#e836a1", 8, 12],
  [41, 1.7, 2.9, "#64d8f7", 7, -14], [52, 0.8, 2.5, "#ffe600", 10, 10], [63, 2.1, 3.2, "#e74138", 7, -8],
  [74, 0.2, 2.7, "#ffffff", 8, 16], [85, 1.4, 2.4, "#e836a1", 9, -12], [94, 0.6, 3, "#ffe600", 7, -16],
  [12, 2.4, 2.8, "#64d8f7", 8, 10], [58, 2.8, 2.6, "#ffffff", 6, -10], [36, 3.2, 3.1, "#ffe600", 8, 8],
];
const SPARKS: [number, number, number][] = [[14, 18, 0], [82, 14, 0.7], [70, 46, 1.3], [22, 58, 0.4], [90, 70, 1.8]];
const v =
  variant === "celebrant"
    ? { name: "celebrant-stage", w: 600, h: 800, alt: "נערה צוחקת על במה עם מיקרופון ועטרה קטנה, קונפטי באוויר" }
    : { name: "grandma-winning", w: 640, h: 640, alt: "סבתא צוחקת על במה עם מיקרופון, כתר זהב קטן ואגרוף מורם בניצחון, קונפטי סביבה" };
---

<div class="kid">
  <Person class="kid-photo" name={v.name} alt={v.alt} width={v.w} height={v.h} />
  <span class="kid-fx" aria-hidden="true">
    <span class="kid-beam kid-beam--l"></span>
    <span class="kid-beam kid-beam--r"></span>
    <span class="kid-shine"></span>
    {
      SPARKS.map(([x, y, d]) => (
        <svg class="kid-spark" viewBox="0 0 20 20" style={`left:${x}%;top:${y}%;animation-delay:${d}s`}>
          <path d="M10 0 Q11.5 8.5 20 10 Q11.5 11.5 10 20 Q8.5 11.5 0 10 Q8.5 8.5 10 0Z" />
        </svg>
      ))
    }
    {
      BITS.map(([x, d, t, c, sz, dx]) => (
        <span
          class="kid-bit"
          style={`left:${x}%;--c:${c};--s:${sz}px;--dx:${dx}px;animation-delay:${d}s;animation-duration:${t}s`}
        />
      ))
    }
  </span>
</div>

<style>
  .kid {
    position: relative;
    width: 100%;
    border-radius: var(--radius-l);
    box-shadow: 0 0 50px 4px var(--screen-glow), 0 0 0 4px var(--stage-navy);
    overflow: hidden;
    transform-origin: 50% 100%;
  }
  .kid-fx {
    position: absolute;
    inset: 0;
    container-type: size;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s;
  }
  .kid-beam {
    position: absolute;
    top: -30%;
    width: 46%;
    height: 150%;
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0.38), rgba(100, 216, 247, 0.12) 55%, transparent 80%);
    clip-path: polygon(42% 0, 58% 0, 100% 100%, 0 100%);
    mix-blend-mode: screen;
    transform-origin: 50% 0;
  }
  .kid-beam--l {
    left: 0;
    --from: -24deg;
    --to: 10deg;
  }
  .kid-beam--r {
    right: 0;
    --from: 24deg;
    --to: -10deg;
    animation-delay: -1.3s !important;
  }
  .kid-shine {
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 35%, rgba(255, 255, 255, 0.4) 50%, transparent 65%);
    transform: translateX(-120%);
  }
  .kid-spark {
    position: absolute;
    width: clamp(9px, 7%, 16px);
    translate: -50% -50%;
    fill: #fff;
    filter: drop-shadow(0 0 4px rgba(255, 230, 0, 0.9));
    transform: scale(0);
  }
  .kid-bit {
    position: absolute;
    top: -6%;
    width: var(--s);
    height: calc(var(--s) * 0.6);
    background: var(--c);
    border-radius: 2px;
    opacity: 0;
  }

  /* ---------- the living photo (on at the reveal) ---------- */
  :global(.is-laughing) .kid {
    animation: hop 0.9s cubic-bezier(0.3, 0, 0.3, 1) infinite;
  }
  :global(.is-laughing) .kid :global(.person-img) {
    animation: pulse 0.9s ease-out infinite;
  }
  :global(.is-laughing) .kid-fx {
    opacity: 1;
  }
  :global(.is-laughing) .kid-beam {
    animation: beam 2.6s ease-in-out infinite alternate;
  }
  :global(.is-laughing) .kid-shine {
    animation: shine 3.6s ease-in-out 0.3s infinite;
  }
  :global(.is-laughing) .kid-spark {
    animation: spark 2.2s ease-in-out infinite;
  }
  :global(.is-laughing) .kid-bit {
    animation-name: fall;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }
  /* scrolled away: everything pauses (set by scene6.ts) */
  :global(.is-offscreen) .kid,
  :global(.is-offscreen) .kid * {
    animation-play-state: paused !important;
  }

  /* a cheering hop with a little lean, on a ~67 bpm beat */
  @keyframes hop {
    0%,
    100% {
      transform: translateY(0) rotate(0);
    }
    18% {
      transform: translateY(-7px) rotate(-1.6deg);
    }
    40% {
      transform: translateY(0) rotate(0.4deg);
    }
    62% {
      transform: translateY(-3px) rotate(1.2deg);
    }
  }
  /* the photo punches in on the beat, like a camera push */
  @keyframes pulse {
    0%,
    100% {
      transform: scale(1.04);
    }
    15% {
      transform: scale(1.09) translateY(-1.5%);
    }
    55% {
      transform: scale(1.05);
    }
  }
  @keyframes beam {
    from {
      transform: rotate(var(--from));
      opacity: 0.5;
    }
    to {
      transform: rotate(var(--to));
      opacity: 1;
    }
  }
  @keyframes shine {
    0% {
      transform: translateX(-120%);
    }
    40%,
    100% {
      transform: translateX(120%);
    }
  }
  @keyframes spark {
    0%,
    100% {
      transform: scale(0) rotate(0);
    }
    30% {
      transform: scale(1) rotate(45deg);
    }
    55% {
      transform: scale(0) rotate(90deg);
    }
  }
  @keyframes fall {
    0% {
      opacity: 0;
      transform: translate(0, 0) rotate(0) rotateX(0);
    }
    10% {
      opacity: 1;
    }
    85% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translate(var(--dx), 110cqh) rotate(540deg) rotateX(720deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.is-laughing) .kid,
    :global(.is-laughing) .kid * {
      animation: none !important;
    }
  }
</style>
