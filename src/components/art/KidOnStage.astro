---
/** Illustrated kid (fictional "נועה") laughing on stage with a mic. Not a photo. */
const INK = "#330768";
---

<svg class="kid-svg" viewBox="0 0 300 300" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id="kid-spot" cx="50%" cy="100%" r="70%">
      <stop offset="0" stop-color="#F7D94A" stop-opacity="0.55"></stop>
      <stop offset="1" stop-color="#F7D94A" stop-opacity="0"></stop>
    </radialGradient>
  </defs>
  <ellipse cx="150" cy="270" rx="130" ry="30" fill="url(#kid-spot)"></ellipse>
  <rect x="30" y="262" width="240" height="26" rx="10" fill="#614098" stroke={INK} stroke-width="6"></rect>
  <g class="kid">
    <!-- hair back -->
    <path d="M100 96 Q92 180 108 196 L192 196 Q208 180 200 96 Z" fill="#7a3d1c" stroke={INK} stroke-width="6" stroke-linejoin="round"></path>
    <!-- dress -->
    <path d="M104 262 Q96 200 120 180 Q150 166 180 180 Q204 200 196 262 Z" fill="#E836A1" stroke={INK} stroke-width="6" stroke-linejoin="round"></path>
    <path d="M118 210 Q150 222 182 210" fill="none" stroke="#F7D94A" stroke-width="6" stroke-linecap="round"></path>
    <!-- arm with mic -->
    <path d="M182 196 Q214 190 214 152" fill="none" stroke={INK} stroke-width="20" stroke-linecap="round"></path>
    <path d="M182 196 Q214 190 214 152" fill="none" stroke="#E836A1" stroke-width="10" stroke-linecap="round"></path>
    <circle cx="214" cy="146" r="11" fill="#f2c6a0" stroke={INK} stroke-width="5"></circle>
    <rect x="207" y="104" width="16" height="36" rx="8" fill="#E74138" stroke={INK} stroke-width="5" transform="rotate(14 215 122)"></rect>
    <!-- other arm, laughing -->
    <path d="M118 196 Q88 186 92 160" fill="none" stroke={INK} stroke-width="20" stroke-linecap="round"></path>
    <path d="M118 196 Q88 186 92 160" fill="none" stroke="#E836A1" stroke-width="10" stroke-linecap="round"></path>
    <circle cx="92" cy="154" r="11" fill="#f2c6a0" stroke={INK} stroke-width="5"></circle>
    <!-- head -->
    <g class="kid-head">
      <circle cx="150" cy="118" r="44" fill="#f2c6a0" stroke={INK} stroke-width="6"></circle>
      <path d="M106 112 Q104 70 150 68 Q196 70 194 112 Q178 88 150 90 Q122 88 106 112 Z" fill="#7a3d1c" stroke={INK} stroke-width="6" stroke-linejoin="round"></path>
      <!-- happy closed eyes -->
      <path d="M126 116 Q134 106 142 116" fill="none" stroke={INK} stroke-width="5" stroke-linecap="round"></path>
      <path d="M158 116 Q166 106 174 116" fill="none" stroke={INK} stroke-width="5" stroke-linecap="round"></path>
      <!-- big laugh -->
      <path d="M130 132 Q150 160 170 132 Z" fill={INK} stroke={INK} stroke-width="4" stroke-linejoin="round"></path>
      <path d="M140 146 Q150 154 160 146" fill="#E74138"></path>
      <circle cx="122" cy="132" r="7" fill="#E836A1" opacity="0.4"></circle>
      <circle cx="178" cy="132" r="7" fill="#E836A1" opacity="0.4"></circle>
      <!-- tiara -->
      <path d="M128 72 L136 56 L150 68 L164 56 L172 72 Z" fill="#F7D94A" stroke={INK} stroke-width="4" stroke-linejoin="round"></path>
    </g>
  </g>
  <g class="kid-ha" fill="#fff" font-family="Fredoka, Rubik, sans-serif" font-weight="700" stroke={INK} stroke-width="3" paint-order="stroke">
    <text x="236" y="70" font-size="26">חה</text>
    <text x="30" y="96" font-size="22">חה!</text>
  </g>
</svg>

<style>
  .kid-svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .kid-head {
    transform-box: fill-box;
    transform-origin: 50% 90%;
  }
  :global(.is-laughing) .kid-head {
    animation: laugh 0.35s ease-in-out infinite alternate;
  }
  :global(.is-laughing) .kid-ha {
    animation: ha 0.7s ease-in-out infinite alternate;
  }
  @keyframes laugh {
    from {
      transform: rotate(-4deg);
    }
    to {
      transform: rotate(4deg) translateY(-3px);
    }
  }
  @keyframes ha {
    to {
      transform: translateY(-6px);
      opacity: 0.6;
    }
  }
</style>
