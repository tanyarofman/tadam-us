---
/** Slim header for blog pages: logo home, link to the blog index, demo CTA. */
import { useCopy, localPath } from "../../content/copy";
const { copy, locale, home } = useCopy(Astro.url);
const b = copy.blog;
---

<header class="blog-header">
  <div class="container blog-header-inner">
    <a href={home} class="blog-header-logo" aria-label={b.headerHome}>
      <img src="/brand/tadam-logo-en.webp" alt={copy.brand} width="1000" height="394" />
    </a>
    <nav class="blog-header-nav" aria-label={b.headerNav}>
      <a href={localPath(locale, "/blog/")}>{b.headerBlog}</a>
      <a class="btn btn-buzzer blog-header-cta" href={`${home}#demo`} data-track="blog_demo_click" data-source="blog-header">{b.headerDemo}</a>
    </nav>
  </div>
</header>

<style>
  .blog-header {
    padding-block: 16px;
    border-bottom: 2px solid var(--surface-border);
  }
  .blog-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .blog-header-logo img {
    width: 110px;
  }
  .blog-header-nav {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .blog-header-nav > a:not(.btn) {
    color: var(--text-muted);
    text-underline-offset: 5px;
  }
  .blog-header-cta {
    min-height: 44px;
    padding: 6px 22px 8px;
    font-size: 1.15rem;
  }
</style>
