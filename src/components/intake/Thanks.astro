---
/**
 * Where Morning sends the customer after a successful payment (PAID_URL in src/config/pricing.ts).
 * Shows the order number saved by /start in this browser, clears the draft so a new order starts clean,
 * and offers blog articles about other kinds of events (never the event that was just ordered).
 */
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { INTAKE as HE } from "../../content/intake.he";
import { INTAKE as EN } from "../../content/intake.en";
import { contactLink } from "../../config/site";

interface Props {
  lang?: "he" | "en";
}
const { lang = "he" } = Astro.props;
const c = lang === "en" ? EN : HE;
const t = c.thanks;

/** Article slug → the /start event ids it is about (an article is hidden when the order was for one of them). */
const IDEAS: Record<string, string[]> = {
  "bar-mitzvah-attractions": ["bar-bat"],
  "bachelorette-party-games": ["bachelor"],
  "team-building-day-ideas": ["teambuilding"],
  "office-holiday-toast": ["toast"],
  "pass-the-parcel-tasks": ["birthday", "round-birthday"],
  "icebreaker-questions": [],
  "new-years-eve-at-home": [],
};
// The blog is in Hebrew only, so the English page has no article suggestions.
const posts = lang === "he" ? await getCollection("blog", (p) => !p.data.draft) : [];
const ideas = Object.entries(IDEAS).flatMap(([slug, events]) => {
  const post = posts.find((p) => p.id === slug);
  return post ? [{ slug, events: events.join(" "), title: post.data.seoTitle ?? post.data.title, category: post.data.category }] : [];
});
const confetti = Array.from({ length: 18 }, (_, i) => i);
---

<Base title={t.metaTitle} description={t.lead} noindex lang={c.ui.lang} dir={c.ui.dir as "rtl" | "ltr"} locale={c.ui.locale}>
  <div class="confetti" aria-hidden="true">
    {confetti.map((i) => <i style={`--x:${(i * 53) % 100}%;--d:${(i % 6) * 0.35}s;--h:${[52, 320, 190, 0][i % 4]};--r:${(i % 5) * 40}deg`} />)}
  </div>
  <main class:list={["thanks", { "thanks--solo": ideas.length === 0 }]} data-lang={lang}>
    <a href="/" class="thanks__logo" aria-label={c.ui.home}>
      <img src="/brand/tadam-logo-nobuzzer.webp" alt={c.ui.brand} width="1438" height="622" />
    </a>

    <div class="thanks__main">
      <h1 class="display h-scene">{t.title}</h1>
      <p class="lead">{t.lead}</p>
      <ol class="thanks__next">
        {t.next.map((x) => <li><strong>{x.t}</strong><span>{x.d}</span></li>)}
      </ol>
      <a class="btn btn-buzzer" href="/">{t.home}</a>
      <p class="thanks__foot">
        <a href={contactLink("order-thanks")} target="_blank" rel="noopener">{t.contact}</a>
        <span data-order-box hidden>{t.orderNo}: <span dir="ltr" data-order-id></span></span>
      </p>
    </div>

    {ideas.length > 0 && (
      <aside class="thanks__ideas" aria-labelledby="ideas-title">
        <h2 id="ideas-title">{t.ideasTitle}</h2>
        <ul>
          {
            ideas.map((p) => (
              <li data-idea data-events={p.events}>
                <a href={`/blog/${p.slug}/`}>
                  <span class="thanks__cat">{p.category}</span>
                  <strong>{p.title}</strong>
                </a>
              </li>
            ))
          }
        </ul>
        <a class="thanks__all" href="/blog/">{t.ideasAll}</a>
      </aside>
    )}
  </main>
  <script>
    import { track } from "../../lib/analytics";
    let order: { id?: string; event?: string } = {};
    try {
      order = JSON.parse(localStorage.getItem("tadam-order") || "{}");
      const lang = document.querySelector<HTMLElement>("main.thanks")?.dataset.lang;
      if (order.id) localStorage.removeItem(lang === "en" ? "tadam-intake-v1-en" : "tadam-intake-v1");
    } catch {
      /* blocked storage: the page still confirms the payment */
    }
    const box = document.querySelector<HTMLElement>("[data-order-box]");
    const el = document.querySelector<HTMLElement>("[data-order-id]");
    if (order.id && box && el) {
      el.textContent = order.id;
      box.hidden = false;
    }
    // three articles, never one about the event that was just ordered
    let shown = 0;
    document.querySelectorAll<HTMLElement>("[data-idea]").forEach((li) => {
      const same = !!order.event && (li.dataset.events || "").split(" ").includes(order.event);
      li.hidden = same || shown >= 3;
      if (!li.hidden) shown += 1;
    });
    track("order_paid", { order: order.id || "" });
  </script>
</Base>

<style>
  [hidden] {
    display: none !important;
  }
  /* Same feel as the home page hero: a big headline with air around it, the extras quietly on the side. */
  .thanks {
    position: relative;
    max-width: 1180px;
    min-height: 100svh;
    margin-inline: auto;
    padding: clamp(14px, 3vh, 32px) var(--gutter) clamp(18px, 5vh, 56px);
    display: grid;
    grid-template-rows: auto 1fr;
    gap: clamp(16px, 4vh, 40px);
  }
  .thanks__logo {
    justify-self: start;
  }
  .thanks__logo img {
    width: clamp(88px, 12vh, 124px);
    height: auto;
  }
  .thanks__main {
    align-self: center;
    display: grid;
    gap: clamp(12px, 2.6vh, 24px);
    justify-items: start;
  }
  .thanks h1 {
    margin: 0;
    font-size: clamp(2.2rem, 9vh, 4.6rem);
    line-height: 1.05;
  }
  .thanks .lead {
    margin: 0;
  }
  .thanks__next {
    list-style: none;
    counter-reset: n;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(8px, 1.8vh, 16px);
  }
  .thanks__next li {
    counter-increment: n;
    display: grid;
    grid-template-columns: 32px 1fr;
    column-gap: 14px;
    align-items: center;
  }
  .thanks__next li::before {
    content: counter(n);
    grid-row: 1 / span 2;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--game-yellow);
    color: var(--stage-navy);
    font-weight: 700;
  }
  .thanks__next strong {
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.2;
  }
  .thanks__next span {
    color: var(--text-muted);
    line-height: 1.3;
  }
  .thanks__foot {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .thanks__foot a,
  .thanks__all {
    color: #fff;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--game-yellow);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }
  .thanks__ideas {
    align-self: center;
    display: grid;
    gap: 12px;
    justify-items: start;
  }
  .thanks__ideas h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--text-muted);
    font-weight: 700;
  }
  .thanks__ideas ul {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    display: grid;
  }
  .thanks__ideas li a {
    display: grid;
    gap: 2px;
    padding: clamp(8px, 1.8vh, 16px) 0;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    color: #fff;
    text-decoration: none;
    line-height: 1.3;
    transition: padding 0.2s var(--ease-out), color 0.2s;
  }
  .thanks__ideas li a:hover {
    color: var(--game-yellow);
    padding-inline-start: 8px;
  }
  .thanks__ideas li strong {
    font-family: var(--font-display);
    font-size: 1.2rem;
  }
  .thanks__cat {
    font-size: 0.85rem;
    color: var(--game-yellow);
    font-weight: 700;
  }
  .confetti {
    position: fixed;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .confetti i {
    position: absolute;
    top: -20px;
    left: var(--x);
    width: 10px;
    height: 16px;
    border-radius: 2px;
    background: hsl(var(--h) 100% 60%);
    animation: fall 3.2s var(--d) ease-in both;
  }
  @keyframes fall {
    to {
      transform: translateY(110vh) rotate(calc(var(--r) + 540deg));
      opacity: 0.2;
    }
  }
  @media (min-width: 800px) {
    .thanks--solo {
      grid-template-columns: minmax(0, 1fr) !important;
      max-width: 820px;
    }
    .thanks {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      column-gap: clamp(32px, 6vw, 96px);
    }
    .thanks__logo {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 799px) {
    .thanks {
      grid-template-rows: auto auto auto;
    }
    .thanks h1 {
      font-size: clamp(2rem, 9.5vw, 2.5rem);
    }
    .thanks {
      gap: 14px;
      padding-bottom: 14px;
    }
    /* phone: two articles keep it to one screen */
    .thanks__ideas li:nth-of-type(n + 3) {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .confetti {
      display: none;
    }
  }
</style>
