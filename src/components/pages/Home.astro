---
/** The whole landing page, rendered at `/`. */
import Base from "../../layouts/Base.astro";
import Scene0Hero from "../scenes/Scene0Hero.astro";
import EventsStrip from "../EventsStrip.astro";
import Scene3Reveal from "../scenes/Scene3Reveal.astro";
import Scene4HowItWorks from "../scenes/Scene4HowItWorks.astro";
import Scene6Payoff from "../scenes/Scene6Payoff.astro";
import Pricing from "../Pricing.astro";
import Hosts from "../Hosts.astro";
import LiveDemos from "../LiveDemos.astro";
import Testimonials from "../Testimonials.astro";
import Scene7Cta from "../scenes/Scene7Cta.astro";
import Faq from "../Faq.astro";
import Footer from "../Footer.astro";
import ClosingCta from "../ClosingCta.astro";
import DemoModal from "../DemoModal.astro";
import Preloader from "../Preloader.astro";
import { useCopy } from "../../content/copy";
import { SITE, demoMedia } from "../../config/site";
import { PACKAGES, PRICING, fillPrices } from "../../config/pricing";
import { REVIEW_SCALE, summarizeReviews } from "../../lib/reviews";

const { copy: COPY, locale, langTag } = useCopy(Astro.url);
const media = demoMedia(locale);
const home = new URL("/", Astro.site).href;
const page = new URL(Astro.url.pathname, Astro.site).href;
const faqItems = COPY.faq.items.map((f) => ({ q: f.q, a: fillPrices(f.a) }));
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${home}#org`,
    name: COPY.brand,
    alternateName: "Tadam",
    url: home,
    logo: new URL("/favicon-512.png", Astro.site).href,
    email: SITE.email,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: COPY.brand,
    alternateName: "Tadam",
    url: page,
    inLanguage: langTag,
    publisher: { "@id": `${home}#org` },
  },
  {
    "@context": "https://schema.org",
    "@type": "Game",
    "@id": `${home}#game`,
    name: "Tadam! Personalized Trivia Game Show",
    genre: "Trivia",
    description: COPY.meta.description,
    publisher: { "@id": `${home}#org` },
    inLanguage: langTag,
    image: new URL(media.heroScreenPoster, Astro.site).href,
    url: home,
    // These customers reviewed the Tadam trivia game. Game is a Google-supported
    // review type; the visible cards and summary use the same submitted data.
    aggregateRating: { "@type": "AggregateRating", ...summarizeReviews(COPY.testimonials.items) },
    review: COPY.testimonials.items.map((person) => ({
      "@type": "Review",
      "@id": `${home}#testimonial-${person.id}`,
      url: `${home}#testimonial-${person.id}`,
      author: {
        "@type": "Person",
        name: person.name,
        image: new URL(person.image, Astro.site).href,
      },
      reviewBody: person.quote,
      // Optional review dates are omitted to match the date-free cards.
      reviewRating: { "@type": "Rating", ratingValue: person.rating, ...REVIEW_SCALE },
      inLanguage: langTag,
    })),
    offers: PACKAGES.map((tier) => ({
      "@type": "Offer",
      name: tier.name,
      price: tier.price,
      priceCurrency: PRICING.currencyCode,
      url: new URL("/#pricing", Astro.site).href,
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];
---

<Base>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <link slot="head" rel="preload" as="image" type="image/jpeg" href={media.heroScreenPoster} />
  <link slot="head" rel="preload" as="image" type="image/jpeg" href={media.heroPhonePoster} />
  <Preloader />
  <a class="skip-link" href="#scene-3">{COPY.nav.skip}</a>
  <div class="scroll-progress" aria-hidden="true"><div class="scroll-progress__bar"></div></div>

  <main id="main">
    <Scene0Hero />
    <EventsStrip />
    <LiveDemos />
    <Scene3Reveal />
    <Scene4HowItWorks />
    <Scene6Payoff />
    <Hosts />
    <Pricing />
    <Scene7Cta />
    <Faq />
    <Testimonials />
    <ClosingCta />
  </main>
  <Footer />
  <DemoModal />


  <script>
    import "../../scripts/main";
  </script>
</Base>
