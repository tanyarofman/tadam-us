---
/**
 * Scene 0: the hero (concept 4, chosen 2026-11-17).
 * A top bar (logo, links, contact) + the headline on the right and a TV on the left playing a short muted loop
 * of a real game. The preloader logo flies into the logo in the top bar (see scripts/hero.ts, [data-logo]).
 */
import { COPY } from "../../content/copy.he";
import { whatsappLink } from "../../config/site";
import LogoAssemble from "../LogoAssemble.astro";
import SplitHeading from "../SplitHeading.astro";
import StageBackdrop from "../StageBackdrop.astro";
const c = COPY.hero;
const d = COPY.scene3.demo;
const wa = whatsappLink();
---

<section class="scene hero intro-pending" id="top" data-scene="hero" aria-labelledby="hero-title">
  <StageBackdrop floorOnly />
  <div class="hero-burst" aria-hidden="true"></div>
  <div class="hero-loading sr-only" role="status" aria-live="polite">{c.loading}</div>

  <header class="hero-bar container hero-wide">
    <a href="#top" class="hero-home" aria-label="טדאם!">
      <LogoAssemble class="hero-logo" />
    </a>
    <nav class="hero-nav" aria-label={c.navLabel} data-hero-fade>
      <ul role="list">
        {c.nav.map((l) => <li><a href={l.href} data-scroll-to={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <a class="btn hero-bar-cta" href={wa} target="_blank" rel="noopener" data-track="cta_whatsapp_click" data-source="hero-nav" data-hero-fade>
      {c.navCta}
    </a>
  </header>

  <div class="hero-inner container hero-wide">
    <div class="hero-copy">
      <SplitHeading as="h1" id="hero-title" class="h-hero hero-title" text={c.headline} highlight="יזכרו" breakAfter={3} />
      <p class="lead hero-sub" data-hero-fade>{c.sub}</p>
      <div class="hero-ctas" data-hero-fade>
        <a class="btn btn-buzzer" href={wa} target="_blank" rel="noopener" data-track="cta_whatsapp_click" data-source="hero">
          <span class="btn-dot" aria-hidden="true"></span>
          {c.ctaPrimary}
        </a>
        <a class="btn btn-ghost" href="#scene-3" data-scroll-to="#scene-3" data-scroll-offset="2.55" data-track="cta_how_it_works_click">
          {c.ctaSecondary}
        </a>
      </div>
    </div>

    <figure class="hero-tv">
      <div class="hero-tv-screen" data-state="loop">
        <video
          class="hero-loop"
          src="/demo/tadam-hero-loop.mp4"
          poster="/demo/tadam-hero-loop-poster.webp"
          width="960"
          height="540"
          muted
          loop
          playsinline
          autoplay
          preload="auto"
          aria-label={c.loopLabel}></video>
        <div class="hero-tv-bar">
          <button type="button" class="tv-btn" data-act="sound" aria-label={d.unmute} aria-pressed="false" data-on={d.mute} data-off={d.unmute}>
            <svg class="i-off" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9zm12.5 1.4L18 12l-1.5 1.6 1 1 1.5-1.6 1.6 1.6 1-1-1.6-1.6L22 10.4l-1-1-1.5 1.6-1.6-1.6z" fill="currentColor"></path></svg>
            <svg class="i-on" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9zm11.5 3a4 4 0 0 0-2-3.5v7a4 4 0 0 0 2-3.5zM14 3.2v2.1a7 7 0 0 1 0 13.4v2.1a9 9 0 0 0 0-17.6z" fill="currentColor"></path></svg>
            <span class="tv-btn-text">{d.unmute}</span>
          </button>
          <button type="button" class="tv-btn" data-act="fs" aria-label={d.fullscreen}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5h5v2H7v3H5zm9 0h5v5h-2V7h-3zM5 14h2v3h3v2H5zm12 0h2v5h-5v-2h3z" fill="currentColor"></path></svg>
            <span class="tv-btn-text">{d.fullscreen}</span>
          </button>
        </div>
      </div>
      <figcaption>{c.loopCaption}</figcaption>
    </figure>
  </div>
</section>

<script>
  /**
   * The hero TV. A short muted loop plays from the moment the page loads.
   * Sound or full screen switches it to the full recording, from the same moment, with sound
   * (like the full video in scene 3). When the full recording ends, the silent loop comes back.
   */
  type FsVideo = HTMLVideoElement & { webkitEnterFullscreen?: () => void };
  const v = document.querySelector<FsVideo>(".hero-loop");
  const screen = document.querySelector<HTMLElement>(".hero-tv-screen");
  if (v && screen) {
    const LOOP_SRC = v.currentSrc || v.getAttribute("src")!;
    const FULL_SRC = "/demo/tadam-demo.mp4";
    const LOOP_START = 16; // where the loop starts inside the full recording (seconds)
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const soundBtn = screen.querySelector<HTMLButtonElement>("[data-act='sound']")!;
    const soundText = soundBtn.querySelector<HTMLElement>(".tv-btn-text")!;
    let full = false;

    const syncSound = () => {
      const on = !v.muted;
      soundBtn.setAttribute("aria-pressed", String(on));
      const label = (on ? soundBtn.dataset.on : soundBtn.dataset.off)!;
      soundBtn.setAttribute("aria-label", label);
      soundText.textContent = label;
      screen.dataset.sound = on ? "on" : "off";
    };
    const goFull = () => {
      if (full) return;
      full = true;
      const t = LOOP_START + (v.currentTime || 0);
      v.loop = false;
      v.src = FULL_SRC;
      v.addEventListener("loadedmetadata", () => (v.currentTime = t), { once: true });
      screen.dataset.state = "full";
    };
    const backToLoop = () => {
      full = false;
      v.muted = true;
      v.loop = true;
      v.src = LOOP_SRC;
      screen.dataset.state = "loop";
      if (!reduced) v.play().catch(() => {});
    };

    soundBtn.addEventListener("click", () => {
      if (v.muted) {
        goFull();
        v.muted = false;
        v.play().catch(() => {});
      } else {
        v.muted = true;
      }
    });
    screen.querySelector("[data-act='fs']")!.addEventListener("click", () => {
      goFull();
      v.muted = false;
      v.play().catch(() => {});
      if (v.requestFullscreen) v.requestFullscreen().catch(() => {});
      else v.webkitEnterFullscreen?.(); // iPhone Safari
    });
    v.addEventListener("volumechange", syncSound);
    v.addEventListener("ended", () => full && backToLoop());

    if (reduced) {
      v.removeAttribute("autoplay");
      v.pause();
    } else {
      v.play().catch(() => {}); // start right away, even while the opening animation plays
      if ("IntersectionObserver" in window) {
        // off screen: pause; back on screen: resume (with sound only if the visitor turned it on)
        new IntersectionObserver(([e]) => (e.isIntersecting ? v.play().catch(() => {}) : v.pause())).observe(v);
      }
    }
    syncSound();
  }
</script>

<style>
  .hero {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    padding-bottom: clamp(70px, 12vh, 130px); /* clear the glowing floor strip */
    overflow: hidden;
  }

  /* the hero runs wider than the rest of the page, so the TV and the headline can be big */
  .hero-wide {
    --max-w: 1480px;
  }

  /* ---- top bar ---- */
  .hero-bar {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: clamp(14px, 2.4vh, 24px);
  }
  .hero-home {
    display: block;
    line-height: 0;
  }
  :global(.logo-assemble.hero-logo) {
    width: clamp(118px, 12vw, 172px);
  }
  .hero-nav ul {
    display: flex;
    gap: clamp(18px, 3vw, 44px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hero-nav a {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--white);
    text-decoration: none;
  }
  .hero-nav a:hover {
    color: var(--game-yellow);
  }
  .hero-bar-cta {
    min-height: 46px;
    padding: 8px 24px 10px;
    font-size: 1.15rem;
  }
  @media (max-width: 900px) {
    .hero-nav {
      display: none;
    }
  }

  /* ---- copy + TV ---- */
  .hero-inner {
    position: relative;
    z-index: 2;
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.25fr);
    align-items: center;
    gap: clamp(28px, 4vw, 64px);
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(14px, 2.4vh, 24px);
  }
  :global(.hero-title) {
    font-size: clamp(2.8rem, 5.2vw, 6rem);
    line-height: 1.05;
    text-shadow: 0 4px 0 var(--purple-ink);
  }
  .hero-sub {
    max-width: 46ch;
    font-size: clamp(1.15rem, 1.5vw, 1.45rem);
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 22px;
    margin-top: 4px;
  }

  .hero-tv {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }
  .hero-tv-screen {
    position: relative;
    width: 100%;
    border: 12px solid #0b0f24;
    border-radius: 18px;
    overflow: hidden;
    line-height: 0;
    background: #0b0f24;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.08),
      0 0 80px 6px var(--screen-glow),
      0 30px 60px rgba(0, 0, 20, 0.45);
  }
  .hero-loop {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
  }
  /* sound + full screen, bottom of the TV */
  .hero-tv-bar {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    display: flex;
    gap: 8px;
    padding: 10px 12px;
    background: linear-gradient(to top, rgba(2, 11, 46, 0.8), transparent);
    line-height: 1.2;
  }
  .tv-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    min-width: 44px;
    padding: 0 14px;
    border-radius: 999px;
    border: 2px solid rgba(255, 255, 255, 0.85);
    background: rgba(2, 11, 46, 0.7);
    color: #fff;
    font: inherit;
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .tv-btn:hover {
    background: var(--game-yellow);
    border-color: var(--game-yellow);
    color: var(--purple-ink);
  }
  .tv-btn svg {
    width: 22px;
    height: 22px;
  }
  /* the sound button is the yellow call to action until the sound is on */
  .hero-tv-screen[data-sound="off"] [data-act="sound"] {
    background: var(--game-yellow);
    border-color: var(--game-yellow);
    color: var(--purple-ink);
  }
  .tv-btn .i-on,
  .hero-tv-screen[data-sound="on"] .tv-btn .i-off {
    display: none;
  }
  .hero-tv-screen[data-sound="on"] .tv-btn .i-on {
    display: block;
  }
  @media (max-width: 480px) {
    .tv-btn {
      min-height: 40px;
      padding: 0 10px;
      font-size: 0.9rem;
    }
    .tv-btn svg {
      width: 18px;
      height: 18px;
    }
  }
  .hero-tv figcaption {
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  /* phones and tablets: stacked, centered, the TV under the buttons */
  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: minmax(0, 1fr);
      padding-top: clamp(8px, 3vh, 28px);
      text-align: center;
    }
    .hero-copy {
      align-items: center;
    }
    :global(.hero-title) {
      font-size: clamp(2.4rem, 10.5vw, 4rem);
    }
    :global(.hero-title .split-br) {
      display: none;
    }
    .hero-ctas {
      justify-content: center;
    }
    .hero-tv {
      width: min(560px, 100%);
      justify-self: center;
    }
  }
  @media (max-width: 480px) {
    .hero-ctas {
      flex-direction: column;
      width: 100%;
    }
    .hero-ctas .btn-buzzer {
      width: 100%;
    }
    .hero-bar-cta {
      min-height: 42px;
      padding: 6px 18px 8px;
      font-size: 1.05rem;
    }
  }

  .hero-burst {
    display: none; /* the game stage has no sunburst; kept for scripts/hero.ts */
  }

  /* Hidden until the intro plays (JS only) */
  :global(html.js .intro-pending .hero-title .word-in),
  :global(html.js) .intro-pending [data-hero-fade] {
    opacity: 0;
  }
</style>
