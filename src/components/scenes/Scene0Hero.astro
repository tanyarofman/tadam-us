---
import { useCopy, otherLanguagePath } from "../../content/copy";
import { contactLink, demoMedia } from "../../config/site";
import LogoAssemble from "../LogoAssemble.astro";
import SplitHeading from "../SplitHeading.astro";
const { copy: COPY, home, locale } = useCopy(Astro.url);
const media = demoMedia(locale);
const c = COPY.hero;
---

<section class="scene hero intro-pending" id="top" data-scene="hero" aria-labelledby="hero-title">
  <div class="hero-burst" aria-hidden="true"></div>
  <div class="hero-loading sr-only" role="status" aria-live="polite">{c.loading}</div>
  <header class="hero-header">
    <div class="hero-bar container hero-wide">
      <a href="#top" class="hero-home" aria-label={COPY.brand}><LogoAssemble class="hero-logo" /></a>
      <nav class="hero-nav" aria-label={c.navLabel} data-hero-fade>
        <ul role="list">{c.nav.map((l) => <li><a href={l.href} data-scroll-to={l.href}>{l.label}</a></li>)}</ul>
      </nav>
      <div class="hero-bar-action" data-hero-fade>
        {locale === "he" && <a class="hero-lang" href={otherLanguagePath(Astro.url)} lang={home === "/" ? "en" : "he"} aria-label={COPY.nav.langSwitchLabel} data-track="language_switch" data-source="hero-nav">{COPY.nav.langSwitch}</a>}
        <a class="btn hero-bar-cta" href={contactLink("hero-nav")} target="_blank" rel="noopener" data-track="cta_contact_click" data-source="hero-nav">{c.navCta}</a>
      </div>
    </div>
  </header>
  <div class="hero-inner container hero-wide">
    <div class="hero-copy">
      <SplitHeading as="h1" id="hero-title" class="h-hero hero-title" text={c.headline} highlight={c.highlight} breakAfter={c.breakAfter} />
      <p class="lead hero-sub" data-hero-fade>{c.sub}</p>
      <div class="hero-ctas" data-hero-fade>
        <a class="btn btn-buzzer" href={contactLink("hero")} target="_blank" rel="noopener" data-track="cta_contact_click" data-source="hero">
          <span class="btn-dot" aria-hidden="true"></span>{c.ctaPrimary}
        </a>
        <a class="btn btn-ghost" href="#scene-3" data-scroll-to="#scene-3" data-scroll-offset="3.35" data-track="cta_how_it_works_click">
          <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="24" cy="24" r="20"></circle>
            <path d="m20 15 13 9-13 9Z" fill="currentColor" stroke="none"></path>
          </svg>
          {c.ctaSecondary}
        </a>
      </div>
    </div>
    <figure class="hero-preview" aria-label={c.loopLabel} data-synced-preview style={`--screen-poster: url(${media.heroScreenPoster}); --phone-poster: url(${media.heroPhonePoster})`}>
      <div class="hero-devices">
        <div class="hero-television" aria-hidden="true">
          <div class="hero-tv-screen">
            <video data-preview-screen src={media.heroScreen} poster={media.heroScreenPoster} width="960" height="540" muted playsinline preload="auto" disablepictureinpicture disableRemotePlayback></video>
          </div>
          <span class="tv-light"></span><span class="tv-foot tv-foot-left"></span><span class="tv-foot tv-foot-right"></span>
        </div>
        <div class="hero-phone" aria-hidden="true">
          <div class="hero-phone-screen">
            <video data-preview-phone src={media.heroPhone} poster={media.heroPhonePoster} width="624" height="1370" muted playsinline preload="auto" disablepictureinpicture disableRemotePlayback></video>
            <span class="phone-speaker"></span>
          </div>
          <span class="phone-spark"><i></i><i></i><i></i></span>
        </div>
      </div>
      <figcaption>{c.loopCaption}</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    min-height: calc(100vh - 88px);
    min-height: calc(100svh - 88px);
    display: flex;
    flex-direction: column;
    padding-bottom: clamp(24px, 4vh, 40px);
    background: var(--page-gradient);
    overflow: hidden;
  }
  .hero-wide { --max-w: 1360px; --gutter: clamp(24px, 7vw, 96px); }
  .hero-header { position: relative; z-index: 3; background: #071548; }
  .hero-bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: clamp(14px, 2.4vh, 24px); }
  .hero-home { display: block; line-height: 0; }
  :global(.logo-assemble.hero-logo) { width: clamp(118px, 12vw, 172px); }
  .hero-nav ul { display: flex; gap: clamp(18px, 3vw, 44px); margin: 0; padding: 0; list-style: none; }
  .hero-nav a { font-family: var(--font-display); font-weight: 700; font-size: 1.75rem; color: var(--white); text-decoration: none; }
  .hero-nav a:hover { color: var(--game-yellow); }
  .hero-bar-action { display: flex; align-items: center; gap: clamp(12px, 2vw, 24px); }
  .hero-lang { display: inline-flex; align-items: center; min-height: 44px; color: var(--white); font-size: 1.25rem; text-underline-offset: 5px; white-space: nowrap; }
  .hero-lang:hover { color: var(--game-yellow); }
  .hero-bar-cta { min-height: 52px; padding: 10px 28px 12px; font-size: 1.625rem; white-space: nowrap; }
  .hero-inner {
    position: relative; z-index: 2; flex: 1; display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center; gap: clamp(40px, 6vw, 112px);
    padding-top: clamp(28px, 5vh, 56px);
  }
  .hero-copy { display: flex; flex-direction: column; align-items: flex-start; gap: clamp(14px, 2.4vh, 24px); max-width: 580px; }
  :global(.hero-title) { font-size: clamp(2.5rem, 4.4vw, 5rem); line-height: 1.05; text-shadow: 0 4px 0 var(--purple-ink); }
  /* English has no forced line break: the browser balances the lines, and a slightly smaller size keeps the headline at two lines like the Hebrew. */
  :global([dir="ltr"] .hero-title) { text-wrap: balance; font-size: clamp(2.85rem, 5vw, 4.3rem); }
  .hero-sub { max-width: 42ch; font-size: clamp(1.5rem, 2.45vw, 2rem); line-height: 1.6; }
  :global(.hero-title) { position: relative; top: calc(-1 * clamp(20px, 3vh, 30px)); }
  .hero-sub { position: relative; top: calc(-1 * clamp(30px, 4.5vh, 44px)); }
  .hero-ctas { display: flex; flex-direction: column; align-items: center; gap: 18px; margin-top: 4px; }
  .hero-ctas .btn { font-size: 1.8rem; }
  .hero-ctas .btn-ghost { font-size: 1.5rem; gap: 10px; text-decoration: none; }
  .hero-ctas .btn-ghost svg { width: 28px; height: 28px; flex: none; }
  .hero-preview { margin: 0; width: min(620px, 100%, calc((100svh - 300px) * 1.36)); min-width: min(360px, 100%); justify-self: end; display: flex; flex-direction: column; align-items: center; gap: 22px; }
  .hero-devices { position: relative; width: 100%; aspect-ratio: 1.36; direction: ltr; container-type: inline-size; isolation: isolate; }
  .hero-television {
    position: absolute; width: 92%; top: 8%; right: 0;
    padding: 1.1cqw 1.1cqw 1.7cqw; border: 0.45cqw solid #697489; border-radius: 1.2cqw;
    background: #101626; box-shadow: 0 22px 40px #020c5059; transform: rotate(2deg);
  }
  .hero-tv-screen { aspect-ratio: 16 / 9; overflow: hidden; border: 1px solid #000; background: #0734ab; }
  .hero-devices video { display: block; width: 100%; height: 100%; object-fit: cover; }
  .hero-preview[data-playback="loading"] .hero-tv-screen { background: var(--screen-poster) center / cover; }
  .hero-preview[data-playback="loading"] .hero-phone-screen { background: var(--phone-poster) center / cover; }
  .hero-preview[data-playback="loading"] video { opacity: 0; }
  .tv-light { position: absolute; bottom: .5cqw; left: 50%; width: .8cqw; height: .3cqw; border-radius: 50%; background: #b6c5e6; }
  .tv-foot { position: absolute; bottom: -2.4cqw; width: 6cqw; height: .7cqw; border: 1px solid #697489; border-radius: 6px; background: #11172e; }
  .tv-foot-left { left: 16%; transform: rotate(-35deg); }
  .tv-foot-right { right: 12%; transform: rotate(35deg); }
  .hero-phone {
    position: absolute; left: 1%; bottom: 0; width: 27%; padding: .9cqw;
    border: .4cqw solid #9ba2af; border-radius: 4cqw; background: #070d20;
    box-shadow: 8px 14px 25px #00144780; transform: rotate(-3deg); z-index: 2;
  }
  .hero-phone-screen { position: relative; aspect-ratio: 624 / 1370; border-radius: 3cqw; overflow: hidden; background: #07164b; }
  .phone-speaker { position: absolute; top: 1cqw; left: 37%; width: 26%; height: .65cqw; border-radius: 99px; background: #000; }
  .phone-spark { position: absolute; left: -3.2cqw; top: -3.8cqw; width: 6cqw; height: 6cqw; color: var(--game-yellow); }
  .phone-spark i { position: absolute; width: .8cqw; height: 2.7cqw; border-radius: 8px; background: currentColor; top: 0; left: 4cqw; transform: rotate(-10deg); }
  .phone-spark i:nth-child(2) { top: 1.5cqw; left: 1.8cqw; transform: rotate(-50deg); }
  .phone-spark i:nth-child(3) { top: 4cqw; left: .6cqw; transform: rotate(-80deg); }
  .hero-preview figcaption { color: #f3f5ff; font-size: clamp(1.2rem, 1.8vw, 1.5rem); text-align: center; line-height: 1.3; translate: clamp(28px, 4vw, 48px) -20px; }
  @media (max-width: 900px) {
    .hero-nav { display: none; }
    .hero-inner { grid-template-columns: minmax(0, 1fr); padding-top: 24px; text-align: center; gap: 24px; }
    .hero-copy { align-items: center; justify-self: center; }
    :global(.hero-title) { font-size: clamp(2.65rem, 11.5vw, 4.4rem); top: -16px; }
    .hero-sub { top: -26px; }
    :global([dir="ltr"] .hero-title) { font-size: clamp(2.3rem, 12.2vw, 4.9rem); }
    :global(.hero-title .split-br) { display: none; }
    .hero-preview { width: min(520px, 100%); min-width: 0; justify-self: center; gap: 14px; }
  }
  @media (max-width: 480px) {
    .hero-preview figcaption { translate: 28px -14px; }
    .hero { padding-bottom: 20px; }
    .hero-bar { padding-block: 14px; }
    .hero-inner { padding-top: 52px; gap: 16px; }
    .hero-copy { gap: 12px; }
    .hero-ctas { width: 100%; }
    .hero-ctas .btn-buzzer { width: 100%; }
    .hero-ctas .btn-ghost { min-height: 44px; padding-block: 8px; }
    .hero-bar-cta { min-height: 46px; padding: 8px 20px 10px; font-size: 1.375rem; }
  }
  /* Narrow phones: the logo, the language link and the (longer) English button share one row. */
  @media (max-width: 380px) {
    .hero-bar { gap: 10px; }
    .hero-bar-action { gap: 10px; }
    .hero-lang { font-size: 1.1rem; }
    :global([dir="ltr"]) .hero-bar-cta { padding-inline: 14px; font-size: 1.15rem; }
    :global([dir="ltr"] .logo-assemble.hero-logo) { width: 96px; }
  }
  @media (min-width: 481px) and (max-width: 767px) {
    .hero-inner { padding-top: 56px; }
  }
  .hero-burst { display: none; }
  :global(html.js .intro-pending .hero-title .word-in),
  :global(html.js) .intro-pending [data-hero-fade] { opacity: 0; }
</style>
