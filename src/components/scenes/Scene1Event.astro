---
import { COPY } from "../../content/copy.he";
import SplitHeading from "../SplitHeading.astro";
import HallArt from "../art/HallArt.astro";
const c = COPY.scene1;
---

<section class="scene s1" id="scene-1" data-scene="1" aria-labelledby="s1-title">
  <div class="scene-pin s1-pin">
    <div class="s1-stage">
      <div class="s1-art">
        <HallArt />
      </div>
      <div class="s1-shade" aria-hidden="true"></div>
      <div class="s1-copy container">
        <SplitHeading as="h2" id="s1-title" class="h-scene s1-title" text={c.headline} highlight="מחכים" />
      </div>
    </div>
  </div>
</section>

<style>
  .s1-pin {
    align-items: start;
  }
  /* Art, shade and copy move together (scene1.ts zooms this), so on mobile the copy stays in the screen. */
  .s1-stage {
    position: absolute;
    inset: 0;
    transform-origin: 50% 70%;
    container-type: size;
  }
  .s1-art {
    position: absolute;
    inset: 0;
  }
  .s1-shade {
    position: absolute;
    inset: 0;
    /* no navy bands: the photo itself fades into the page background (HallArt.astro) */
    background: none;
    pointer-events: none;
  }
  .s1-copy {
    position: relative;
    text-align: center;
    padding-top: clamp(72px, 12vh, 120px);
  }
  :global(.s1-title) {
    max-width: 16ch;
    margin-inline: auto;
    text-shadow: 0 4px 0 var(--purple-ink), 0 10px 30px rgba(0, 0, 0, 0.45);
  }
  /* Photo background: the headline sits near the top, over the shaded part of the photo. */
  @media (max-width: 767px) {
    :global(.s1-title) {
      font-size: var(--fs-h2);
    }
  }
</style>
