---
import { COPY } from "../../content/copy.he";
import SplitHeading from "../SplitHeading.astro";
import Guest from "../art/Guest.astro";
const c = COPY.scene2;

// A row of guests. `bubble` = index into c.bubbles.
const guests = [
  { role: "סבתא", shirt: "#E836A1", skin: "#f5d2b5", hair: "#d8d2cc", hairStyle: "bun", glasses: true, bubble: 0 },
  { role: "הדודה", shirt: "#2bb3a3", skin: "#d9a37a", hair: "#3b2318", hairStyle: "long" },
  { role: "החברה הכי טובה", shirt: "#F7D94A", skin: "#f2c6a0", hair: "#7a3d1c", hairStyle: "long", bubble: 1 },
  { role: "בן הדוד", shirt: "#64D8F7", skin: "#a8714a", hair: "#1f1410", hairStyle: "curly" },
  { role: "אבא", shirt: "#E74138", skin: "#f2c6a0", hair: "#3b2318", hairStyle: "short", bubble: 2 },
  { role: "המורה", shirt: "#8a62d0", skin: "#d9a37a", hair: "#c98b3c", hairStyle: "bun", glasses: true },
] as const;
---

<section class="scene s2" id="scene-2" data-scene="2" aria-labelledby="s2-title">
  <div class="scene-pin s2-pin">
    <div class="s2-copy container">
      <SplitHeading as="h2" id="s2-title" class="h-scene s2-title" text={c.headline} highlight="אחרת" />
    </div>

    <div class="s2-track-wrap">
      <ul class="s2-track" role="list">
        {
          guests.map((g) => {
            const b = "bubble" in g ? c.bubbles[g.bubble] : null;
            return (
              <li class:list={["s2-guest", { "has-bubble": !!b }]}>
                {b && (
                  <blockquote class="bubble">
                    <p>{b.text}</p>
                    <footer>{b.who}</footer>
                  </blockquote>
                )}
                <svg viewBox="-60 -130 120 135" class="s2-figure" aria-hidden="true">
                  <Guest
                    shirt={g.shirt}
                    skin={g.skin}
                    hair={g.hair}
                    hairStyle={g.hairStyle}
                    glasses={"glasses" in g ? g.glasses : false}
                    pose={b ? "talk" : "stand"}
                  />
                </svg>
                {!b && <span class="s2-role">{g.role}</span>}
              </li>
            );
          })
        }
      </ul>
      <div class="s2-floor" aria-hidden="true"></div>
    </div>
  </div>
</section>

<style>
  .s2-pin {
    grid-template-rows: auto 1fr;
    align-items: stretch;
    padding-block: clamp(64px, 10vh, 110px) 24px;
  }
  .s2-copy {
    text-align: center;
  }
  :global(.s2-title) {
    max-width: 16ch;
    margin-inline: auto;
    text-shadow: 0 4px 0 var(--purple-ink);
  }
  .s2-track-wrap {
    position: relative;
    align-self: end;
    width: 100%;
    overflow: visible;
  }
  .s2-track {
    list-style: none;
    margin: 0;
    padding: 0 var(--gutter);
    display: flex;
    gap: clamp(8px, 2vw, 28px);
    align-items: end;
    width: max-content;
    min-width: 100%;
    justify-content: center;
  }
  .s2-guest {
    position: relative;
    width: clamp(120px, 15vw, 190px);
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .s2-figure {
    width: 100%;
    overflow: visible;
  }
  .s2-role {
    margin-top: 6px;
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .bubble {
    position: relative;
    margin: 0 0 18px;
    width: clamp(190px, 22vw, 260px);
    padding: 16px 18px 14px;
    background: var(--white);
    color: var(--purple-ink);
    border: var(--stroke) solid var(--purple-ink);
    border-radius: 24px;
    box-shadow: 0 6px 0 var(--purple-ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    line-height: 1.3;
    text-align: center;
    transform-origin: 50% 110%;
  }
  .bubble::after {
    content: "";
    position: absolute;
    bottom: -18px;
    left: 50%;
    width: 24px;
    height: 24px;
    margin-left: -12px;
    background: var(--white);
    border: var(--stroke) solid var(--purple-ink);
    border-top: 0;
    border-inline-start: 0;
    transform: rotate(45deg) skew(8deg, 8deg);
    border-radius: 0 0 8px 0;
  }
  .bubble footer {
    margin-top: 8px;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--fs-small);
    color: var(--magenta);
  }
  .has-bubble:nth-child(1) .bubble {
    background: #fff4c7;
  }
  .has-bubble:nth-child(3) .bubble {
    background: #dff6fd;
  }
  .has-bubble:nth-child(5) .bubble {
    background: #ffe0f1;
  }
  .has-bubble:nth-child(1) .bubble::after {
    background: #fff4c7;
  }
  .has-bubble:nth-child(3) .bubble::after {
    background: #dff6fd;
  }
  .has-bubble:nth-child(5) .bubble::after {
    background: #ffe0f1;
  }
  .s2-floor {
    position: absolute;
    inset-inline: 0;
    bottom: -24px;
    height: 60px;
    background: radial-gradient(50% 100% at 50% 100%, var(--spot), transparent 70%);
    z-index: -1;
  }
  @media (max-width: 767px) {
    .s2-track {
      justify-content: flex-start;
    }
    .s2-guest {
      width: 130px;
    }
    .s2-guest.has-bubble {
      width: 210px;
    }
    .bubble {
      width: 200px;
    }
  }
</style>
