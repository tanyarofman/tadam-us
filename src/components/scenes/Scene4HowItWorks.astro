---
import { useCopy } from "../../content/copy";
import SplitHeading from "../SplitHeading.astro";
import Person from "../art/Person.astro";
const { copy: COPY } = useCopy(Astro.url);
const c = COPY.scene4;
const m = c.mock;
const tileColors = ["var(--answer-1)", "var(--answer-2)", "var(--answer-3)", "var(--answer-4)", "var(--answer-2)", "var(--answer-3)"];
const tiles = m.tiles.map((label, i) => ({ color: tileColors[i % tileColors.length], label }));
---

<section class="scene s4" id="scene-4" data-scene="4" aria-labelledby="s4-title">
  <div class="s4-pin">
  <div class="container s4-inner">
    <div class="s4-head">
      <SplitHeading as="h2" id="s4-title" class="h-scene s4-title" text={c.headline} />
    </div>

    <ol class="s4-steps" role="list">
      {/* Step 1: a Messenger chat with our Facebook page */}
      <li class="step-card" data-step="1">
        <div class="step-visual v-link" aria-hidden="true">
          <div class="mini-phone mp-main">
            <div class="chat-head">
              <span class="chat-head-logo">!</span>
              {m.chatFrom}
            </div>
            <div class="chat-bubble chat-out">
              <p>{m.chatText}</p>
            </div>
            <div class="chat-bubble chat-in">
              <p>{m.chatReply}</p>
            </div>
          </div>
        </div>
        <div class="step-text">
          <span class="step-num">1</span>
          <h3 class="display h-card">{c.steps[0].title}</h3>
          <p>{c.steps[0].text}</p>
        </div>
      </li>

      {/* Step 2: choose a host and a visual atmosphere */}
      <li class="step-card" data-step="2">
        <div class="step-visual v-customize" aria-hidden="true">
          <div class="customize-title">{m.hostTitle}</div>
          <div class="host-options">
            {["host-classic", "host-friendly", "host-animated"].map((name, i) => (
              <div class:list={["host-option", { "is-selected": i === 1 }]}>
                <Person name={name} alt="" width={480} height={640} />
                {i === 1 && <span class="choice-check">✓</span>}
              </div>
            ))}
          </div>
          <div class="atmosphere-picker">
            <span>{m.atmosphereTitle}</span>
            <div class="atmosphere-options">
              <span class="atmosphere-swatch" style="--swatch:linear-gradient(135deg,#143cff,#07164b)"></span>
              <span class="atmosphere-swatch is-selected" style="--swatch:linear-gradient(135deg,#b24cfa,#30105d)">✓</span>
              <span class="atmosphere-swatch" style="--swatch:linear-gradient(135deg,#ffad47,#bd2378)"></span>
            </div>
          </div>
        </div>
        <div class="step-text">
          <span class="step-num">2</span>
          <h3 class="display h-card">{c.steps[1].title}</h3>
          <p>{c.steps[1].text}</p>
        </div>
      </li>

      {/* Step 3: build the game */}
      <li class="step-card" data-step="3">
        <div class="step-visual v-board" aria-hidden="true">
          <div class="board-title">{m.boardTitle}</div>
          <div class="board">
            {
              tiles.map((t) => (
                <div class="board-slot">
                  <div class="board-tile" style={`--c:${t.color}`}>
                    {t.label}
                  </div>
                </div>
              ))
            }
          </div>
        </div>
        <div class="step-text">
          <span class="step-num">3</span>
          <h3 class="display h-card">{c.steps[2].title}</h3>
          <p>{c.steps[2].text}</p>
        </div>
      </li>
    </ol>

  </div>
  </div>
</section>

<style>
  .s4-pin {
    padding-block: clamp(64px, 10vh, 120px);
  }
  .s4-head {
    text-align: center;
    margin-bottom: var(--story-heading-gap);
  }
  /* Pinned + animated mode (set by JS): fit the whole step sequence in one screen */
  :global(.s4.is-pinned) .s4-pin {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: flex-start;
    padding-block: var(--story-heading-top) 32px;
  }
  :global(.s4-title) {
    font-size: var(--fs-story-title);
    text-shadow: 0 4px 0 var(--purple-ink);
  }
  .s4-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(16px, 2.4vw, 28px);
    perspective: 1400px;
  }
  .step-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 2px solid var(--surface-border);
    border-radius: var(--radius-l);
    overflow: hidden;
    transform-origin: 100% 50%; /* RTL: flips in from the start (right) edge */
    backdrop-filter: blur(6px);
  }
  :global([dir="ltr"]) .step-card { transform-origin: 0% 50%; }
  .step-visual {
    position: relative;
    height: 270px;
    background: radial-gradient(90% 90% at 50% 100%, var(--spot), transparent 70%),
      linear-gradient(180deg, rgba(0, 0, 0, 0.15), transparent);
    border-bottom: 2px solid var(--surface-border);
    overflow: hidden;
  }
  .step-text {
    padding: 22px 24px 28px;
  }
  .step-text p {
    margin-top: 8px;
    color: var(--text-muted);
  }
  .step-num {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-bottom: 12px;
    border-radius: 50%;
    background: var(--buzzer-red);
    border: 3px solid var(--purple-ink);
    box-shadow: 0 4px 0 var(--purple-ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.2rem;
  }

  /* --- visual 1: link --- */
  .mini-phone {
    position: absolute;
    border-radius: 22px;
    background: #f4f0ff;
    border: 4px solid var(--purple-ink);
    box-shadow: 0 6px 0 var(--purple-ink);
  }
  .mp-main {
    width: 84%;
    height: 252px;
    bottom: -12px;
    left: 8%;
    padding: 12px 10px;
    color: var(--purple-ink);
  }
  .chat-head {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 1.25rem;
    font-weight: 700;
    padding: 2px 6px 8px;
    border-bottom: 1px solid #d8cdf3;
    margin-bottom: 10px;
  }
  .chat-bubble {
    width: fit-content;
    max-width: 88%;
    margin-bottom: 8px;
    padding: 7px 10px;
    font-size: 1.2rem;
    line-height: 1.3;
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.1);
  }
  /* Messenger, mirrored for Hebrew: the parent's own message on the left (end, blue), our reply on the right (start, gray) */
  .chat-out {
    margin-inline-start: auto;
    background: linear-gradient(135deg, #0a7cff, #7a3cf5);
    color: #fff;
    border-radius: 18px 18px 18px 4px;
  }
  .chat-in {
    background: #eceef3;
    border-radius: 18px 4px 18px 18px;
  }
  /* English (LTR): the regular Messenger layout, own message on the right, the reply on the left. */
  :global([dir="ltr"]) .chat-out { border-radius: 18px 18px 4px 18px; }
  :global([dir="ltr"]) .chat-in { border-radius: 4px 18px 18px 18px; }
  :global([dir="ltr"]) .choice-check { left: auto; right: -5px; }
  .chat-head-logo {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--buzzer-red);
    color: #fff;
    font-weight: 800;
  }

  /* --- visual 2: host portraits + atmosphere palettes --- */
  .v-customize { padding: 16px; display: flex; flex-direction: column; gap: 12px; }
  .customize-title { font-size: 1.25rem; font-weight: 700; text-align: center; }
  .host-options { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .host-option { position: relative; border: 2px solid transparent; border-radius: 12px; opacity: .65; }
  .host-option.is-selected { border-color: var(--game-yellow); opacity: 1; }
  .choice-check { position: absolute; bottom: -8px; left: -5px; width: 26px; height: 26px; display: grid; place-items: center; border-radius: 50%; background: var(--game-yellow); color: var(--ink); font-size: 1.1rem; font-weight: 700; }
  .atmosphere-picker { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: auto; font-size: 1.15rem; }
  .atmosphere-options { display: flex; gap: 8px; }
  .atmosphere-swatch { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: var(--swatch); border: 2px solid rgba(255,255,255,.35); font-weight: 700; }
  .atmosphere-swatch.is-selected { border-color: var(--game-yellow); }

  /* --- visual 3: board --- */
  .v-board {
    padding: 16px;
  }
  .board-title {
    text-align: center;
    font-family: var(--font-display);
    font-weight: 700;
    margin-bottom: 10px;
  }
  .board {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    padding: 12px;
    border-radius: 18px;
    background: rgba(0, 0, 0, 0.25);
    border: 3px dashed var(--surface-border);
  }
  .board-slot {
    height: 66px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.06);
  }
  .board-tile {
    height: 100%;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: var(--c);
    color: var(--purple-ink);
    border: 3px solid var(--purple-ink);
    box-shadow: 0 4px 0 var(--purple-ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9rem;
  }

  @media (max-width: 899px) {
    .s4-steps {
      grid-template-columns: 1fr;
      max-width: 460px;
      margin-inline: auto;
    }
    /* phones, animated: the cards take the stage one at a time */
    :global(.s4.is-pinned) .s4-steps {
      grid-template-columns: minmax(0, 1fr);
    }
    :global(.s4.is-pinned) .step-card {
      grid-area: 1 / 1;
    }
    :global(.s4.is-pinned) .step-visual {
      height: 270px;
    }
    :global(.s4.is-pinned) .step-text {
      padding: 16px 20px 20px;
    }
  }
  @media (max-width: 899px) and (max-height: 700px) {
    :global(.s4.is-pinned) .s4-pin { padding-block: 24px; }
    .s4-head { margin-bottom: 24px; }
    :global(.s4.is-pinned) .step-text { padding: 12px 20px 16px; }
    .step-num { margin-bottom: 8px; }
  }
  @media (max-width: 767px) and (orientation: portrait) {
    :global(.s4.is-pinned) .s4-pin { min-height: 100lvh; padding-block: clamp(84px, 15svh, 132px) 24px; }
    .s4-head { margin-bottom: clamp(24px, 4svh, 36px); }
    :global(.s4.is-pinned) .step-visual { height: clamp(190px, 33svh, 270px); }
    .mp-main { height: calc(100% - 24px); }
  }
  @media (orientation: landscape) and (max-height: 500px) {
    :global(.s4.is-pinned) .s4-pin { padding-block: 16px; }
    :global(.s4-title) { font-size: 2.2rem; }
    .s4-head { margin-bottom: 16px; }
    .s4-steps { grid-template-columns: 1fr; max-width: 760px; margin-inline: auto; }
    :global(.s4.is-pinned) .step-card { grid-area: 1 / 1; }
    .step-card { display: grid; grid-template-columns: 1fr 1fr; align-items: center; }
    :global(.s4.is-pinned) .step-visual, .step-visual { height: min(250px, calc(100svh - 100px)); border-bottom: 0; }
    .mp-main { height: calc(100% - 10px); bottom: -6px; padding: 8px; }
    .chat-head { margin-bottom: 6px; padding-bottom: 6px; }
    .chat-bubble { font-size: 1.1rem; padding: 5px 8px; margin-bottom: 6px; }
    .host-options { width: min(100%, 240px); margin-inline: auto; }
    .v-customize { gap: 8px; padding: 12px; }
    .host-option :global(.person) { max-height: 110px; }
    .atmosphere-picker { font-size: 1rem; }
    .atmosphere-swatch { width: 28px; height: 28px; }
    .board-slot { height: 48px; }
    .step-text { padding: 12px 20px 16px; }
    .step-num { margin-bottom: 8px; }
  }
</style>
