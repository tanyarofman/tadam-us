---
import { COPY } from "../../content/copy.he";
import SplitHeading from "../SplitHeading.astro";
const c = COPY.scene4;
const m = c.mock;
const tiles = [
  { color: "var(--answer-1)", label: "שאלה" },
  { color: "var(--answer-2)", label: "תמונה" },
  { color: "var(--answer-3)", label: "סיפור" },
  { color: "var(--answer-4)", label: "בדיחה" },
  { color: "var(--answer-2)", label: "שאלה" },
  { color: "var(--answer-3)", label: "מנחה" },
];
---

<section class="scene s4" id="scene-4" data-scene="4" aria-labelledby="s4-title">
  <div class="s4-pin">
  <div class="container s4-inner">
    <div class="s4-head">
      <SplitHeading as="h2" id="s4-title" class="h-scene s4-title" text={c.headline} />
    </div>

    <ol class="s4-steps" role="list">
      {/* Step 1: the link */}
      <li class="step-card" data-step="1">
        <div class="step-visual v-link" aria-hidden="true">
          <div class="mini-phone mp-back mp-1"><span class="ping"></span></div>
          <div class="mini-phone mp-back mp-2"><span class="ping"></span></div>
          <div class="mini-phone mp-main">
            <div class="chat-head">{m.chatFrom}</div>
            <div class="chat-bubble">
              <p>{m.chatText}</p>
              <div class="chat-link">
                <span class="chat-link-logo">!</span>
                <span>{m.chatLink}</span>
              </div>
            </div>
          </div>
        </div>
        <div class="step-text">
          <span class="step-num">1</span>
          <h3 class="display h-card">{c.steps[0].title}</h3>
          <p>{c.steps[0].text}</p>
        </div>
      </li>

      {/* Step 2: approve every item */}
      <li class="step-card" data-step="2">
        <div class="step-visual v-approve" aria-hidden="true">
          <div class="approve-title">{m.approveTitle}</div>
          {
            m.approveItems.map((it, i) => (
              <div class="approve-row" data-i={i}>
                <div class="approve-q">
                  <small>{it.from}</small>
                  <span>{it.q}</span>
                </div>
                <div class="approve-btns">
                  <span class="ab ab-no">✕</span>
                  <span class="ab ab-yes">✓</span>
                </div>
              </div>
            ))
          }
        </div>
        <div class="step-text">
          <span class="step-num">2</span>
          <h3 class="display h-card">{c.steps[1].title}</h3>
          <p>{c.steps[1].text}</p>
        </div>
      </li>

      {/* Step 3: build the game */}
      <li class="step-card" data-step="3">
        <div class="step-visual v-board" aria-hidden="true">
          <div class="board-title">{m.boardTitle}</div>
          <div class="board">
            {
              tiles.map((t) => (
                <div class="board-slot">
                  <div class="board-tile" style={`--c:${t.color}`}>
                    {t.label}
                  </div>
                </div>
              ))
            }
          </div>
        </div>
        <div class="step-text">
          <span class="step-num">3</span>
          <h3 class="display h-card">{c.steps[2].title}</h3>
          <p>{c.steps[2].text}</p>
        </div>
      </li>
    </ol>

    <aside class="privacy-strip reveal" aria-label="פרטיות">
      <svg class="privacy-icon" viewBox="0 0 48 48" aria-hidden="true">
        <rect x="9" y="21" width="30" height="22" rx="6" fill="var(--sun-yellow)" stroke="var(--purple-ink)" stroke-width="4"></rect>
        <path d="M15 21 V15 Q15 6 24 6 Q33 6 33 15 V21" fill="none" stroke="var(--purple-ink)" stroke-width="4"></path>
        <circle cx="24" cy="31" r="3.5" fill="var(--purple-ink)"></circle>
      </svg>
      <p>{c.privacy}</p>
    </aside>
  </div>
  </div>
</section>

<style>
  .s4-pin {
    padding-block: clamp(64px, 10vh, 120px);
  }
  .s4-head {
    text-align: center;
    margin-bottom: clamp(24px, 4vh, 56px);
  }
  /* Pinned + animated mode (set by JS): fit the whole step sequence in one screen */
  :global(.s4.is-pinned) .s4-pin {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: clamp(24px, 5vh, 64px);
  }
  :global(.s4-title) {
    text-shadow: 0 4px 0 var(--purple-ink);
  }
  .s4-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(16px, 2.4vw, 28px);
    perspective: 1400px;
  }
  .step-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 2px solid var(--surface-border);
    border-radius: var(--radius-l);
    overflow: hidden;
    transform-origin: 100% 50%; /* RTL: flips in from the start (right) edge */
    backdrop-filter: blur(6px);
  }
  .step-visual {
    position: relative;
    height: 270px;
    background: radial-gradient(90% 90% at 50% 100%, var(--spot), transparent 70%),
      linear-gradient(180deg, rgba(0, 0, 0, 0.15), transparent);
    border-bottom: 2px solid var(--surface-border);
    overflow: hidden;
  }
  .step-text {
    padding: 22px 24px 28px;
  }
  .step-text p {
    margin-top: 8px;
    color: var(--text-muted);
  }
  .step-num {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-bottom: 12px;
    border-radius: 50%;
    background: var(--buzzer-red);
    border: 3px solid var(--purple-ink);
    box-shadow: 0 4px 0 var(--purple-ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.2rem;
  }

  /* --- visual 1: link --- */
  .mini-phone {
    position: absolute;
    border-radius: 22px;
    background: #f4f0ff;
    border: 4px solid var(--purple-ink);
    box-shadow: 0 6px 0 var(--purple-ink);
  }
  .mp-main {
    width: 62%;
    height: 230px;
    bottom: -30px;
    left: 19%;
    padding: 12px 10px;
    color: var(--purple-ink);
  }
  .mp-back {
    width: 28%;
    height: 120px;
    bottom: 40px;
    background: #ded4f6;
  }
  .mp-1 {
    right: 4%;
    transform: rotate(10deg);
  }
  .mp-2 {
    left: 4%;
    transform: rotate(-10deg);
  }
  .ping {
    position: absolute;
    top: -8px;
    left: -8px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--buzzer-red);
    border: 3px solid var(--purple-ink);
  }
  .chat-head {
    font-size: 0.75rem;
    font-weight: 500;
    padding: 4px 8px 8px;
    border-bottom: 1px solid #d8cdf3;
    margin-bottom: 10px;
  }
  .chat-bubble {
    background: #d9fdd3;
    border-radius: 14px 4px 14px 14px;
    padding: 8px 10px;
    font-size: 0.8rem;
    line-height: 1.4;
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.1);
  }
  .chat-link {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
    padding: 6px 8px;
    border-radius: 8px;
    background: rgba(0, 0, 0, 0.06);
    font-size: 0.75rem;
    direction: ltr;
    justify-content: flex-end;
    color: #0b6e4f;
  }
  .chat-link-logo {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: var(--buzzer-red);
    color: #fff;
    font-weight: 800;
  }

  /* --- visual 2: approve --- */
  .v-approve {
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .approve-title {
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .approve-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 9px 12px;
    background: #fff;
    color: var(--purple-ink);
    border-radius: 14px;
    border: 3px solid var(--purple-ink);
    font-size: 0.8rem;
    line-height: 1.3;
    transition: background 0.3s;
  }
  .approve-q {
    display: flex;
    flex-direction: column;
  }
  .approve-q small {
    color: var(--magenta);
    font-weight: 500;
  }
  .approve-btns {
    display: flex;
    gap: 6px;
    flex: none;
  }
  .ab {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 2px solid var(--purple-ink);
    font-weight: 800;
    background: #f1ecfb;
    transition:
      background 0.25s,
      transform 0.25s var(--ease-bounce);
  }
  .approve-row.is-yes .ab-yes {
    background: var(--magenta);
    color: #fff;
    transform: scale(1.15);
  }
  .approve-row.is-yes {
    background: #ffe9f5;
  }
  .approve-row.is-no {
    opacity: 0.5;
  }
  .approve-row.is-no .ab-no {
    background: var(--purple-ink);
    color: #fff;
  }

  /* --- visual 3: board --- */
  .v-board {
    padding: 16px;
  }
  .board-title {
    text-align: center;
    font-family: var(--font-display);
    font-weight: 700;
    margin-bottom: 10px;
  }
  .board {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    padding: 12px;
    border-radius: 18px;
    background: rgba(0, 0, 0, 0.25);
    border: 3px dashed var(--surface-border);
  }
  .board-slot {
    height: 66px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.06);
  }
  .board-tile {
    height: 100%;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: var(--c);
    color: var(--purple-ink);
    border: 3px solid var(--purple-ink);
    box-shadow: 0 4px 0 var(--purple-ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9rem;
  }

  .privacy-strip {
    display: flex;
    align-items: center;
    gap: 14px;
    width: fit-content;
    max-width: 100%;
    margin: clamp(24px, 5vh, 56px) auto 0;
    padding: 14px 22px;
    border-radius: var(--radius-m);
    background: rgba(255, 255, 255, 0.06);
    border: 2px solid var(--surface-border);
    color: var(--text);
    font-size: clamp(0.92rem, 1.15vw, 1rem);
  }
  .privacy-icon {
    width: 36px;
    flex: none;
  }
  /* one sentence, one line, on wide screens */
  @media (min-width: 1180px) {
    .privacy-strip p {
      white-space: nowrap;
    }
  }

  @media (max-width: 899px) {
    .s4-steps {
      grid-template-columns: 1fr;
      max-width: 460px;
      margin-inline: auto;
    }
    /* phones, animated: the cards take the stage one at a time */
    :global(.s4.is-pinned) .s4-steps {
      grid-template-columns: minmax(0, 1fr);
    }
    :global(.s4.is-pinned) .step-card {
      grid-area: 1 / 1;
    }
    :global(.s4.is-pinned) .step-visual {
      height: 220px;
    }
    :global(.s4.is-pinned) .step-text {
      padding: 16px 20px 20px;
    }
  }
</style>
