---
/**
 * Scene 5 (WOW #2): the moment everyone plays. No game mock here (the demo video in scene 3 already shows it):
 * a sea of phones lights up across the room, then the headline lands.
 */
import { COPY } from "../../content/copy.he";
import SplitHeading from "../SplitHeading.astro";
const c = COPY.scene5;
---

<section class="scene s5" id="scene-5" data-scene="5" aria-labelledby="s5-title">
  <div class="scene-pin s5-pin">
    <div class="s5-glow" aria-hidden="true"></div>
    <canvas class="s5-crowd" aria-hidden="true"></canvas>
    <div class="s5-copy container">
      <SplitHeading as="h2" id="s5-title" class="h-scene s5-title" text={c.headline} highlight="ביחד" />
    </div>
  </div>
</section>

<style>
  .s5-pin {
    align-items: center;
    background: radial-gradient(80% 70% at 50% 35%, var(--bg-1), var(--bg-0));
  }
  /* a soft stage wash behind the crowd, so the lights sit in a room and not on a flat color */
  .s5-glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(45% 30% at 50% 22%, rgba(120, 190, 255, 0.28), transparent 70%),
      radial-gradient(70% 40% at 50% 100%, rgba(0, 10, 60, 0.85), transparent 75%);
    pointer-events: none;
  }
  .s5-crowd {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .s5-copy {
    position: relative;
    z-index: 1;
    text-align: center;
  }
  :global(.s5-title) {
    max-width: 18ch;
    margin-inline: auto;
    text-shadow: 0 4px 0 var(--purple-ink), 0 0 40px rgba(0, 0, 20, 0.7);
  }
</style>
