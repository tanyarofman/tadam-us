---
import { COPY } from "../../content/copy.he";
import SplitHeading from "../SplitHeading.astro";
const c = COPY.scene5;
const total = c.answers.reduce((n, a) => n + a.votes, 0);
const maxVotes = Math.max(...c.answers.map((a) => a.votes));
// Bar length = share of the winning answer, so the leader always fills most of the pill.
const bar = (votes: number) => (votes / maxVotes).toFixed(3);
const pickedWrong = c.pickedIndex !== c.correctIndex;

// Decorative QR (21x21 with real finder patterns, not scannable on purpose)
const N = 21;
const inFinder = (x: number, y: number) => {
  const box = (ox: number, oy: number) => {
    const dx = x - ox;
    const dy = y - oy;
    if (dx < 0 || dy < 0 || dx > 6 || dy > 6) return null;
    const edge = dx === 0 || dy === 0 || dx === 6 || dy === 6;
    const core = dx >= 2 && dx <= 4 && dy >= 2 && dy <= 4;
    return edge || core;
  };
  return box(0, 0) ?? box(N - 7, 0) ?? box(0, N - 7);
};
const qr = Array.from({ length: N * N }, (_, i) => {
  const x = i % N;
  const y = Math.floor(i / N);
  const f = inFinder(x, y);
  if (f !== null) return f;
  if ((x < 8 && y < 8) || (x > N - 9 && y < 8) || (x < 8 && y > N - 9)) return false;
  return (x * 7 + y * 13 + x * y * 3) % 5 < 2;
});
---

<section class="scene s5" id="scene-5" data-scene="5" aria-labelledby="s5-title">
  <div class="scene-pin s5-pin">
    <canvas class="s5-crowd" aria-hidden="true"></canvas>

    <div class="s5-split container">
      {/* Guest phone first in the DOM: it is the right column on desktop (RTL) and the first, large view on mobile */}
      <div class="phone" role="img" aria-label={c.phoneLabel}>
        <div class="phone-notch" aria-hidden="true"></div>
        <div class="phone-screen stage-bg" aria-hidden="true">
          <img class="g-logo" src="/brand/tadam-logo-v2.webp" alt="" width="1472" height="814" />
          <p class="g-label">{c.questionLabel}</p>
          <div class="phone-qwrap">
            <p class="g-q phone-q q-ask">{c.question}</p>
            <p class="g-q phone-q q-next">{c.phoneNext}</p>
          </div>
          <ul class="pills" role="list">
            {
              c.answers.map((a, i) => (
                <li
                  class:list={[
                    "pill",
                    { "is-correct": i === c.correctIndex, "is-picked": i === c.pickedIndex, "is-wrong": pickedWrong && i === c.pickedIndex },
                  ]}
                  style={`--p:${bar(a.votes)}`}
                  data-i={i}
                >
                  <span class="pill-bar" />
                  <span class="pill-text">{a.text}</span>
                  <span class="pill-n">{a.votes}</span>
                </li>
              ))
            }
          </ul>
          <div class="ring phone-ring" style={`--ring:1`}>
            <svg viewBox="0 0 100 100"><circle class="ring-track" cx="50" cy="50" r="44"></circle><circle class="ring-arc" cx="50" cy="50" r="44" pathLength="100"></circle></svg>
            <b class="ring-n">{c.ringSeconds}</b>
          </div>
        </div>
        <span class="tap-ring" aria-hidden="true"></span>
        <svg class="finger" viewBox="0 0 80 104" aria-hidden="true">
          <defs>
            <linearGradient id="fg-skin" x1="0" y1="0" x2="1" y2="0.3">
              <stop offset="0" stop-color="#ffe0c2"></stop>
              <stop offset="1" stop-color="#f3b488"></stop>
            </linearGradient>
            <linearGradient id="fg-cuff" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#ffe600"></stop>
              <stop offset="1" stop-color="#ffc400"></stop>
            </linearGradient>
          </defs>
          <g transform="rotate(-8 40 90)">
            <rect x="40" y="44" width="15" height="26" rx="7.5" fill="#eaa77a"></rect>
            <rect x="54" y="53" width="14" height="22" rx="7" fill="#eaa77a"></rect>
            <path d="M22 50 Q22 44 30 44 L56 50 Q66 52 66 62 L66 74 Q66 88 52 90 L36 90 Q22 89 20 76 Z" fill="url(#fg-skin)"></path>
            <rect x="36" y="46" width="14" height="24" rx="7" fill="url(#fg-skin)"></rect>
            <rect x="47" y="50" width="13" height="22" rx="6.5" fill="url(#fg-skin)"></rect>
            <rect x="56" y="55" width="11" height="19" rx="5.5" fill="url(#fg-skin)"></rect>
            <path d="M38.5 50 v16 M49 53 v15 M58 58 v12" stroke="#e39c6e" stroke-width="2" stroke-linecap="round" opacity=".8"></path>
            <rect x="22" y="4" width="17" height="60" rx="8.5" fill="url(#fg-skin)"></rect>
            <path d="M26 30 h9" stroke="#d98f62" stroke-width="2" stroke-linecap="round"></path>
            <rect x="25.5" y="7" width="10" height="9" rx="4.5" fill="#fff" opacity=".55"></rect>
            <path d="M24 60 Q14 56 10 63 Q8 69 16 73 L30 80 Q38 82 38 74 Q38 68 32 64 Z" fill="#f7c29b"></path>
            <rect x="18" y="86" width="52" height="16" rx="6" fill="url(#fg-cuff)"></rect>
            <rect x="18" y="86" width="52" height="4" rx="2" fill="#fff" opacity=".45"></rect>
          </g>
        </svg>
      </div>

      {/* Big screen: the real game's host view, built in HTML/CSS */}
      <figure class="bigscreen" role="img" aria-label={c.bigScreenLabel}>
        <div class="bs-stage stage-bg" aria-hidden="true">
          <div class="bs-floor"></div>
          <img class="g-logo bs-logo" src="/brand/tadam-logo-v2.webp" alt="" width="1472" height="814" />
          <img class="bs-host" src="/scene5/host.webp" alt="" width="360" height="710" loading="lazy" decoding="async" />

          <div class="bs-main">
            <p class="g-label bs-label">{c.questionLabel}</p>
            <p class="g-q bs-q">{c.question}</p>
            <ul class="pills bs-pills" role="list">
              {
                c.answers.map((a, i) => (
                  <li class:list={["pill", { "is-correct": i === c.correctIndex }]} style={`--p:${bar(a.votes)}`} data-i={i}>
                    <span class="pill-bar" />
                    <span class="pill-text">{a.text}</span>
                    <span class="pill-n">{a.votes}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="ring bs-ring" style={`--ring:1`}>
            <svg viewBox="0 0 100 100"><circle class="ring-track" cx="50" cy="50" r="44"></circle><circle class="ring-arc" cx="50" cy="50" r="44" pathLength="100"></circle></svg>
            <b class="ring-n">{c.ringSeconds}</b>
          </div>

          <div class="bs-join">
            <span class="bs-count"><b class="bs-count-n">{c.connectedCount}</b> {c.connected}</span>
            <div class="bs-qr">
              {qr.map((on) => <i class:list={{ on }} />)}
            </div>
          </div>
        </div>
      </figure>
    </div>

    <div class="s5-copy container">
      <SplitHeading as="h2" id="s5-title" class="h-scene s5-title" text={c.headline} highlight="ביחד" />
    </div>
  </div>
</section>

<style>
  .s5 {
    /* Result colors of the real game (sampled from the recording). Not in tokens.css yet. */
    --result-green: #4cc09d;
    --result-pink: #ee688a;
    --game-yellow: #ffe100;
    --pill-text: #14102b;
  }
  .s5-pin {
    grid-template-rows: 1fr auto;
    align-items: center;
    padding-block: clamp(56px, 8vh, 90px) clamp(28px, 6vh, 64px);
    background: radial-gradient(70% 60% at 50% 40%, var(--bg-1), var(--bg-0));
  }
  .s5-crowd {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }
  .s5-split,
  .s5-copy {
    position: relative;
    z-index: 1;
  }
  .s5-split {
    --max-w: 1360px;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: clamp(20px, 3vw, 44px);
    transform-origin: 50% 50%;
  }
  .s5-copy {
    text-align: center;
  }
  /* When animated, the screen fades out before the headline comes in, so both share one cell. */
  .s5-pin.is-animated {
    grid-template-rows: 1fr;
  }
  .s5-pin.is-animated > .s5-split,
  .s5-pin.is-animated > .s5-copy {
    grid-area: 1 / 1;
  }
  :global(.s5-title) {
    max-width: 18ch;
    margin-inline: auto;
    text-shadow: 0 4px 0 var(--purple-ink), 0 0 30px rgba(0, 0, 0, 0.6);
  }

  /* ---------- shared game look ---------- */
  .stage-bg {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(60% 38% at 50% 100%, var(--spot), transparent 72%),
      repeating-linear-gradient(90deg, transparent 0 7%, rgba(120, 170, 255, 0.2) 10%, transparent 13%) top / 100% 78% no-repeat,
      linear-gradient(180deg, var(--bg-0) 0%, var(--bg-2) 45%, var(--bg-1) 78%, var(--bg-0) 100%);
  }
  .g-logo {
    display: block;
    object-fit: contain;
  }
  .g-label {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--white);
  }
  .g-q {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--game-yellow);
    line-height: 1.22;
    text-wrap: balance;
  }
  .pills {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .pill {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6em;
    overflow: hidden;
    border-radius: 999px;
    background: var(--white);
    color: var(--pill-text);
    font-family: var(--font-display);
    font-weight: 700;
    box-shadow: 0 2px 8px rgba(0, 0, 8, 0.28);
    transition: background-color 0.25s;
  }
  .pill-bar {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: calc(var(--p, 0) * 100%);
    background: rgba(20, 16, 43, 0.12);
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 0.7s var(--ease-out);
  }
  .pill-text,
  .pill-n {
    position: relative;
  }
  .pill-n {
    color: #6b6b78;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    opacity: 0;
    transition: opacity 0.4s 0.2s;
  }
  /* the reveal: bars grow, counts appear, the right answer is green */
  .is-revealed .pill-bar {
    transform: scaleX(1);
  }
  .is-revealed .pill-n {
    opacity: 1;
  }
  .is-revealed .pill.is-correct .pill-bar {
    background: var(--result-green);
  }
  .is-revealed .pill.is-wrong .pill-bar {
    background: var(--result-pink);
  }
  .is-revealed .pill.is-correct .pill-n,
  .is-revealed .pill.is-wrong .pill-n {
    color: var(--pill-text);
  }

  .ring {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    transition: opacity 0.3s;
  }
  .ring svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg) scaleY(-1);
  }
  .ring circle {
    fill: rgba(5, 14, 80, 0.35);
    stroke-width: 5;
  }
  .ring-track {
    stroke: rgba(255, 255, 255, 0.28);
  }
  .ring-arc {
    stroke: var(--game-yellow);
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: calc((1 - var(--ring, 1)) * 100);
    fill: none !important;
  }
  .ring-n {
    position: relative;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--white);
    font-variant-numeric: tabular-nums;
  }
  .is-revealed .ring {
    opacity: 0;
  }

  /* ---------- big screen (sized in cqw so it scales like a TV) ---------- */
  .bigscreen {
    margin: 0;
    container: s5screen / inline-size;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--surface-border);
    box-shadow:
      0 0 0 6px rgba(5, 14, 80, 0.6),
      0 0 70px 6px var(--screen-glow);
  }
  .bs-stage {
    aspect-ratio: 16 / 9;
    width: 100%;
  }
  .bs-floor {
    position: absolute;
    inset: auto 0 0 0;
    height: 19%;
    background: linear-gradient(180deg, rgba(10, 26, 107, 0.9), var(--hall-floor));
  }
  /* the glowing strip */
  .bs-floor::before {
    content: "";
    position: absolute;
    inset: -0.3cqw -3cqw auto;
    height: 0.6cqw;
    border-radius: 50%;
    background: linear-gradient(90deg, transparent, var(--white) 14%, var(--white) 86%, transparent);
    box-shadow: 0 0 1.8cqw 0.5cqw var(--floor-glow);
  }
  .bs-floor::after {
    content: "";
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(90deg, transparent 0 7%, rgba(255, 255, 255, 0.2) 8%, transparent 9.5%);
    mask-image: linear-gradient(180deg, #000, transparent 85%);
  }
  .bs-logo {
    position: absolute;
    left: 3.5cqw;
    top: 2.4cqw;
    width: 10cqw;
  }
  .bs-host {
    position: absolute;
    left: 15%;
    bottom: 0;
    height: 84%;
    width: auto;
    /* feather the photo's own backdrop into the stage; keep the feet solid */
    mask-image: linear-gradient(90deg, transparent, #000 28%, #000 72%, transparent), linear-gradient(180deg, transparent, #000 12%);
    mask-composite: intersect;
    -webkit-mask-composite: source-in;
  }
  .bs-main {
    position: absolute;
    right: 5cqw;
    top: 7.5cqw;
    width: 47cqw;
    display: flex;
    flex-direction: column;
    gap: 1.2cqw;
  }
  .bs-label {
    font-size: 2.1cqw;
  }
  .bs-q {
    font-size: 3.7cqw;
    max-width: 44cqw;
  }
  .bs-pills {
    gap: 1.1cqw;
    width: 31cqw;
    margin-top: 3.2cqw;
  }
  .bs-pills .pill {
    min-height: 4.3cqw;
    padding: 0 1.8cqw;
    font-size: 1.9cqw;
  }
  .bs-ring {
    position: absolute;
    left: 5.6cqw;
    top: 15.5cqw;
    width: 7cqw;
  }
  .bs-ring .ring-n {
    font-size: 2.8cqw;
  }
  .bs-join {
    position: absolute;
    left: 3.5cqw;
    bottom: 5.5cqw;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9cqw;
  }
  .bs-count {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 2.2cqw;
    color: var(--white);
  }
  .bs-count b {
    font-variant-numeric: tabular-nums;
  }
  .bs-qr {
    display: grid;
    grid-template-columns: repeat(21, 1fr);
    width: 8.4cqw;
    aspect-ratio: 1;
    padding: 0.7cqw;
    background: var(--white);
    border-radius: 0.8cqw;
  }
  .bs-qr i.on {
    background: #0b0b14;
  }

  /* compact card (mobile): same elements, re-flowed so it stays legible at 390px */
  @container s5screen (max-width: 640px) {
    .bs-stage {
      aspect-ratio: auto;
      min-height: 0;
      display: grid;
      grid-template-columns: auto 1fr;
      grid-template-areas:
        "logo label"
        "q q"
        "pills pills"
        "join ring";
      gap: 10px 12px;
      padding: 14px 16px 18px;
      align-items: center;
    }
    .bs-floor {
      display: none;
    }
    .bs-host {
      display: none;
    }
    .bs-logo {
      grid-area: logo;
      position: static;
      width: 72px;
    }
    .bs-main {
      display: contents;
    }
    .bs-label {
      grid-area: label;
      justify-self: end;
      font-size: 1.05rem;
    }
    .bs-q {
      grid-area: q;
      font-size: 1.45rem;
      max-width: none;
      margin-top: 2px;
    }
    .bs-pills {
      grid-area: pills;
      width: 100%;
      gap: 8px;
      margin-top: 0;
    }
    .bs-pills .pill {
      min-height: 40px;
      padding: 0 16px;
      font-size: 1.05rem;
    }
    .bs-ring {
      grid-area: ring;
      position: static;
      justify-self: end;
      width: 46px;
    }
    .bs-ring .ring-n {
      font-size: 1.15rem;
    }
    .bs-join {
      grid-area: join;
      position: static;
      flex-direction: row-reverse;
      justify-content: flex-end;
      gap: 10px;
    }
    .bs-count {
      font-size: 1rem;
    }
    .bs-qr {
      width: 48px;
      padding: 4px;
      border-radius: 6px;
    }
  }

  /* ---------- phone ---------- */
  .phone {
    position: relative;
    width: clamp(230px, 19vw, 290px);
    aspect-ratio: 9 / 18.2;
    padding: 9px;
    border-radius: 38px;
    background: #050816;
    border: 2px solid rgba(255, 255, 255, 0.18);
    box-shadow:
      0 24px 60px rgba(0, 0, 0, 0.5),
      0 0 40px rgba(100, 216, 247, 0.18);
  }
  .phone-notch {
    position: absolute;
    z-index: 3;
    top: 16px;
    left: 50%;
    width: 30%;
    height: 18px;
    transform: translateX(-50%);
    border-radius: 999px;
    background: #050816;
  }
  .phone-screen {
    height: 100%;
    border-radius: 30px;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    padding: 34px 14px 16px;
    gap: 10px;
    text-align: center;
  }
  .phone-screen .g-logo {
    width: 38%;
    align-self: center;
    margin-bottom: -4px;
  }
  .phone-screen .g-label {
    font-size: 1.4rem;
    margin-top: 2px;
  }
  .phone-qwrap {
    display: grid;
    margin-block: 4px 8px;
    min-height: 3.7em;
    align-items: start;
  }
  .phone-q {
    grid-area: 1 / 1;
    font-size: 1.3rem;
    padding-inline: 4px;
    transition: opacity 0.35s;
  }
  .q-next {
    opacity: 0;
  }
  .phone.is-revealed .q-ask {
    opacity: 0;
  }
  .phone.is-revealed .q-next {
    opacity: 1;
  }
  .phone-screen .pills {
    gap: 9px;
  }
  .phone-screen .pill {
    min-height: 44px;
    padding: 0 18px;
    font-size: 1.1rem;
  }
  /* the answer you tapped turns yellow until the result comes in */
  .phone.is-picked:not(.is-revealed) .pill.is-picked {
    background: var(--game-yellow);
  }
  .phone-ring {
    width: 52px;
    margin: auto auto 0;
  }
  .phone-ring .ring-n {
    font-size: 1.3rem;
  }
  .finger {
    position: absolute;
    z-index: 4;
    width: 64px;
    top: 50%;
    left: 34%;
    opacity: 0;
    overflow: visible;
    pointer-events: none;
    transform-origin: 38% 10%;
    filter: drop-shadow(0 8px 10px rgba(0, 10, 60, 0.45));
  }
  /* white ring that pops where the fingertip lands */
  .tap-ring {
    position: absolute;
    z-index: 3;
    width: 46px;
    height: 46px;
    margin: -23px 0 0 -23px;
    border: 3px solid #fff;
    border-radius: 50%;
    box-shadow:
      0 0 14px rgba(255, 255, 255, 0.8),
      inset 0 0 10px rgba(255, 255, 255, 0.6);
    opacity: 0;
    pointer-events: none;
  }

  /* ---------- mobile: phone first and large, the big screen is a compact card ---------- */
  @media (max-width: 767px) {
    .s5-split {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      gap: 24px;
    }
    .phone {
      width: min(86vw, 330px);
      aspect-ratio: 9 / 17;
    }
    .bigscreen {
      width: 100%;
      max-width: 420px;
    }
    /* animated: the phone plays first, then the card takes its place (script drives the crossfade) */
    .s5-pin.is-animated .phone,
    .s5-pin.is-animated .bigscreen {
      grid-area: 1 / 1;
    }
  }
  @media (max-width: 380px) {
    .phone-screen .g-label {
      font-size: 1.25rem;
    }
    .phone-q {
      font-size: 1.15rem;
    }
  }
</style>
