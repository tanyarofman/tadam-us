---
import { useCopy } from "../../content/copy";
import SplitHeading from "../SplitHeading.astro";
const { copy: COPY } = useCopy(Astro.url);
const c = COPY.scene6;
const lights = COPY.scene5;
const avatarColors = ["var(--sun-yellow)", "var(--sky-cyan)", "var(--magenta)", "var(--buzzer-red)", "#8a62d0"];
---

<!-- Scenes 5 + 6 in one: everyone answers together, the scores change on the big screen, the winner. -->
<section class="scene s6" id="scene-6" data-scene="6" aria-labelledby="s6-title">
  <div class="scene-pin s6-pin">
    <div class="s6-shade" aria-hidden="true"></div>
    <canvas class="confetti" aria-hidden="true"></canvas>

    <div class="container s6-inner">
      <div class="s6-heads">
        <SplitHeading as="h2" id="s6-title" class="h-scene s6-title s6-title-a" text={lights.headline} highlight={lights.highlight} />
        <SplitHeading as="p" class="h-scene s6-title s6-title-b" text={c.headline} />
      </div>

      <div class="board-panel">
        <div class="board-head">
          <span class="display">{c.leaderboardTitle}</span>
          <span class="drumroll" aria-hidden="true">{c.drumroll}</span>
        </div>
        <ol class="lb" role="list" style={`--rows:${c.players.length}`}>
          {
            c.players.map((p, i) => (
              <li class:list={["lb-row", { "is-winner": "winner" in p && p.winner }]} data-i={i}>
                <span class="lb-rank">{i + 1}</span>
                <span class="lb-avatar" style={`--c:${avatarColors[i]}`} aria-hidden="true">
                  {p.name.charAt(0)}
                </span>
                <span class="lb-name">{p.name}</span>
                <span class="lb-score">{p.score.toLocaleString("he-IL")}</span>
                {"winner" in p && p.winner && <svg class="lb-crown" viewBox="0 0 40 30" aria-hidden="true"><path d="M4 26 L2 6 L12 14 L20 2 L28 14 L38 6 L36 26 Z" fill="#F7D94A" stroke="#330768" stroke-width="3.5" stroke-linejoin="round" /></svg>}
              </li>
            ))
          }
        </ol>
      </div>

    </div>
  </div>
</section>

<style>
  .s6-pin {
    align-items: start;
    padding-block: var(--story-heading-top) 32px;
  }
  .s6-shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  /* static shading keeps the board and headline clear against the site background */
  .s6-shade {
    background:
      radial-gradient(60% 50% at 50% 55%, rgba(2, 11, 46, 0.45), rgba(2, 11, 46, 0.85) 100%),
      linear-gradient(to bottom, rgba(2, 11, 46, 0.6), transparent 30%, transparent 70%, rgba(2, 11, 46, 0.8));
  }
  .confetti {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 5;
  }
  .s6-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--story-heading-gap);
  }
  /* the two headlines share one spot: "everyone answers together" first, then the payoff */
  .s6-heads {
    display: grid;
    text-align: center;
  }
  .s6-heads > :global(*) {
    grid-area: 1 / 1;
    align-self: center;
  }
  :global(.s6-title) {
    margin: 0;
    font-size: var(--fs-story-title);
    max-width: 24ch;
    margin-inline: auto;
    text-shadow: 0 4px 0 var(--purple-ink);
  }

  /* the leaderboard is the big screen of the event */
  .board-panel {
    position: relative;
    width: min(800px, 100%);
    padding: clamp(18px, 3vw, 36px) clamp(16px, 3.4vw, 44px);
    border-radius: var(--radius-l);
    background: rgba(9, 26, 110, 0.82);
    border: 6px solid var(--purple-ink);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.08),
      0 0 60px 4px var(--screen-glow);
  }
  .board-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    margin-bottom: clamp(12px, 2vh, 20px);
    font-size: clamp(1.2rem, 2.2vw, 1.6rem);
  }
  .drumroll {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    color: var(--sun-yellow);
    opacity: 0;
  }
  .lb {
    --row: clamp(48px, 7vh, 64px);
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
    display: grid;
    gap: clamp(8px, 1.2vh, 12px);
  }
  .lb-row {
    position: relative;
    display: grid;
    grid-template-columns: 28px 42px 1fr auto;
    align-items: center;
    gap: 14px;
    height: var(--row);
    padding: 0 18px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.07);
    border: 2px solid transparent;
    font-weight: 500;
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    transition:
      background 0.4s,
      border-color 0.4s,
      box-shadow 0.4s;
  }
  .lb-rank {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--text-muted);
  }
  .lb-avatar {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--c);
    color: var(--purple-ink);
    border: 3px solid var(--purple-ink);
    font-family: var(--font-display);
    font-weight: 700;
  }
  .lb-name {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .lb-score {
    font-variant-numeric: tabular-nums;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15em;
    color: var(--sky-cyan);
  }
  .lb-row.is-winner {
    background: linear-gradient(90deg, rgba(247, 217, 74, 0.12), rgba(247, 217, 74, 0.3));
    border-color: var(--sun-yellow);
    box-shadow: 0 0 24px rgba(247, 217, 74, 0.3);
  }
  .lb-row.is-winner .lb-score {
    color: var(--sun-yellow);
  }
  .lb-crown {
    position: absolute;
    top: -18px;
    inset-inline-start: 4px;
    width: 34px;
    transform: rotate(18deg);
  }
  @media (max-width: 767px) {
    .board-panel {
      border-width: 4px;
    }
    .lb {
      --row: 46px;
      gap: 6px;
    }
    .lb-row {
      grid-template-columns: 20px 32px 1fr auto;
      gap: 10px;
      font-size: 0.95rem;
      padding: 0 12px;
    }
    .lb-avatar {
      width: 32px;
      height: 32px;
    }
  }
  @media (max-width: 767px) and (max-height: 700px) {
    .s6-inner { gap: 24px; }
    .board-panel { padding: 12px; }
    .board-head { margin-bottom: 10px; }
    .lb { --row: 42px; }
  }
  @media (max-width: 767px) and (orientation: portrait) {
    .s6-pin { padding-block: clamp(84px, 15svh, 132px) 28px; }
    .s6-inner { gap: clamp(42px, 7svh, 60px); }
  }
  @media (orientation: landscape) and (max-height: 500px) {
    .s6-pin { padding-block: 16px; }
    .s6-inner { flex-direction: row; gap: 24px; }
    .s6-heads { flex: 1; min-width: 0; }
    :global(.s6-title) { font-size: 2.2rem; }
    .board-panel { width: 58%; padding: 10px 12px; border-width: 4px; }
    .board-head { margin-bottom: 10px; font-size: 1.1rem; }
    .lb { --row: 36px; gap: 4px; }
    .lb-row { grid-template-columns: 20px 28px 1fr auto; gap: 8px; font-size: .9rem; padding-inline: 8px; }
    .lb-avatar { width: 28px; height: 28px; }
  }
</style>
