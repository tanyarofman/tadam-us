---
import { useCopy } from "../../content/copy";
import { contactLink, demoUrl } from "../../config/site";
import SplitHeading from "../SplitHeading.astro";
import Buzzer from "../Buzzer.astro";
const { copy: COPY, locale } = useCopy(Astro.url);
const c = COPY.scene7;
---

<section class="scene s7" id="scene-7" data-scene="7" aria-labelledby="s7-title">
  <div class="s7-pin" data-scroll-pause>
  <div class="s7-inner container">
    <a class="big-buzzer" href={demoUrl(locale)} target="_blank" rel="noopener" data-track="demo_open_big_screen" data-source="cta-buzzer" aria-label={c.buzzerLabel}>
      <Buzzer id="cta-buzzer" rays />
    </a>
    <SplitHeading as="h2" id="s7-title" class="h-scene s7-title" text={c.headline} highlight={c.highlight} />
    <div class="s7-actions">
    <a class="btn btn-buzzer s7-btn" href={contactLink("cta")} target="_blank" rel="noopener" data-track="cta_contact_click" data-source="cta">
      <span class="btn-dot" aria-hidden="true"></span>
      {c.contact}
    </a>
    <a class="btn btn-white s7-demo" href={demoUrl(locale)} target="_blank" rel="noopener" data-track="demo_open_big_screen" data-source="cta">
      {c.cta}
    </a>
    </div>
  </div>
  </div>
</section>

<style>
  .s7-pin {
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    place-items: start center;
    padding-block: clamp(80px, 13vh, 128px) clamp(40px, 6vh, 64px);
    overflow: hidden;
  }
  .s7-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(18px, 3vh, 30px);
  }
  .big-buzzer {
    width: min(300px, 62vw);
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    border-radius: 40%;
    -webkit-tap-highlight-color: transparent;
    filter: drop-shadow(0 20px 40px rgba(231, 65, 56, 0.35));
  }
  .big-buzzer :global(.buzzer-cap) {
    transition: transform 0.12s var(--ease-out);
  }
  .big-buzzer:hover :global(.buzzer-cap) {
    transform: translateY(2px) scaleY(0.96);
  }
  .big-buzzer:active :global(.buzzer-cap),
  .big-buzzer.is-pressed :global(.buzzer-cap) {
    transform: translateY(6px) scaleY(0.75);
  }
  :global(.s7-title) {
    max-width: 14ch;
    text-shadow: 0 4px 0 var(--purple-ink);
  }
  .s7-actions {
    margin-top: clamp(20px, 3vh, 32px);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    width: min(440px, 100%);
    gap: clamp(12px, 2vw, 20px);
  }
  /* English button labels are longer */
  :global([dir="ltr"]) .s7-actions { width: min(540px, 100%); }
  .s7-actions .btn {
    padding-inline: clamp(14px, 3vw, 28px);
  }
  @media (max-width: 767px) {
    .s7-actions { grid-template-columns: minmax(0, 1fr); width: min(320px, 100%); gap: 16px; }
  }
</style>
