---
import "../styles/global.css";
import { useCopy, otherLanguagePath, LOCALES } from "../content/copy";
const { copy: COPY, lang, dir, ogLocale } = useCopy(Astro.url);

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** "article" on blog posts. */
  ogType?: "website" | "article";
  /** True on pages that exist in both languages (home, privacy): adds hreflang links. */
  bilingual?: boolean;
}
const { title = COPY.meta.title, description = COPY.meta.description, noindex = false, ogType = "website", bilingual = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/brand/og-image-v3.jpg", Astro.site);
// hreflang: this page and its twin in the other language; Hebrew is the default for everyone else.
const twin = new URL(otherLanguagePath(Astro.url), Astro.site);
const alternates = bilingual
  ? lang === "he"
    ? [{ hreflang: LOCALES.he.hreflang, href: canonical }, { hreflang: LOCALES.en.hreflang, href: twin }, { hreflang: "x-default", href: canonical }]
    : [{ hreflang: LOCALES.he.hreflang, href: twin }, { hreflang: LOCALES.en.hreflang, href: canonical }, { hreflang: "x-default", href: twin }]
  : [];
---

<!doctype html>
<html lang={lang} dir={dir} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0A1A6B" />
    {/* Keep the square raster fallbacks and app icons; use the yellow ! SVG for browser tabs. */}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={COPY.brand} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1000" />
    <meta property="og:image:height" content="525" />
    <meta property="og:image:alt" content={COPY.meta.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {lang === "en" ? <>
      <link rel="preload" as="font" type="font/woff2" href="/fonts/OverusedGrotesk-VF.woff2" crossorigin />
      <link rel="preload" as="font" type="font/woff2" href="/fonts/InterVariable.woff2" crossorigin />
    </> : <>
      <link rel="preload" as="font" type="font/otf" href="/fonts/almoni-tzar-regular-aaa.otf" crossorigin />
      <link rel="preload" as="font" type="font/otf" href="/fonts/almoni-tzar-bold-aaa.otf" crossorigin />
    </>}
    <link rel="preload" as="image" type="image/webp" href={lang === "en" ? "/brand/tadam-logo-en.webp" : "/brand/tadam-logo-v4.webp"} fetchpriority="high" />
    <slot name="head" />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.remove("no-js");
        d.classList.add("js");
        if (d.lang === "en" && document.fonts) {
          d.classList.add("fonts-loading");
          var settled = false;
          function reveal(ok) {
            if (settled) return;
            settled = true;
            if (!ok) d.classList.add("fonts-failed");
            d.classList.remove("fonts-loading");
          }
          function loadFonts() {
          Promise.all([document.fonts.load('700 16px "Overused Grotesk"'), document.fonts.load('400 16px Inter')])
            .then(function (fonts) { reveal(fonts.every(function (f) { return f.length > 0; })); }, function () { reveal(false); });
          setTimeout(function () { reveal(false); }, 6000);
          }
          if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", loadFonts, { once: true });
          else loadFonts();
        }
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
