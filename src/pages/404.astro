---
/**
 * The site's own 404 page. Without it, `astro preview` shows Astro's built-in fallback (a <pre> with the full
 * path that overflows phones) and Netlify shows its generic page. Netlify serves dist/404.html for unknown URLs.
 */
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import { useCopy } from "../content/copy";
const { copy: COPY, home } = useCopy(Astro.url);
---

<Base title={`Page Not Found | ${COPY.brand}`} description="This page doesn't exist. Head back to the Tadam! home page or read the blog." noindex>
  <main class="container not-found">
    <a href={home} class="not-found-logo"><img src="/brand/tadam-logo-en.webp" alt={COPY.brand} width="1000" height="394" /></a>
    <h1 class="display not-found-title">Oops, wrong answer!</h1>
    <p>We couldn't find this page. It may have moved, or the link may have a typo.</p>
    <div class="not-found-actions">
      <a class="btn btn-buzzer" href={home}>Back to the home page</a>
      <a class="not-found-link" href="/blog/">Read the blog</a>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .not-found {
    max-width: 780px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
    min-height: 70vh;
    padding-block: 56px 72px;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }
  .not-found p {
    margin: 0;
  }
  .not-found-logo img {
    width: 150px;
    max-width: 100%;
    height: auto;
  }
  .not-found-title {
    margin: 8px 0 0;
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    color: var(--game-yellow);
    text-shadow: 0 4px 0 var(--purple-ink);
  }
  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    margin-top: 12px;
  }
  .not-found-link {
    color: var(--white);
    text-decoration-color: var(--game-yellow);
    text-underline-offset: 4px;
  }
</style>
