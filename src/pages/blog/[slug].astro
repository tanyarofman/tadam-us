---
import { getCollection } from "astro:content";
import BlogArticle from "../../components/pages/BlogArticle.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", (p) => !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, all: posts } }));
}
---

<BlogArticle {...Astro.props} />
