---
/**
 * /create: the game creator (wizard + Paddle checkout). COMING SOON page until the English wizard is built here:
 * every "Create yours" button links here. Visitors leave their email (Netlify Forms, form name "launch-list")
 * and hear from us when the creator opens. Replace this page with the wizard. noindex.
 */
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { useCopy } from "../content/copy";
import { SITE, demoUrl } from "../config/site";
const { copy: COPY, home, locale } = useCopy(Astro.url);
---

<Base title={`Coming Soon | ${COPY.brand}`} description="The Tadam! game creator opens soon. Leave your email and be the first to know." noindex>
  <SiteHeader />
  <main class="container soon">
    <span class="soon-badge">Coming soon</span>
    <h1 class="display soon-title">Your game show is almost ready.</h1>
    <p class="soon-lead">
      We're putting the finishing touches on the game creator. Leave your email and you'll be the first to know when it opens.
    </p>

    <form
      class="soon-form"
      name="launch-list"
      method="POST"
      action="/create/?joined=1"
      data-netlify="true"
      netlify-honeypot="company"
      data-track="launch_list_submit"
    >
      <input type="hidden" name="form-name" value="launch-list" />
      <p class="soon-hp" aria-hidden="true"><label>Company <input name="company" tabindex="-1" autocomplete="off" /></label></p>
      <label class="sr-only" for="soon-email">Your email</label>
      <div class="soon-field">
        <input id="soon-email" type="email" name="email" required placeholder="you@example.com" autocomplete="email" inputmode="email" />
        <button class="btn btn-buzzer soon-submit" type="submit">Let me know</button>
      </div>
      <p class="soon-note">One email when it opens. No spam, ever.</p>
      <p class="soon-error" role="alert" hidden>Something went wrong. Try again, or write to us at <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
    </form>

    <div class="soon-done" role="status" hidden>
      <p class="soon-done-title display">Tadam! You're on the list.</p>
      <p>We'll email you the moment the game creator opens. Until then, play the demo and see what your guests will get.</p>
    </div>

    <div class="soon-actions">
      <a class="soon-link" href={`${demoUrl(locale)}?autostart=1`} target="_blank" rel="noopener" data-track="demo_open_big_screen" data-source="create-soon">Play the demo meanwhile</a>
      <a class="soon-link" href={home}>Back to the home page</a>
    </div>
  </main>
  <Footer hideBrand />
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>(".soon-form");
  const done = document.querySelector<HTMLElement>(".soon-done");
  const error = form?.querySelector<HTMLElement>(".soon-error");
  const showDone = () => {
    if (form) form.hidden = true;
    if (done) done.hidden = false;
  };
  if (new URLSearchParams(location.search).has("joined")) showDone();
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (error) error.hidden = true;
    const button = form.querySelector("button");
    if (button) button.disabled = true;
    try {
      const body = new URLSearchParams(new FormData(form) as unknown as Record<string, string>).toString();
      const res = await fetch("/", { method: "POST", headers: { "Content-Type": "application/x-www-form-urlencoded" }, body });
      // Netlify Forms only exists on Netlify; on the local dev server the POST fails, so the mock shows success anyway.
      if (!res.ok && !["localhost", "127.0.0.1"].includes(location.hostname)) throw new Error(String(res.status));
      showDone();
    } catch {
      if (error) error.hidden = false;
      if (button) button.disabled = false;
    }
  });
</script>

<style>
  .soon {
    max-width: 720px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
    min-height: 72vh;
    padding-block: 32px 80px;
    line-height: 1.7;
  }
  .soon p { margin: 0; }
  .soon-badge {
    padding: 4px 16px 6px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.25);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.85rem;
  }
  .soon-title {
    margin: 0;
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    line-height: 1.15;
    color: var(--game-yellow);
    text-shadow: 0 4px 0 var(--purple-ink);
    text-wrap: balance;
  }
  .soon-lead { max-width: 560px; font-size: 1.15rem; }

  .soon-form { width: 100%; max-width: 560px; display: flex; flex-direction: column; gap: 10px; margin-top: 8px; }
  .soon-field {
    display: flex;
    gap: 8px;
    padding: 6px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.25);
    transition: border-color 0.2s, background 0.2s;
  }
  .soon-field:focus-within { border-color: var(--game-yellow); background: rgba(255, 255, 255, 0.14); }
  .soon-field input {
    flex: 1;
    min-width: 0;
    padding: 0 18px;
    border: 0;
    background: transparent;
    color: var(--white);
    font: inherit;
    font-size: 1.1rem;
    outline: none;
  }
  .soon-field input::placeholder { color: rgba(255, 255, 255, 0.55); }
  .soon-submit { min-height: 52px; padding-inline: 28px; white-space: nowrap; }
  .soon-submit:disabled { opacity: 0.7; cursor: wait; }
  .soon-note { font-size: 0.9rem; opacity: 0.75; }
  .soon-error { color: var(--game-yellow); }
  .soon-error a { color: inherit; }
  .soon-hp { position: absolute; left: -9999px; }
  .soon [hidden] { display: none !important; }

  .soon-done {
    width: 100%;
    max-width: 560px;
    padding: 28px 24px;
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid var(--game-yellow);
    animation: soon-pop 0.4s var(--ease-out, ease-out);
  }
  .soon-done-title { font-size: 1.8rem; color: var(--game-yellow); margin-bottom: 8px !important; }
  @keyframes soon-pop { from { transform: scale(0.94); opacity: 0; } to { transform: none; opacity: 1; } }

  .soon-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px 28px; margin-top: 16px; }
  .soon-link { color: var(--white); text-decoration-color: var(--game-yellow); text-underline-offset: 4px; }

  @media (max-width: 520px) {
    .soon-field { flex-direction: column; border-radius: 24px; padding: 8px; }
    .soon-field input { min-height: 48px; text-align: center; }
    .soon-submit { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) { .soon-done { animation: none; } }
</style>
