---
import { getCollection } from "astro:content";
import BlogArticle from "../../../components/pages/BlogArticle.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blogEn", (p) => !p.data.draft);
  const twins = new Set((await getCollection("blog", (p) => !p.data.draft)).map((p) => p.id));
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, all: posts, hasTwin: twins.has(post.id) } }));
}
---

<BlogArticle {...Astro.props} />
