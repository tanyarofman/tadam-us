---
import Base from "../layouts/Base.astro";
import Scene0Hero from "../components/scenes/Scene0Hero.astro";
import EventsStrip from "../components/EventsStrip.astro";
import Scene1Event from "../components/scenes/Scene1Event.astro";
import Scene2Insight from "../components/scenes/Scene2Insight.astro";
import Scene3Reveal from "../components/scenes/Scene3Reveal.astro";
import Scene4HowItWorks from "../components/scenes/Scene4HowItWorks.astro";
import Scene6Payoff from "../components/scenes/Scene6Payoff.astro";
import Pricing from "../components/Pricing.astro";
import Scene7Cta from "../components/scenes/Scene7Cta.astro";
import Faq from "../components/Faq.astro";
import LeadForm from "../components/LeadForm.astro";
import Footer from "../components/Footer.astro";
import DemoModal from "../components/DemoModal.astro";
import Preloader from "../components/Preloader.astro";
import { COPY } from "../content/copy.he";
import { SITE } from "../config/site";

const home = new URL("/", Astro.site).href;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${home}#org`,
    name: "טדאם!",
    url: home,
    logo: new URL("/favicon-512.png", Astro.site).href,
    email: SITE.email,
    sameAs: [SITE.facebookUrl],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "טדאם!",
    alternateName: ["Tadam", "heytadam"],
    url: home,
    inLanguage: "he-IL",
    publisher: { "@id": `${home}#org` },
  },
];
---

<Base>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <link slot="head" rel="preload" as="image" type="image/webp" href="/demo/tadam-hero-loop-poster.webp" />
  <Preloader />
  <a class="skip-link" href="#scene-1">{COPY.nav.skip}</a>
  <div class="scroll-progress" aria-hidden="true"><div class="scroll-progress__bar"></div></div>

  <main id="main">
    <Scene0Hero />
    <EventsStrip />
    <Scene1Event />
    <Scene2Insight />
    <Scene3Reveal />
    <Scene4HowItWorks />
    <Scene6Payoff />
    <Pricing />
    <Scene7Cta />
    <LeadForm />
    <Faq />
  </main>
  <Footer />
  <DemoModal />


  <script>
    import "../scripts/main";
  </script>
</Base>
