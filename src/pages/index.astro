---
import Base from "../layouts/Base.astro";
import Scene0Hero from "../components/scenes/Scene0Hero.astro";
import EventsStrip from "../components/EventsStrip.astro";
import Scene3Reveal from "../components/scenes/Scene3Reveal.astro";
import Scene4HowItWorks from "../components/scenes/Scene4HowItWorks.astro";
import Scene6Payoff from "../components/scenes/Scene6Payoff.astro";
import Pricing from "../components/Pricing.astro";
import Hosts from "../components/Hosts.astro";
import Scene7Cta from "../components/scenes/Scene7Cta.astro";
import Faq from "../components/Faq.astro";
import LeadForm from "../components/LeadForm.astro";
import Footer from "../components/Footer.astro";
import ClosingCta from "../components/ClosingCta.astro";
import DemoModal from "../components/DemoModal.astro";
import Preloader from "../components/Preloader.astro";
import { COPY } from "../content/copy.he";
---

<Base>
  <link slot="head" rel="preload" as="image" type="image/jpeg" href="/demo/hero-screen-poster.jpg" />
  <link slot="head" rel="preload" as="image" type="image/jpeg" href="/demo/hero-phone-poster.jpg" />
  <Preloader />
  <a class="skip-link" href="#scene-3">{COPY.nav.skip}</a>
  <div class="scroll-progress" aria-hidden="true"><div class="scroll-progress__bar"></div></div>

  <main id="main">
    <Scene0Hero />
    <EventsStrip />
    <Scene3Reveal />
    <Scene4HowItWorks />
    <Scene6Payoff />
    <Hosts />
    <Pricing />
    <Scene7Cta />
    <LeadForm />
    <Faq />
    <ClosingCta />
  </main>
  <Footer />
  <DemoModal />


  <script>
    import "../scripts/main";
  </script>
</Base>
